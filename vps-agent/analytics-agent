    ("reverse_shell", re.compile(rb"bash\s+-i\s*>&\s*/dev/tcp/|/dev/tcp/[0-9.]+/[0-9]+|\bnc(at)?\s+(-\S+\s+)*-e\s+/bin/(ba)?sh|socket\.socket\(.{0,200}subprocess|pty\.spawn\(\s*[\x22\x27]/bin/(ba)?sh", re.I)),
    ("webshell", re.compile(rb"FilesMan|c99shell|r57shell|WSO\s?[0-9]|b374k", re.I)),
    ("obfuscated_js", re.compile(rb"String\.fromCharCode\(\s*[0-9]+\s*(,\s*[0-9]+\s*){50,}\)|document\.write\(\s*unescape\(", re.I)),
    ("defaced", re.compile(rb"hacked\s+by|defaced\s+by", re.I)),
]


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).isoformat().replace("+00:00", "Z")


def watched_file(name):
    if name in FILE_NAMES or name.startswith(".env"):
        return True
    return "." in name and name.rsplit(".", 1)[-1].lower() in FILE_EXTENSIONS


def open_regular(path, expect=None):
    """A descriptor on the regular file at `path`, or OSError. The scan runs
    as root over folders a site's account writes to, so a path is never
    trusted twice: a symbolic link isn't followed (O_NOFOLLOW) and what was
    opened is checked once open, not before. With `expect`, the lstat the
    caller made, it must also be that very file (same device and inode), so
    one swapped in between the two calls is skipped rather than read."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_NOCTTY", 0))
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("not a regular file: %s" % path)
        if expect is not None and (info.st_dev, info.st_ino) != (expect.st_dev, expect.st_ino):
            raise OSError("replaced while being read: %s" % path)
    except OSError:
        os.close(fd)
        raise
    return fd


def file_signals(path):
    found = []
    if "/uploads/" in path and PHP_EXT.search(path):
        found.append("code_in_uploads")
    try:
        with os.fdopen(open_regular(path), "rb") as f:
            head = f.read(SIGNAL_BYTES)
    except OSError:
        return found
    found += [name for name, pattern in SIGNALS if pattern.search(head)]
    return found


def hash_file(path, expect=None):
    digest = hashlib.sha256()
    with os.fdopen(open_regular(path, expect), "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def scan_files(roots, exclude, previous, full):
    """{path: [sha256, size, mtime]} of the watched files. A file whose size
    and time are unchanged keeps its last hash unless `full`."""
    current, truncated = {}, False
    skip = tuple(os.path.abspath(e).rstrip("/") + "/" for e in exclude)
    for root in roots:
        if truncated:
            break
        for folder, dirs, names in os.walk(root, followlinks=False):
            # Past the limit there is nothing left to add, so the rest of the
            # tree isn't walked at all.
            if truncated:
                break
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not (os.path.join(folder, d) + "/").startswith(skip)
                       and not any(part in os.path.join(folder, d) + "/" for part in SKIP_PARTS)]
            for name in names:
                if not watched_file(name):
                    continue
                path = os.path.join(folder, name)
                try:
                    st = os.lstat(path)
                except OSError:
                    continue
                if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_FILE_BYTES:
                    continue
                if len(current) >= MAX_FILES:
                    truncated = True
                    break
                old = previous.get(path)
                if old and not full and old[1] == st.st_size and old[2] == int(st.st_mtime):
                    current[path] = old
                    continue
                try:
                    current[path] = [hash_file(path, st), st.st_size, int(st.st_mtime)]
                except OSError:
                    continue
    return current, truncated


def flagged_files(current, budget=MAX_SIGNAL_FILES):
    """Watched files that already look hacked, so the first scan can keep them
    out of the accepted baseline and report them. Bounded by `budget`."""
    flagged = set()
    for read, path in enumerate(sorted(current)):
        if read >= budget:
            break
        if file_signals(path):
            flagged.add(path)
    return flagged


def file_changes(baseline, current, budget=MAX_SIGNAL_FILES, roots=()):
    """roots: the folders scanned. A root that read as empty while the
    baseline has files in it (an unmounted share, a folder briefly
    unreadable) is treated as unread rather than as everything deleted."""
    changes = []
    read = 0
    # Sorted, so the files that get read are the same set from one scan to the
    # next rather than whatever the walk happened to reach first.
    for path, entry in sorted(current.items()):
        old = baseline.get(path)
        if old is None or old[0] != entry[0]:
            # Past the budget a change is still reported; only the look inside
            # it is skipped, so a deploy of everything can't turn into reading
            # everything.
            signals = file_signals(path) if read < budget else []
            read += 1
            changes.append({"path": path, "change": "added" if old is None else "modified", "sha256": entry[0],
                            "size": entry[1], "mtime": iso(entry[2]), "signals": signals})
    empty = tuple(root.rstrip("/") + "/" for root in roots
                  if not any(p.startswith(root.rstrip("/") + "/") for p in current))
    for path in baseline:
        if path in current:
            continue
        # Only a file that is really gone: one the scan didn't reach (past
        # MAX_FILES) is still on disk, and one under an empty root is unknown.
        if os.path.lexists(path) or path.startswith(empty):
            continue
        changes.append({"path": path, "change": "deleted", "sha256": None})
    changes.sort(key=lambda c: (not c.get("signals"), c["path"]))
    return changes


def file_sites(config):
    """A config per watched site: the main one (state in files.json, as
    before), then each of "sites" with its own ID, secret and record."""
    out = [dict(config, files_state="files.json")] if config["files_roots"] else []
    # A site there for its apps only has no files to watch.
    for site in [s for s in config["sites"] if s["files_roots"]]:
        out.append(dict(config, site_id=site["site_id"], secret=site["secret"], files_roots=site["files_roots"],
                        files_exclude=site["files_exclude"], files_state="files-%s.json" % site["site_id"].lower()))
    return out


def edit_config(change):
    """Applies change(dict) to the config file as written, atomically, root only."""
    with open(CONFIG_FILE) as f:
        raw = json.load(f)
    change(raw)
    folder = os.path.dirname(CONFIG_FILE) or "."
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".analytics-agent.")
    with os.fdopen(fd, "w") as f:
        json.dump(raw, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)


def add_site(site_id, folders):
    if not SITE_ID.match(site_id):
        sys.exit("That isn't a site ID (24 characters, from Site settings).")
    roots = [os.path.abspath(f) for f in folders]
    missing = [r for r in roots if not os.path.isdir(r)]
    if not roots or missing:
        sys.exit("Give the site's folder(s); not found: %s" % ", ".join(missing or ["(none given)"]))
    secret = os.environ.get("ANALYTICS_SITE_SECRET") or getpass.getpass("Site secret for %s (Site settings in your dashboard): " % site_id)
    if not secret:
        sys.exit("No site secret.")

    def change(raw):
        sites = [s for s in raw.get("sites") or [] if str(s.get("site_id", "")).lower() != site_id.lower()]
        raw["sites"] = sites + [{"site_id": site_id, "secret": secret, "files_roots": roots}]
    edit_config(change)
    print("Added. Restart to start watching it: systemctl restart analytics-agent")


def remove_site(site_id):
    def change(raw):
        raw["sites"] = [s for s in raw.get("sites") or [] if str(s.get("site_id", "")).lower() != site_id.lower()]
    edit_config(change)
    print("Removed. Restart to stop watching it: systemctl restart analytics-agent")


class Files:
    """The site's files against the accepted version (the baseline)."""

    def __init__(self, config):
        self.config = config
        self.state_file = os.path.join(config["state_dir"], config.get("files_state") or "files.json")
        self.baseline, self.last, self.full_at, self.next_at = None, {}, 0, 0
        self.lock = threading.Lock()
        self.thread = None
        try:
            with open(self.state_file) as f:
                saved = json.load(f)
            self.baseline, self.last = saved.get("baseline"), saved.get("last") or {}
            self.full_at, self.next_at = saved.get("full_at", 0), saved.get("next_at", 0)
        except (OSError, ValueError):
            pass

    def save(self):
        fd, tmp = tempfile.mkstemp(dir=self.config["state_dir"])
        with os.fdopen(fd, "w") as f:
            json.dump({"baseline": self.baseline, "last": self.last, "full_at": self.full_at, "next_at": self.next_at}, f)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.state_file)

    def run(self, accept=False):
        """Scans, reports, takes in what the owner accepted. Returns the changes reported."""
        with self.lock:
            now = time.time()
            full = now - self.full_at >= FULL_HASH_EVERY
            current, truncated = scan_files(self.config["files_roots"], self.config["files_exclude"], self.last, full)
            if full:
                self.full_at = now
            fresh = self.baseline is None or accept
            if fresh:
                # Files that already look hacked stay out, so they're reported from the start.
                flagged = set() if accept else flagged_files(current)
                self.baseline = {p: e for p, e in current.items() if p not in flagged}
            changes = file_changes(self.baseline, current, roots=self.config["files_roots"])
            self.last = current
            body = {"site_id": self.config["site_id"], "host": socket.gethostname()[:100],
                    "scan": {"at": iso(now), "roots": self.config["files_roots"], "files": len(current),
                             "baseline": fresh and not accept, "accepted": accept, "truncated": truncated},
                    "changes": changes[:MAX_CHANGES]}
            status, _, raw = request(self.config, "POST", "/events/files/scan", body=body)
            every = FILES_EVERY
            if status == 200:
                try:
                    answer = json.loads(raw)
                except ValueError:
                    answer = {}
                every = max(300, int(answer.get("every") or FILES_EVERY))
                if answer.get("accept_all"):
                    self.baseline = dict(current)
                for item in answer.get("accept") or []:
                    path, sha = item.get("path"), item.get("sha256")
                    if sha is None and path not in current:
                        self.baseline.pop(path, None)
                    elif path in current and current[path][0] == sha:
                        self.baseline[path] = current[path]
                if answer.get("enabled") is False:
                    log("file monitoring is off in the dashboard (Security → Server package)")
            elif status:
                log("collector answered %s to the file scan" % status)
            self.next_at = now + (every if status == 200 else RETRY * 5)
            self.save()
            return changes

    def due(self):
        return bool(self.config["files_roots"]) and time.time() >= self.next_at

    def running(self):
        return bool(self.thread and self.thread.is_alive())

    def run_in_background(self):
        """Never holds up the firewall: one scan at a time, in its own thread."""
        if self.running():
            return

        def work():
            try:
                changes = self.run()
                if changes:
                    log("files of %s: %d differ from the accepted version" % (self.config["site_id"], len(changes)))
            except Exception as error:
                log("file scan failed:", error)
                self.next_at = time.time() + RETRY * 5

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()

# ---- How the server is set up (sdk/protocols/posture.md) -----------------------
# Once a day, in the background: the settings that leave the server open, the
# scheduled jobs and SSH keys a break-in hides in to come back, and files in the
# web folder that should never be public. It only reads — nothing here changes a
# setting, a permission or a file — and it never sends a file's contents: paths,
# hashes, sizes, times, key fingerprints and short values only.

POSTURE_EVERY = 24 * 3600
POSTURE_MAX_ENTRIES = 30000
POSTURE_MAX_DEPTH = 6
POSTURE_MAX_PERM_CHECKS = 3000
POSTURE_MAX_EXPOSURE = 50
POSTURE_MAX_CRON = 100
POSTURE_MAX_KEYS = 50
POSTURE_SKIP_DIRS = {".git", ".svn", ".hg", "node_modules", "vendor", "cache", ".cache", ".history"}
POSTURE_CODE = re.compile(r"\.(php[0-9]?|phtml|phar|inc|m?js|cjs|py|rb|pl|sh)$", re.I)
# Files that shouldn't be in a web folder, by name; first match wins.
POSTURE_EXPOSURE = [
    ("database_dump", re.compile(r"\.sql(\.(gz|bz2|xz|zip))?$", re.I)),
    ("private_key", re.compile(r"^(id_rsa|id_dsa|id_ecdsa|id_ed25519)$|\.(pem|key|p12|pfx|jks)$", re.I)),
    ("env", re.compile(r"^\.env($|\.)|^env\.(ini|txt)$", re.I)),
    ("archive", re.compile(r"\.(zip|tar|tgz|tar\.gz|tar\.bz2|rar|7z)$", re.I)),
    ("backup", re.compile(r"\.(bak|old|orig|save|swp|copy|backup)$|~$|\.(php|conf|config|ini|yml|yaml|json)\.(bak|old|orig|save|txt)$", re.I)),
    ("info", re.compile(r"^(phpinfo|info|test|adminer|phpmyadmin|pma)\.php$", re.I)),
    ("log", re.compile(r"^(debug|error|php_error|access)[-_.]?log$|\.log$", re.I)),
]
CRON_DIRS = ["/etc/cron.d", "/etc/cron.hourly", "/etc/cron.daily", "/etc/cron.weekly", "/etc/cron.monthly", "/var/spool/cron/crontabs", "/var/spool/cron"]


def read_text(path, limit=65536):
    try:
        with open(path, "rb") as f:
            return f.read(limit).decode("utf-8", "replace")
    except OSError:
        return ""


def sshd_settings():
    """sshd_config as a dict of the values that count (the first one sshd
    reads wins), with the Include files Ubuntu and Debian put at the top.
    An Include is read where it stands, as sshd does, so a drop-in included
    first beats the same setting further down the main file."""
    values, seen = {}, set()

    def read(path):
        if path in seen or len(seen) > 100:
            return
        seen.add(path)
        for line in read_text(path).splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.replace("=", " ").split()
            if len(parts) < 2:
                continue
            key, value = parts[0].lower(), parts[1]
            if key == "include":
                for pattern in parts[1:]:
                    # A relative Include is relative to /etc/ssh.
                    for name in sorted(glob.glob(os.path.join("/etc/ssh", pattern))):
                        read(name)
            elif key == "match":
                # Settings inside a Match block apply to some logins only: stop here.
                break
            elif key not in values:
                values[key] = value.lower()

    read("/etc/ssh/sshd_config")
    return values


def listening_ports(allowed):
    """Ports listening on every address (0.0.0.0 or ::), from /proc. No
    command is run, and a service bound to localhost is not reported."""
    ports = set()
    for name in ("/proc/net/tcp", "/proc/net/tcp6"):
        for line in read_text(name, 8 << 20).splitlines()[1:]:
            parts = line.split()
            if len(parts) < 4 or parts[3] != "0A":
                continue
            local = parts[1].split(":")
            if len(local) != 2:
                continue
            address, port = local
            # Only "every address" counts: a specific address or loopback doesn't.
            if set(address) != {"0"}:
                continue
            try:
                number = int(port, 16)
            except ValueError:
                continue
            if number and number not in allowed:
                ports.add(number)
    return sorted(ports)


def key_fingerprints(path):
    """The SHA256 fingerprints in an authorized_keys file, as ssh-keygen -lf
    prints them. The keys themselves are never sent."""
    import base64
    out = []
    for line in read_text(path, 1 << 18).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        for field in line.split():
            if field.startswith("AAAA"):
                try:
                    blob = base64.b64decode(field + "==", validate=False)
                except Exception:
                    break
                digest = base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
                out.append("SHA256:" + digest)
                break
        if len(out) >= 20:
            break
    return out


def authorized_keys_files():
    """/root and every account with a home folder (from /etc/passwd only)."""
    homes = ["/root"]
    for line in read_text("/etc/passwd", 1 << 18).splitlines():
        parts = line.split(":")
        if len(parts) >= 6 and parts[5].startswith("/home/"):
            homes.append(parts[5])
    out = []
    for home in homes[:POSTURE_MAX_KEYS]:
        path = os.path.join(home, ".ssh", "authorized_keys")
        if not os.path.isfile(path):
            continue
        fingerprints = key_fingerprints(path)
        if not fingerprints:
            continue
        try:
            mtime = iso(os.path.getmtime(path))
        except OSError:
            mtime = None
        row = {"user": os.path.basename(home.rstrip("/")) or "root", "path": path, "fingerprints": fingerprints}
        if mtime:
            row["mtime"] = mtime
        out.append(row)
    return out


def cron_files():
    """The scheduled job files, hashed. What's in them stays on the server."""
    paths = ["/etc/crontab"]
    for folder in CRON_DIRS:
        try:
            paths.extend(sorted(os.path.join(folder, name) for name in os.listdir(folder)))
        except OSError:
            continue
    out = []
    for path in paths:
        if len(out) >= POSTURE_MAX_CRON:
            break
        if not os.path.isfile(path) or os.path.islink(path):
            continue
        text = read_text(path)
        if not text:
            continue
        digest = hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()
        entries = len([l for l in text.splitlines() if l.strip() and not l.strip().startswith("#")])
        if not entries:
            # /etc/cron.d/.placeholder and the like: nothing is scheduled.
            continue
        row = {"path": path, "sha256": digest, "entries": entries}
        try:
            row["mtime"] = iso(os.path.getmtime(path))
        except OSError:
            pass
        out.append(row)
    return out


def exposure_kind(name):
    for kind, pattern in POSTURE_EXPOSURE:
        if pattern.search(name):
            return kind
    return None


def without_nested(roots):
    """A folder inside another one on the list is already covered: without
    this, every file under it would be reported twice."""
    clean = sorted({os.path.abspath(r).rstrip("/") for r in roots})
    return [r for r in clean if not any(o != r and (r + "/").startswith(o + "/") for o in clean)]


def scan_posture(roots, exclude):
    """One bounded walk of the web folders: files that shouldn't be public,
    and code any account on the machine can rewrite."""
    exposure, examples = [], []
    writable = checked = entries = 0
    skip = [os.path.abspath(e).rstrip("/") + "/" for e in exclude or []]
    for root in without_nested(roots):
        root = root.rstrip("/")
        queue = [(root, 0)]
        while queue:
            folder, depth = queue.pop(0)
            try:
                names = os.listdir(folder)
            except OSError:
                continue
            for name in names:
                entries += 1
                if entries > POSTURE_MAX_ENTRIES:
                    return exposure, writable, examples, True
                path = os.path.join(folder, name)
                if os.path.islink(path):
                    continue
                relative = path[len(root):].lstrip("/")
                if os.path.isdir(path):
                    if name in {".git", ".svn", ".hg", ".bzr"}:
                        if len(exposure) < POSTURE_MAX_EXPOSURE:
                            exposure.append({"path": relative + "/config", "kind": "vcs"})
                        continue
                    if depth + 1 > POSTURE_MAX_DEPTH or name in POSTURE_SKIP_DIRS:
                        continue
                    # With the trailing "/" on both, as scan_files does: excluding
                    # /var/www/app must not also skip /var/www/app-backup.
                    if (path.rstrip("/") + "/").startswith(tuple(skip)):
                        continue
                    queue.append((path, depth + 1))
                    continue
                if not os.path.isfile(path):
                    continue
                kind = exposure_kind(name)
                if kind and len(exposure) < POSTURE_MAX_EXPOSURE:
                    row = {"path": relative, "kind": kind}
                    try:
                        info = os.stat(path)
                        row["size"] = info.st_size
                        row["mtime"] = iso(info.st_mtime)
                    except OSError:
                        pass
                    exposure.append(row)
                if checked < POSTURE_MAX_PERM_CHECKS and POSTURE_CODE.search(name):
                    checked += 1
                    try:
                        if os.stat(path).st_mode & stat.S_IWOTH:
                            writable += 1
                            if len(examples) < 3:
                                examples.append(relative)
                    except OSError:
                        pass
    return exposure, (writable if checked else None), examples, False


def posture_facts(config):
    facts = {"agent": "analytics-agent/%s" % VERSION}
    release = read_text("/etc/os-release", 8192)
    name = version = ""
    for line in release.splitlines():
        if line.startswith("ID="):
            name = line[3:].strip().strip('"')
        elif line.startswith("VERSION_ID="):
            version = line[11:].strip().strip('"')
    if name:
        facts["os_name"] = name
        facts["os"] = ("%s %s" % (name, version)).strip()
    if version:
        facts["os_version"] = version
    try:
        facts["kernel"] = os.uname().release
    except Exception:
        pass
    if config.get("files_roots"):
        facts["webroot"] = config["files_roots"][0]
    return facts


# How long any of the package-manager questions below may take. These run on
# the posture schedule, never in a request, but a server whose package
# manager is mid-update or waiting on a lock must not hold the agent there.
UPDATES_TIMEOUT = 20


def _run(args, ok=(0,)):
    """A read-only command's stdout and stderr, or None if it didn't run or
    didn't finish well. The exit code matters here: `apt-get -s upgrade`
    prints its complaint and leaves, and reading that as "nothing to install"
    would report a server behind on patches as a clean one. `dnf
    check-update` is the opposite and says 100 for "there are updates", so a
    caller passes the codes that count as an answer."""
    try:
        done = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=UPDATES_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode not in ok:
        return None
    return "%s\n%s" % (done.stdout or "", done.stderr or "")


def parse_apt_check(text):
    """update-notifier's apt-check prints "<all>;<security>" and prints it on
    stderr. Returns (all, security), or None if that isn't what came back."""
    for line in (text or "").splitlines():
        line = line.strip()
        if re.match(r"^\d+;\d+$", line):
            everything, security = line.split(";")
            return int(everything), int(security)
    return None


def parse_apt_simulation(text):
    """`apt-get -s upgrade` lists one "Inst " line per package it would take.
    A security update is one whose source is a -security pocket. Text with no
    Inst lines in it means a server with nothing waiting: the run already had
    to succeed to get here, so that is a real zero, not a failure."""
    if text is None:
        return None
    lines = [l for l in text.splitlines() if l.startswith("Inst ")]
    security = [l for l in lines if "-security" in l or "Debian-Security" in l]
    return len(lines), len(security)


def parse_dnf_check(text):
    """`dnf check-update` lists "name.arch  version  repo" per update, after a
    blank line, and says "Obsoleting Packages" before a tail we don't count."""
    count = 0
    for line in (text or "").splitlines():
        if line.startswith("Obsoleting Packages"):
            break
        # Three columns, the first of which is a package.arch.
        if re.match(r"^\S+\.\S+\s+\S+\s+\S+\s*$", line) and not line.startswith(("Last metadata", "Loaded plugins")):
            count += 1
    return count


def pending_updates():
    """How many updates this server is waiting to install, and how many of
    those close a security hole: (all, security). None when the machine can't
    say — a package manager we don't know, or one that didn't answer. Never a
    guess, and nothing here installs anything: every command is a query or a
    simulation."""
    if os.path.exists("/etc/debian_version"):
        # Ubuntu's own counter, the cheapest answer and the one its MOTD uses.
        if os.path.exists("/usr/lib/update-notifier/apt-check"):
            counted = parse_apt_check(_run(["/usr/lib/update-notifier/apt-check"]))
            if counted:
                return counted
        # Debian without update-notifier. -s simulates and takes no lock, so
        # this is safe to run next to a real apt.
        return parse_apt_simulation(_run(["apt-get", "-s", "-q", "-o", "Debug::NoLocking=true", "upgrade"]))
    if os.path.exists("/usr/bin/dnf") or os.path.exists("/bin/dnf"):
        # -C keeps it to the metadata already on disk: no network, no refresh.
        # 100 is dnf for "there are updates"; 0 is "there are none".
        everything = _run(["dnf", "-q", "-C", "check-update"], ok=(0, 100))
        if everything is None:
            return None
        security = _run(["dnf", "-q", "-C", "--security", "check-update"], ok=(0, 100))
        if security is None:
            return None
        return parse_dnf_check(everything), parse_dnf_check(security)
    return None


def docker_socket_accounts(path):
    """The accounts other than root that can write to the Docker socket. The
    group bit alone says nothing: Docker always sets it, and a group with
    nobody in it reaches no one."""
    info = os.stat(path)
    if info.st_mode & stat.S_IWOTH:
        return ["every account"]
    if not info.st_mode & stat.S_IWGRP:
        return []
    # gr_mem leaves out the accounts that have it as their primary group.
    primary = [user.pw_name for user in pwd.getpwall() if user.pw_gid == info.st_gid]
    return sorted((set(grp.getgrgid(info.st_gid).gr_mem) | set(primary)) - {"root"})


def posture_report(config):
    """Everything this server has to say about how it's set up."""
    checks = []

    def add(check_id, failed, value=""):
        row = {"id": check_id, "state": "unknown" if failed is None else ("fail" if failed else "pass")}
        if value:
            row["value"] = value
        checks.append(row)

    sshd = sshd_settings()
    if sshd:
        root_login = sshd.get("permitrootlogin")
        # The default is "prohibit-password": keys only, which is not a finding.
        add("server.ssh_root_login", None if root_login is None else root_login == "yes")
        passwords = sshd.get("passwordauthentication")
        add("server.ssh_password_auth", None if passwords is None else passwords != "no")
    auto = read_text("/etc/apt/apt.conf.d/20auto-upgrades", 8192)
    if os.path.exists("/etc/debian_version"):
        add("server.auto_updates", not re.search(r'Unattended-Upgrade"\s+"1"', auto))
    elif os.path.exists("/usr/lib/systemd/system/dnf-automatic.timer") or os.path.exists("/usr/lib/systemd/system/dnf-automatic-install.timer"):
        add("server.auto_updates", not os.path.exists("/etc/systemd/system/timers.target.wants/dnf-automatic.timer")
            and not os.path.exists("/etc/systemd/system/timers.target.wants/dnf-automatic-install.timer"))
    if os.path.exists("/etc/debian_version"):
        add("server.reboot_required", os.path.exists("/var/run/reboot-required") or os.path.exists("/run/reboot-required"))
    counted = pending_updates()
    if counted is None:
        add("server.security_updates", None)
    else:
        everything, security = counted
        add("server.security_updates", security > 0,
            "%d security, %d in all" % (security, everything) if security else "")
    # SYN cookies keep a server answering when a flood of half-open
    # connections fills the queue; the kernel limits can't stand in for them.
    syncookies = read_text("/proc/sys/net/ipv4/tcp_syncookies", 64).strip()
    if syncookies in ("0", "1", "2"):
        add("server.tcp_syncookies", syncookies == "0", "off" if syncookies == "0" else "")
    ports = listening_ports(set(config["ports"]) | {22})
    add("server.listening_ports", bool(ports), ", ".join(str(p) for p in ports[:12]) if ports else "")
    if os.path.exists("/var/run/docker.sock") or os.path.exists("/run/docker.sock"):
        sock = "/var/run/docker.sock" if os.path.exists("/var/run/docker.sock") else "/run/docker.sock"
        try:
            accounts = docker_socket_accounts(sock)
            add("server.docker_socket", bool(accounts), ", ".join(accounts[:12]))
        except (OSError, KeyError):
            add("server.docker_socket", None)
    exposure, writable, examples, truncated = scan_posture(config.get("files_roots") or [], config.get("files_exclude") or [])
    if writable is not None:
        add("server.code_writable", writable > 0,
            "%d files, e.g. %s" % (writable, ", ".join(examples)) if writable else "")
    body = {
        "site_id": config["site_id"],
        "host": socket.gethostname()[:100],
        "at": iso(time.time()),
        "checks": checks,
        "facts": posture_facts(config),
        "persistence": {"keys": authorized_keys_files(), "files": cron_files()},
    }
    # Left out when there's no folder to walk: the dashboard then says this
    # wasn't checked, instead of taking an empty walk for a clean one.
    if config.get("files_roots"):
        body["exposure"] = exposure[:POSTURE_MAX_EXPOSURE]
    if truncated:
        body["truncated"] = True
    return body


def posture_sites(config):
    """A config per site to report for: the main one, then each extra site
    (the server-wide checks are the same; each site's folders are its own)."""
    out = [dict(config, posture_state="posture.json")]
    for site in config["sites"]:
        out.append(dict(config, site_id=site["site_id"], secret=site["secret"], files_roots=site["files_roots"],
                        files_exclude=site["files_exclude"], posture_state="posture-%s.json" % site["site_id"].lower()))
    return out


class Posture:
    """How the server is set up, reported about once a day."""

    def __init__(self, config):
        self.config = config
        self.state_file = os.path.join(config["state_dir"], config.get("posture_state") or "posture.json")
        self.next_at = 0
        self.lock = threading.Lock()
        self.thread = None
        try:
            with open(self.state_file) as f:
                self.next_at = json.load(f).get("next_at", 0)
        except (OSError, ValueError):
            pass

    def save(self):
        fd, tmp = tempfile.mkstemp(dir=self.config["state_dir"])
        with os.fdopen(fd, "w") as f:
            json.dump({"next_at": self.next_at}, f)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.state_file)

    def run(self, body=None):
        """Reports now (`body`: a report already made, so the CLI doesn't walk
        the web folder twice). Returns the checks that failed."""
        with self.lock:
            body = body or posture_report(self.config)
            status, _, raw = request(self.config, "POST", "/events/posture", body=body)
            every = POSTURE_EVERY
            if status == 200:
                try:
                    answer = json.loads(raw)
                except ValueError:
                    answer = {}
                every = max(3600, int(answer.get("every") or POSTURE_EVERY))
                if answer.get("enabled") is False:
                    log("the set-up checks are off in the dashboard (Security → Server package)")
            elif status:
                log("collector answered %s to the posture report" % status)
            self.next_at = time.time() + (every if status == 200 else RETRY * 10)
            self.save()
            return [c for c in body["checks"] if c["state"] == "fail"]

    def due(self):
        return time.time() >= self.next_at

    def running(self):
        return bool(self.thread and self.thread.is_alive())

    def run_in_background(self):
        if self.running():
            return

        def work():
            try:
                failed = self.run()
                if failed:
                    log("set-up of %s: %d check(s) failed" % (self.config["site_id"], len(failed)))
            except Exception as error:
                log("posture report failed:", error)
                self.next_at = time.time() + RETRY * 10

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


# ---- How the machine is doing (sdk/protocols/resources.md) ---------------------

# CPU, load, memory, swap and disks, one row per minute, posted every few
# minutes. The other half of what a customer would otherwise install
# node_exporter, Prometheus and Grafana for: the performance module says how
# the requests went, this says whether the box can still serve them.
#
# Sampling runs on its own thread, not the shared "one job at a time" queue the
# file and set-up checks use: a sample costs a few /proc reads, and it must not
# wait behind a file scan that takes minutes.
#
# Nothing is guessed. A reading this machine won't give us is left out of the
# row, and the collector stores it as NULL, because "0%" and "we couldn't
# measure it" are different statements.
RESOURCES_SAMPLE_EVERY = 60
RESOURCES_POST_EVERY = 300
# About 8 hours of samples: enough to ride out a collector outage, bounded so
# a long one can't grow in memory.
RESOURCES_MAX_ROWS = 500
RESOURCES_MAX_DISKS = 20
# Nobody watches a sub-gigabyte partition fill up: this drops the EFI partition
# and other small mounts without needing a list of paths.
RESOURCES_MIN_DISK_MB = 1024
# Real on-disk filesystems only: no tmpfs, devtmpfs, proc, sysfs, cgroup,
# squashfs (snaps) or network mounts, none of which are the customer's disk.
# overlay is here so the agent also reports something sensible in a container.
RESOURCES_FSTYPES = {"ext2", "ext3", "ext4", "xfs", "btrfs", "zfs", "f2fs", "jfs",
                     "reiserfs", "ufs", "vfat", "exfat", "ntfs", "ntfs3", "overlay"}


# Sectors in /proc/diskstats are always 512 bytes, whatever the drive's own
# sector size: it is the unit of that interface, not of the hardware.
IO_SECTOR = 512
# A pair of counter readings further apart than this says nothing useful about
# "now", so the rate is dropped rather than reported for the wrong window.
IO_MAX_PAIR_SECONDS = 300
# Not disks: loop and ram devices, optical drives, device-mapper and md, which
# would count the devices underneath them a second time.
IO_NOT_A_DISK = re.compile(r"^(?:loop|ram|zram|sr|fd|dm-|md\d)")
# Partitions, which must not be counted alongside the disk they sit on.
IO_PARTITION = re.compile(r"^(?:(?:sd|vd|xvd|hd)[a-z]+\d+|(?:nvme\d+n\d+|mmcblk\d+)p\d+)$")
# Not interfaces whose traffic is someone else's counted twice: loopback, and
# the virtual ends of container and VM networking.
NET_NOT_REAL = re.compile(r"^(?:lo|veth|docker|br-|virbr|tap|tun|vnet)")


def cpu_fields(text):
    """The jiffie counters from /proc/stat's first line, or None.

    In order: user, nice, system, idle, iowait, irq, softirq, steal, and on
    newer kernels guest and guest_nice."""
    for line in text.splitlines():
        if not line.startswith("cpu "):
            continue
        try:
            fields = [int(v) for v in line.split()[1:]]
        except ValueError:
            return None
        return fields if len(fields) >= 4 else None
    return None


def cpu_total(fields):
    """Every jiffy in the counters once. guest and guest_nice (columns 9 and
    10) are already inside user and nice, so they are left out, as psutil and
    top do: counting them again reads a busy hypervisor as half idle."""
    return sum(fields[:8])


def cpu_times_of(fields):
    """(busy, total) jiffies from the counters, for cpu_percent."""
    total = cpu_total(fields)
    idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
    return total - idle, total


def cpu_times(text):
    """(busy, total) jiffies from /proc/stat's first line, or None.

    idle and iowait are the machine doing nothing; everything else, steal
    included, is time it wasn't available to us."""
    fields = cpu_fields(text)
    return None if fields is None else cpu_times_of(fields)


# user is reported with nice folded in, which is what `top` adds together as
# user time; the breakdown is about where the machine went, not scheduling
# priority. Each is a share of the whole interval, so they add up to at most
# 100 with idle and the interrupt buckets making up the rest.
CPU_SHARES = (
    ("cpu_user_pct", (0, 1)),
    ("cpu_system_pct", (2,)),
    ("cpu_iowait_pct", (4,)),
    ("cpu_steal_pct", (7,)),
)


def cpu_shares(before, after):
    """Where the machine's time went between two /proc/stat readings.

    Empty when the pair can't say, and a figure is left out entirely on a
    kernel too old to carry its column — never sent as a zero. steal is the
    one worth surfacing: it is time the hypervisor gave to another tenant, so
    the machine was not available to us and no tuning of ours will change it.
    """
    if not before or not after:
        return {}
    total = cpu_total(after) - cpu_total(before)
    if total <= 0:
        return {}
    out = {}
    for name, columns in CPU_SHARES:
        if any(i >= len(before) or i >= len(after) for i in columns):
            continue
        moved = sum(after[i] - before[i] for i in columns)
        if moved < 0:
            return {}
        out[name] = round(min(100.0, 100.0 * moved / total), 1)
    return out


def disk_counters(text):
    """(bytes read, bytes written) since boot over the real disks, or None.

    Partitions are skipped so they are not counted twice with the disk they
    sit on, and loop/ram/device-mapper devices are not disks at all."""
    read = written = 0
    found = False
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 10:
            continue
        name = fields[2]
        if IO_NOT_A_DISK.match(name) or IO_PARTITION.match(name):
            continue
        try:
            read += int(fields[5]) * IO_SECTOR
            written += int(fields[9]) * IO_SECTOR
        except ValueError:
            continue
        found = True
    return (read, written) if found else None


def net_counters(text):
    """(bytes in, bytes out) since boot over the real interfaces, or None."""
    rx = tx = 0
    found = False
    for line in text.splitlines():
        if ":" not in line:
            continue
        name, rest = line.split(":", 1)
        name = name.strip()
        if not name or NET_NOT_REAL.match(name):
            continue
        fields = rest.split()
        if len(fields) < 9:
            continue
        try:
            rx += int(fields[0])
            tx += int(fields[8])
        except ValueError:
            continue
        found = True
    return (rx, tx) if found else None


def rate_mbs(before, after, seconds):
    """Megabytes a second between two byte counters, or None when the pair
    can't say: no pair, a reboot that reset them, no time, or too long a gap
    to call it a rate for this minute."""
    if before is None or after is None:
        return None
    if seconds <= 0 or seconds > IO_MAX_PAIR_SECONDS:
        return None
    moved = after - before
    if moved < 0:
        return None
    return round(moved / seconds / (1024 * 1024), 1)


def cpu_percent(before, after):
    """How busy the machine was between two /proc/stat readings, or None when
    the pair can't say (first sample, a counter reset, no time passed)."""
    if not before or not after:
        return None
    busy, total = after[0] - before[0], after[1] - before[1]
    if total <= 0 or busy < 0:
        return None
    return round(min(100.0, 100.0 * busy / total), 1)


def memory_mb(text):
    """MemTotal/MemAvailable/Swap from /proc/meminfo, in whole megabytes.

    Used is total - MemAvailable, never total - MemFree: page cache is not
    pressure, and counting it as used makes every healthy Linux box look full.
    A field the kernel didn't give us is left out of the result."""
    values = {}
    for line in text.splitlines():
        name, _, rest = line.partition(":")
        fields = rest.split()
        if not fields:
            continue
        try:
            values[name] = int(fields[0]) // 1024  # kB -> MB
        except ValueError:
            continue
    out = {}
    if "MemTotal" in values:
        out["mem_total_mb"] = values["MemTotal"]
        if "MemAvailable" in values:
            out["mem_used_mb"] = max(0, values["MemTotal"] - values["MemAvailable"])
    if "SwapTotal" in values:
        out["swap_total_mb"] = values["SwapTotal"]
        if "SwapFree" in values:
            out["swap_used_mb"] = max(0, values["SwapTotal"] - values["SwapFree"])
    return out


def disk_rows(mounts_text, statvfs=None, is_dir=None):
    """The real disks behind /proc/mounts, as the protocol's rows.

    One entry per device, under its shortest mount point, so bind mounts and
    the same disk mounted twice are not reported as two disks.

    A mount point has to be a **directory**. Docker bind-mounts single files,
    so a container lists /etc/hosts, /etc/hostname and /etc/resolv.conf on the
    host's own device, and those paths are short enough to win the
    shortest-path race against the real mount. The test is per-device and
    advisory: a device whose mounts we cannot confirm keeps its shortest one,
    because reporting no disks is worse than reporting an odd mount point.

    Both figures are `df`'s, so they can be checked against it: used is
    total-minus-free, and total is used plus what's available to us. That
    leaves out the blocks reserved for root, which the site can never have, so
    used/total is the same percentage `df` prints — the figure the alerts are
    about."""
    statvfs = statvfs or os.statvfs
    is_dir = is_dir or os.path.isdir
    dirs, any_mount = {}, {}
    for line in mounts_text.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        device, mount, fstype = fields[0], fields[1].replace("\\040", " "), fields[2]
        if fstype not in RESOURCES_FSTYPES or not mount.startswith("/"):
            continue
        # The shortest path wins: "/" over "/var" for one device.
        if device not in any_mount or len(mount) < len(any_mount[device]):
            any_mount[device] = mount
        try:
            confirmed = is_dir(mount)
        except OSError:
            confirmed = False
        if confirmed and (device not in dirs or len(mount) < len(dirs[device])):
            dirs[device] = mount
    best = {d: dirs.get(d, m) for d, m in any_mount.items()}
    # One filesystem can sit behind two devices the kernel calls different: in
    # a container / is the overlay and a bind mount exposes the host disk the
    # overlay's upperdir lives on, so both report the same size and the same
    # free space down to the byte. No device-based rule separates them, so the
    # sizes are what gives it away. Raw bytes, not rounded megabytes, so disks
    # that merely round alike stay apart; two separate but identically sized
    # and identically empty filesystems do collapse into one until something
    # is written to either, and being empty they owe the fullness alert
    # nothing.
    seen = set()
    rows = []
    for mount in sorted(set(best.values())):
        try:
            st = statvfs(mount)
        except OSError:
            continue
        block = st.f_frsize or st.f_bsize
        if not block or not st.f_blocks:
            continue
        used = max(0, st.f_blocks - st.f_bfree) * block
        total = used + st.f_bavail * block
        row = {"mount": mount, "total_mb": total // (1024 * 1024), "used_mb": used // (1024 * 1024)}
        if row["total_mb"] < RESOURCES_MIN_DISK_MB:
            continue
        # Sorted, so the shortest path wins the collision.
        if (total, used) in seen:
            continue
        seen.add((total, used))
        # A filesystem can refuse a write with gigabytes free once these meet,
        # and every byte-based check still reads healthy.
        if st.f_files:
            row["inodes_total"] = st.f_files
            row["inodes_used"] = max(0, st.f_files - st.f_ffree)
        rows.append(row)
        if len(rows) >= RESOURCES_MAX_DISKS:
            break
    return rows


def host_uptime(text):
    """Seconds since boot from /proc/uptime, or None. A drop between two
    samples is a reboot, which is worth seeing beside a latency spike."""
    try:
        return int(float(text.split()[0]))
    except (IndexError, ValueError):
        return None


def load_average():
    try:
        one, five, fifteen = os.getloadavg()
    except (OSError, AttributeError):
        return {}
    return {"load1": round(one, 2), "load5": round(five, 2), "load15": round(fifteen, 2)}


# ---- How close it is to a wall (resources.md, "Limits") ---------------------
#
# The machine's own half of the limits pass. The cgroup caps are the
# packages' (they run inside the app's container; the agent runs on the host,
# whose cgroup is no app's), and so are the process fields: the agent isn't
# the site's application. What only the machine can say is here: kills for
# memory anywhere on it, how long tasks waited for CPU, memory and disk, the
# connections the kernel refused before an app accepted them, and how full
# the connection-tracking table is. Each is left out where this kernel has no
# such file, never sent as 0.


def vmstat_oom_kills(text):
    """/proc/vmstat's oom_kill (kernel 4.13 on): processes killed for memory
    since boot, on the whole machine. None where the line isn't there."""
    for line in (text or "").splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "oom_kill":
            try:
                return int(parts[1])
            except ValueError:
                return None
    return None


def pressure_some(text):
    """The "some" line's avg60 of a /proc/pressure file: the share of the
    last minute in which at least one task was waiting. None without one."""
    match = re.search(r"^some\b[^\n]*\bavg60=([\d.]+)", text or "", re.M)
    if not match:
        return None
    try:
        return round(min(100.0, float(match.group(1))), 1)
    except ValueError:
        return None


def listen_overflows(text):
    """TcpExt ListenOverflows from /proc/net/netstat: connections refused
    since boot because an accept queue was full. A header line, then values."""
    lines = (text or "").splitlines()
    for header, values in zip(lines, lines[1:]):
        if not (header.startswith("TcpExt:") and values.startswith("TcpExt:")):
            continue
        names, numbers = header.split(), values.split()
        if "ListenOverflows" not in names:
            return None
        at = names.index("ListenOverflows")
        try:
            return int(numbers[at]) if at < len(numbers) else None
        except ValueError:
            return None
    return None


def conntrack_pct(reader=read_text):
    """How full the kernel's connection-tracking table is, or None where the
    firewall never loaded it."""
    count = _cgroup_number(reader("/proc/sys/net/netfilter/nf_conntrack_count", 64))
    most = _cgroup_number(reader("/proc/sys/net/netfilter/nf_conntrack_max", 64))
    if count is None or not most or most <= 0:
        return None
    return round(min(100.0, 100.0 * count / most), 1)


def count_since(before, after):
    """How much a counter moved between two readings, or None: no pair, or it
    went down (a reset, not a negative count). Unlike a rate it is never
    dropped for the readings being far apart: a kill is a kill."""
    if before is None or after is None or after < before:
        return None
    return after - before


def limits_counters(reader=read_text):
    """The two counters the limits pass diffs: (oom kills, listen overflows)."""
    return vmstat_oom_kills(reader("/proc/vmstat")), listen_overflows(reader("/proc/net/netstat"))


def limits_fields(before, after, reader=read_text):
    """The machine's limits fields for one sample: the counts from the
    counters `before` and `after` (limits_counters), the rest read once."""
    out = {}
    before = before or (None, None)
    kills = count_since(before[0], after[0])
    if kills is not None:
        out["oom_kills"] = kills
    drops = count_since(before[1], after[1])
    if drops is not None:
        out["listen_drops"] = drops
    for name, resource in (("psi_cpu_pct", "cpu"), ("psi_mem_pct", "memory"), ("psi_io_pct", "io")):
        value = pressure_some(reader("/proc/pressure/" + resource, 4096))
        if value is not None:
            out[name] = value
    table = conntrack_pct(reader)
    if table is not None:
        out["conntrack_pct"] = table
    return out


def resource_sample(at, cpu=None, reader=read_text, extra=None):
    """One row of the protocol for the minute containing `at`.

    `cpu` is the percentage worked out from the pair of /proc/stat readings
    around the interval; the caller owns that, because one reading can't say.
    `extra` carries the rest of what needs two readings — the CPU breakdown
    and the disk and network rates — for the same reason.

    The agent sends no proc_rss_mb: it is not the site's application and has no
    way to know which process is. The packages, which run inside it, do."""
    row = {"minute": iso(int(at // 60) * 60)}
    if cpu is not None:
        row["cpu_pct"] = cpu
    cores = os.cpu_count()
    if cores:
        row["cpu_cores"] = cores
    row.update(load_average())
    row.update(memory_mb(reader("/proc/meminfo")))
    disks = disk_rows(reader("/proc/mounts"))
    if disks:
        row["disks"] = disks
    uptime = host_uptime(reader("/proc/uptime"))
    if uptime is not None:
        row["host_uptime_s"] = uptime
    for name, value in (extra or {}).items():
        if value is not None:
            row[name] = value
    return row


def resources_sites(config):
    """One entry per site on this server. The machine is the same for all of
    them, so they get the same rows, each under its own secret — as the
    server-wide set-up checks already do."""
    out = [dict(config)]
    for site in config["sites"]:
        out.append(dict(config, site_id=site["site_id"], secret=site["secret"]))
    return out


class Resources:
    """Samples the machine every minute and posts every few minutes."""

    def __init__(self, config, reader=read_text):
        self.config = config
        self.reader = reader
        self.sites = resources_sites(config)
        # minute (ISO) -> row, so a minute sampled twice is kept once.
        self.rows = {}
        self.lock = threading.Lock()
        self.thread = None
        self.enabled = True
        self.post_every = RESOURCES_POST_EVERY
        # The disk-usage job, told what each answer says ("scan now", the
        # module's switch); main() sets it.
        self.disk = None
        self.last_cpu = cpu_fields(reader("/proc/stat"))
        self.last_disk = disk_counters(reader("/proc/diskstats"))
        self.last_net = net_counters(reader("/proc/net/dev"))
        self.last_limits = limits_counters(reader)
        self.last_at = time.time()
        self.next_sample = self.last_at + RESOURCES_SAMPLE_EVERY
        self.next_post = self.last_at + RESOURCES_POST_EVERY

    def sample(self):
        """Takes one sample, covering the time since the last one."""
        now = time.time()
        cpu = cpu_fields(self.reader("/proc/stat"))
        disk = disk_counters(self.reader("/proc/diskstats"))
        net = net_counters(self.reader("/proc/net/dev"))
        counters = limits_counters(self.reader)
        seconds = now - self.last_at
        percent = cpu_percent(
            None if self.last_cpu is None else cpu_times_of(self.last_cpu),
            None if cpu is None else cpu_times_of(cpu),
        )
        extra = dict(cpu_shares(self.last_cpu, cpu))
        if self.last_disk and disk:
            extra["disk_read_mbs"] = rate_mbs(self.last_disk[0], disk[0], seconds)
            extra["disk_write_mbs"] = rate_mbs(self.last_disk[1], disk[1], seconds)
        if self.last_net and net:
            extra["net_rx_mbs"] = rate_mbs(self.last_net[0], net[0], seconds)
            extra["net_tx_mbs"] = rate_mbs(self.last_net[1], net[1], seconds)
        # The limits pass (resources.md, "Limits"): the machine's half of it.
        extra.update(limits_fields(self.last_limits, counters, self.reader))
        row = resource_sample(self.last_at, percent, reader=self.reader, extra=extra)
        self.last_cpu, self.last_disk, self.last_net, self.last_at = cpu, disk, net, now
        self.last_limits = counters
        with self.lock:
            if not self.enabled:
                # Off in the dashboard: only the newest minute is kept, as the
                # one row that asks the collector now and then if it is back on.
                self.rows.clear()
            self.rows[row["minute"]] = row
            # Oldest first out: a long outage keeps the recent minutes.
            while len(self.rows) > RESOURCES_MAX_ROWS:
                del self.rows[min(self.rows)]
        return row

    def post(self):
        """Sends what's buffered to every site on this server. Rows are kept
        only when the collector couldn't take them and retrying may work."""
        with self.lock:
            rows = [self.rows[m] for m in sorted(self.rows)]
        if not rows:
            return True
        keep = False
        for site in self.sites:
            body = {"site_id": site["site_id"], "server_name": socket.gethostname()[:100],
                    "runtime": "agent %s" % VERSION, "rows": rows}
            status, _, raw = request(site, "POST", "/events/resources", body=body)
            if status in (200, 202):
                try:
                    answer = json.loads(raw or b"{}")
                except ValueError:
                    answer = {}
                if not isinstance(answer, dict):
                    answer = {}
                if self.disk is not None:
                    self.disk.answered(site["site_id"], answer)
                self.post_every = max(60, int(answer.get("every") or RESOURCES_POST_EVERY))
                if answer.get("enabled") is False:
                    if self.enabled:
                        log("server resources are off in the dashboard (Security → Server package)")
                    self.enabled = False
                else:
                    self.enabled = True
            elif status == 0 or status >= 500:
                # Unreachable or storage down: these rows are still good.
                keep = True
            else:
                # 4xx: resending won't make them acceptable.
                log("collector answered %s to the resources report" % status)
        if not keep:
            with self.lock:
                for minute in [m for m in self.rows if m <= rows[-1]["minute"]]:
                    del self.rows[minute]
        return not keep

    def tick(self, now=None):
        """Called often; samples and posts when due. Cheap when neither is."""
        now = now or time.time()
        if now >= self.next_sample:
            self.next_sample = now + RESOURCES_SAMPLE_EVERY
            try:
                self.sample()
            except Exception as error:
                log("resource sample failed:", error)
        if now >= self.next_post:
            every = self.post_every if self.enabled else max(600, self.post_every)
            self.next_post = now + every
            try:
                if not self.post():
                    self.next_post = now + RETRY
            except Exception as error:
                log("resources report failed:", error)
                self.next_post = now + RETRY

    def start(self):
        if self.thread and self.thread.is_alive():
            return

        def work():
            while not stopping:
                self.tick()
                time.sleep(1)

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


# ---- What fills the disks (sdk/protocols/disk-usage.md, POST /events/disk-usage)
#
# resources says a disk is 87% full; this says what fills it: so many GB of
# Docker images, of rotated logs, a log nobody rotates, a deleted file a
# process still holds open, and which of it can go. Every few hours, on a
# thread of its own, a fixed list of places (plus "disk_scan_paths" from this
# file, never anything from the dashboard, which can only ask for the same scan
# sooner) is measured and posted to every site on the server.
#
# Only looking: folder listings and lstat sizes, never a file's contents, but
# for the three settings files that say what cleans up (logrotate's,
# journald's and Docker's daemon.json). Nothing is deleted, truncated or
# changed: the dashboard shows the commands and a person runs them.
#
# The walk runs in a child process (`analytics-agent disk-scan`) at nice 19,
# in ionice's idle class and under a memory cap, and is killed past
# disk_scan_timeout: a folder of ten million files costs that child its time
# limit, never the agent its firewall or its samples. `docker system df` runs
# in the parent instead, before the child: Docker's Go client aborts under the
# child's memory cap (it reserves far more address space than it uses).
DISK_SCAN_EVERY = 3 * 3600
DISK_SCAN_MIN_EVERY = 600
DISK_SCAN_FIRST = 300  # after the agent starts: not in the middle of a boot
DISK_SCAN_TIMEOUT = 300
# "Scan now" waits this long after the last scan: the dashboard allows a click
# every 10 minutes, and two clicks must not mean two scans back to back.
DISK_SCAN_NOW_GAP = 600
DISK_RETRY = 300
DISK_RETRY_FOR = 3600
# The walk's bounds (disk-usage.md, "Bounded"). Past either the scan is
# partial and every figure is a floor, never a guess.
DISK_ENTRIES = 1000000
DISK_LINKS = 200000
DISK_FDS = 500000  # /proc/<pid>/fd links looked at
# A breath every so many entries, so the walk never holds the disk for long
# even in the idle class (which a busy disk on some schedulers ignores).
DISK_PAUSE_EVERY = 2000
DISK_PAUSE = 0.005
DISK_MEMORY = 768 * 1024 * 1024
# The child's answer is a few hundred entries at most: anything this big is a
# fault, not a report.
DISK_OUT_BYTES = 2 * 1024 * 1024
DISK_ERR_BYTES = 2000
DISK_DOCKER_TIMEOUT = 60
DISK_PLACES_MAX = 60
DISK_NOTES_MAX = 100
DISK_FILES_MAX = 20
DISK_DELETED_MAX = 20
GB = 1024 ** 3
DISK_BIG_LOG = GB
DISK_BIG_LOGS = 3
DISK_JOURNAL_KEEP = 500 * 1024 * 1024  # what `journalctl --vacuum-size=500M` keeps
DISK_USER_CACHE_MIN = 100 * 1024 * 1024
DISK_PG_WAL_MIN = 2 * GB
DISK_OLD_TEMP = 10 * 86400
DISK_OLD_BACKUP = 30 * 86400
DOCKER_DAEMON_JSON = "/etc/docker/daemon.json"
DOCKER_DATA_ROOT = "/var/lib/docker"
# What `docker system df` calls each kind, and the note its reclaimable size is.
DOCKER_DF_NOTES = {"Images": "docker_unused_images", "Containers": "docker_stopped_containers",
                   "Build Cache": "docker_build_cache"}
# Docker prints sizes in decimal units (go-units' HumanSize): 1 GB is 10^9.
DOCKER_UNITS = {"B": 1, "KB": 1000, "MB": 1000 ** 2, "GB": 1000 ** 3, "TB": 1000 ** 4, "PB": 1000 ** 5}
DOCKER_SIZE = re.compile(r"^\s*([0-9]+(?:\.[0-9]+)?)\s*([kKMGTP]?B)\b")
PACKAGE_CACHES = (("/var/cache/apt", "apt"), ("/var/cache/dnf", "dnf"), ("/var/cache/yum", "yum"),
                  ("/var/cache/pacman", "pacman"), ("/var/cache/zypp", "zypper"), ("/var/cache/apk", "apk"))
# The developer tools' caches in a home, and whose they are. ~/.cache is
# everyone's, so only its pip and yarn folders count as a tool's; its
# composer folder is a place of its own.
HOME_CACHES = ((".npm", "npm"), (".cache", ""), (".composer/cache", "composer"), (".cache/composer", "composer"),
               (".yarn/cache", "yarn"))
HOME_CACHE_SUBDIRS = {"pip": "pip", "yarn": "yarn"}
DISK_PLACE_LIST = (
    ("logs", ("/var/log",)),
    ("journal", ("/var/log/journal", "/run/log/journal")),
    ("containers", ("/var/lib/containerd", "/var/lib/containers")),
    ("temp", ("/tmp", "/var/tmp")),
    ("backups", ("/var/backups", "/backup", "/backups", "/root/backups", "/home/*/backups", "/var/www/*/backups")),
    ("crash", ("/var/crash", "/var/lib/systemd/coredump")),
    ("snaps", ("/var/lib/snapd/snaps",)),
    ("databases", ("/var/lib/mysql", "/var/lib/postgresql", "/var/lib/pgsql", "/var/lib/mongodb",
                   "/var/lib/clickhouse", "/var/lib/redis")),
    ("websites", ("/var/www", "/srv")),
)
# The order places are walked in. Where each file counts doesn't depend on it
# (the deepest place does), but what a partial scan has measured does: the
# small, telling places first, the ones that can hold millions of files last.
DISK_WALK_ORDER = ("logs", "journal", "packages", "caches", "temp", "backups", "crash", "snaps", "databases",
                   "docker_logs", "docker_build", "docker_volumes", "docker_images", "containers", "websites", "custom")
JOURNAL_ARCHIVED = re.compile(r"(?:@.*\.journal|\.journal~)$")
MYSQL_BINLOG = re.compile(r"^(?:binlog|[A-Za-z0-9_.-]*-bin)\.[0-9]{6,}$")
SNAP_FILE = re.compile(r"^([a-z0-9][a-z0-9_-]*?)_(x?[0-9]+)\.snap$")
LOGROTATE_TOKEN = re.compile(r'"[^"]*"|\'[^\']*\'|[{}]|[^\s{}"\']+')
LOGROTATE_SCRIPTS = ("postrotate", "prerotate", "firstaction", "lastaction", "preremove")
JOURNALD_CONFS = ("/etc/systemd/journald.conf", "/etc/systemd/journald.conf.d/*.conf",
                  "/run/systemd/journald.conf.d/*.conf", "/usr/lib/systemd/journald.conf.d/*.conf")


def printable(text, limit):
    """Up to `limit` printable characters of `text`: a name read from the
    disk can hold anything, and the protocol caps every one."""
    return "".join(c for c in str(text or "") if c.isprintable())[:limit]


def named(path):
    """`path` when it can be sent, else None. A name that isn't UTF-8 reaches
    Python as lone surrogates, which no JSON reader on the other side takes:
    its bytes still count toward its place, it just isn't named."""
    try:
        path.encode("utf-8")
    except UnicodeEncodeError:
        return None
    return path


def docker_size(text):
    """Bytes from Docker's "1.2GB (50%)" or "412.6MB", or None."""
    match = DOCKER_SIZE.match(text or "")
    if not match:
        return None
    return int(float(match.group(1)) * DOCKER_UNITS[match.group(2).upper()])


def docker_df(text):
    """{note code: reclaimable bytes} from `docker system df --format '{{json .}}'`."""
    out = {}
    for line in (text or "").splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        code = DOCKER_DF_NOTES.get(row.get("Type")) if isinstance(row, dict) else None
        size = docker_size(row.get("Reclaimable")) if code else None
        if size is not None:
            out[code] = size
    return out


def docker_reclaimable():
    """What Docker itself calls reclaimable, or None without Docker or an
    answer. Read-only: `docker system df` only counts."""
    if not shutil.which("docker"):
        return None
    try:
        done = subprocess.run(["docker", "system", "df", "--format", "{{json .}}"], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, universal_newlines=True, timeout=DISK_DOCKER_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    return docker_df(done.stdout) if done.returncode == 0 else None


def docker_daemon(path=DOCKER_DAEMON_JSON):
    """daemon.json as a dict: {} when there is none, None when it can't be
    read (then nothing is said about its log limit: Docker wouldn't start
    with it either)."""
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "rb") as f:
            value = json.loads(f.read(1024 * 1024).decode("utf-8", "replace"))
    except (OSError, ValueError):
        return None
    return value if isinstance(value, dict) else None


def docker_data_root(daemon):
    root = (daemon or {}).get("data-root") or (daemon or {}).get("graph")
    return os.path.normpath(root) if isinstance(root, str) and root.startswith("/") else DOCKER_DATA_ROOT


def docker_log_limit(daemon):
    """Whether container logs stop growing by themselves: a max-size for the
    json-file driver, or another driver (local rotates on its own, journald and
    syslog write elsewhere)."""
    driver = daemon.get("log-driver") or "json-file"
    opts = daemon.get("log-opts") if isinstance(daemon.get("log-opts"), dict) else {}
    return driver != "json-file" or bool(str(opts.get("max-size") or "").strip())


def logrotate_paths(text):
    """The path patterns a logrotate file's rules name: the tokens before each
    rule's `{`, quoted or not, globs left as they are. A line that starts with
    a directive (`include /etc/logrotate.d`, `weekly`) names no file, and the
    scripts inside a rule are shell, whose braces aren't logrotate's."""
    out, pending, depth, script = [], [], 0, False
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if script:
            script = line.split()[0] != "endscript"
            continue
        first = True
        for token in LOGROTATE_TOKEN.findall(line):
            if token == "{":
                if depth == 0:
                    out.extend(pending)
                    pending = []
                depth += 1
            elif token == "}":
                depth = max(0, depth - 1)
            elif depth > 0:
                if first and token in LOGROTATE_SCRIPTS:
                    script = True
                    break
            else:
                value = token[1:-1] if token[:1] in "\"'" else token
                if value.startswith("/"):
                    pending.append(value)
                elif first:
                    pending = []
                    break
            first = False
    return out


def logrotate_patterns():
    paths = ["/etc/logrotate.conf"] + sorted(glob.glob("/etc/logrotate.d/*"))
    out = []
    for path in paths:
        if os.path.isfile(path):
            out.extend(logrotate_paths(read_text(path, 1024 * 1024)))
    return out


def rotated_by(path, patterns):
    """Whether one of logrotate's patterns names `path`. Matched a folder at a
    time, as glob(3) does: `/var/log/*.log` doesn't reach into
    /var/log/nginx/, though fnmatch's `*` alone would."""
    parts = path.split("/")
    for pattern in patterns:
        pieces = pattern.split("/")
        if len(pieces) == len(parts) and all(fnmatch.fnmatchcase(a, b) for a, b in zip(parts, pieces)):
            return True
    return False


def journald_limit(patterns=JOURNALD_CONFS):
    """Whether journald is told how much disk it may use (SystemMaxUse), in
    its file or a drop-in. Without it journald takes up to 10% of the disk, at
    most 4 GB, which on a small disk is a lot."""
    for pattern in patterns:
        for path in sorted(glob.glob(pattern)) if "*" in pattern else [pattern]:
            for line in read_text(path).splitlines():
                line = line.strip()
                if not line or line[0] in "#;":
                    continue
                key, _, value = line.partition("=")
                if key.strip() == "SystemMaxUse" and value.strip():
                    return True
    return False


def journal_vacuum(files, keep=DISK_JOURNAL_KEEP):
    """Bytes `journalctl --vacuum-size` would remove from these archived
    journal files [(mtime, bytes)]: the oldest go until what's left fits, so
    the newest that fit stay and everything older than the first that doesn't
    is counted."""
    kept, gone, full = 0, 0, False
    for _, size in sorted(files, reverse=True):
        if not full and kept + size <= keep:
            kept += size
        else:
            full = True
            gone += size
    return gone


def crash_program(name):
    """The program a crash dump is from, guessed from its name: apport's
    `_usr_bin_foo.0.crash` (the path with / as _, then the user's ID), and
    systemd-coredump's and the kernel's `core.foo.…`."""
    if name.endswith(".crash"):
        stem = re.sub(r"\.[0-9]+$", "", name[:-len(".crash")])
        program = stem.rsplit("_", 1)[-1]
    elif name.startswith("core."):
        program = name.split(".")[1]
    else:
        return ""
    return printable(program, 40)


def cgroup_owner(text):
    """(systemd unit, 12-character container ID) of a process from its
    /proc/<pid>/cgroup, either "" when it isn't in one. v2 is the "0::" line;
    on v1 the name=systemd tree says the same. The paths are the ones
    cgroup_dirs builds for the other direction: system.slice/<unit>,
    docker-<id>.scope, docker/<id>, and the other runtimes' scopes."""
    path = None
    for line in (text or "").splitlines():
        parts = line.split(":", 2)
        if len(parts) != 3:
            continue
        if parts[0] == "0" and parts[1] == "":
            path = parts[2]
            break
        if parts[1] == "name=systemd" or (path is None and "memory" in parts[1].split(",")):
            path = parts[2]
    unit, container = "", ""
    parts = (path or "").split("/")
    for i, part in enumerate(parts):
        match = CONTAINER_CGROUP.match(part)
        if match:
            container = match.group(1)[:12]
        elif CONTAINER_FULL_ID.match(part):
            container = part[:12]
        # Only a system service, directly under system.slice: what the
        # dashboard offers to restart. A process in a login (user.slice,
        # user@1000.service and the user's own units below it) is a person's
        # session, which a restart would end, and `systemctl restart` can't
        # reach a user's units anyway.
        elif part.endswith(".service") and UNIT_NAME.match(part) and i > 0 and parts[i - 1] == "system.slice":
            unit = part
    return unit, container


def mount_table(text):
    """[(device, mount point, fstype, options)] of every mount in
    /proc/mounts, in the order mounted, so of two on one point the later is
    the one seen."""
    out = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 3:
            out.append((fields[0], fields[1].replace("\\040", " "), fields[2], fields[3] if len(fields) > 3 else ""))
    return out


def disk_places(extra=(), data_root=DOCKER_DATA_ROOT):
    """Every place the scan may measure, as {place, path} plus what its notes
    need. The fixed list of disk-usage.md, "Places", then the config's own
    paths; a path that doesn't exist here is dropped later, by the scan."""
    out = []
    for kind, paths in DISK_PLACE_LIST:
        for pattern in paths:
            for path in sorted(glob.glob(pattern)) if "*" in pattern else [pattern]:
                entry = {"place": kind, "path": path}
                if path == "/var/lib/mysql":
                    entry["role"] = "mysql"
                elif path in ("/var/lib/postgresql", "/var/lib/pgsql"):
                    entry["role"] = "postgres"
                out.append(entry)
    for path, tool in PACKAGE_CACHES:
        out.append({"place": "packages", "path": path, "tool": tool})
    for name, place in (("", "docker_images"), ("volumes", "docker_volumes"), ("containers", "docker_logs"),
                        ("buildkit", "docker_build")):
        out.append({"place": place, "path": os.path.join(data_root, name) if name else data_root})
    homes = ["/root"] + sorted(h for h in glob.glob("/home/*") if os.path.isdir(h) and not os.path.islink(h))
    for home in homes:
        user = printable(os.path.basename(home), 32)
        for rel, tool in HOME_CACHES:
            out.append({"place": "caches", "path": os.path.join(home, rel), "tool": tool, "user": user})
    for path in extra:
        out.append({"place": "custom", "path": path})
    return out


def disk_scan_paths(value):
    """disk_scan_paths from the config: absolute paths only, anything else
    left out (a relative path would depend on where the agent was started)."""
    out = []
    for path in value if isinstance(value, list) else []:
        if isinstance(path, str) and path.startswith("/") and "\0" not in path:
            out.append(os.path.normpath(path))
    return out


class DiskScan:
    """One scan, in the child process: walks the places, finds the deleted
    files still open, and returns the report's figures (with every name; the
    parent decides which site may see which)."""

    def __init__(self, places, mounts_text, reported, docker=None, daemon=None, docker_installed=False,
                 budget=DISK_SCAN_TIMEOUT, proc="/proc", now=None):
        self.started = time.time() if now is None else now
        self.deadline = time.time() + budget
        self.table = mount_table(mounts_text)
        self.points = {m for _, m, _, _ in self.table}
        self.reported = set(reported)
        # A reported disk's device, for a path whose own mount point is that
        # disk mounted again (a bind mount, a btrfs subvolume).
        self.devices = {d: m for d, m, _, _ in self.table if m in self.reported and d.startswith("/")}
        self.candidates = places
        self.docker = docker
        self.daemon = daemon
        self.docker_installed = docker_installed
        self.proc = proc
        self.partial = False
        self.stop = False
        self.entries = 0
        self.links = set()
        self.biggest = []  # heap of (bytes, n, path, place, mount, mtime)
        self.places = []
        self.roots = set()
        self.notes = collections.defaultdict(lambda: {"bytes": 0, "files": 0})
        self.big_logs, self.docker_logs, self.journal = [], [], collections.defaultdict(list)
        self.crash_names = collections.defaultdict(collections.Counter)
        self.pg_wal = collections.defaultdict(int)
        self.user_caches = collections.defaultdict(int)

    def mount_of(self, path):
        """The reported disk `path` is on, or None: the deepest mount point
        holding it, which must be a reported disk or that disk's device
        mounted again. A place on tmpfs, a network mount or a small disk is
        on none of them."""
        best = None
        for device, mount, fstype, _ in self.table:
            if path == mount or path.startswith(mount.rstrip("/") + "/"):
                if best is None or len(mount) >= len(best[1]):
                    best = (device, mount, fstype)
        if best is None:
            return None, None
        if best[1] in self.reported:
            return best[1], best[2]
        mount = self.devices.get(best[0])
        return (mount, best[2]) if mount else (None, None)

    def prepare(self):
        """The places that exist on a reported disk, each once: two listed
        paths that are the same folder (a symlink, a bind mount) are measured
        as the first."""
        order = {kind: i for i, kind in enumerate(DISK_WALK_ORDER)}
        for entry in self.candidates:
            try:
                real = os.path.realpath(entry["path"])
                if not os.path.isdir(real) or real in self.roots:
                    continue
            except (OSError, ValueError):
                continue
            mount, fstype = self.mount_of(real)
            if not mount:
                continue
            self.roots.add(real)
            self.places.append(dict(entry, real=real, mount=mount, fstype=fstype, bytes=0, files=0, walked=False))
        self.places.sort(key=lambda p: order.get(p["place"], len(order)))

    def shown(self, place, path):
        """The path as a person knows it: under the place's listed path, not
        the folder a symlink led to."""
        if place["real"] != place["path"]:
            path = place["path"].rstrip("/") + path[len(place["real"].rstrip("/")):]
        return named(path)

    def walk(self, place):
        """Adds up one place: os.scandir and lstat, never through a symlink,
        never into another mount point (or another device, but for btrfs,
        whose subvolumes are the same disk under devices of their own), and
        never into a deeper place, which counts its own files."""
        root = place["real"]
        try:
            st = os.lstat(root)
        except OSError:
            return
        place["walked"] = True
        place["bytes"] += st.st_blocks * 512
        dev, any_dev = st.st_dev, place["fstype"] == "btrfs"
        hook = getattr(self, "saw_" + place.get("role", place["place"]), None)
        stack = [root]
        while stack and not self.stop:
            folder = stack.pop()
            try:
                listing = os.scandir(folder)
            except OSError:
                continue
            with listing:
                for entry in listing:
                    self.entries += 1
                    if self.entries % DISK_PAUSE_EVERY == 0:
                        time.sleep(DISK_PAUSE)
                        if time.time() > self.deadline:
                            self.partial = self.stop = True
                    if self.entries > DISK_ENTRIES:
                        self.partial = self.stop = True
                    if self.stop:
                        break
                    try:
                        st = entry.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if st.st_dev != dev and not any_dev:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        path = entry.path
                        if path in self.roots or path in self.points:
                            continue
                        place["bytes"] += st.st_blocks * 512
                        stack.append(path)
                        continue
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    if st.st_nlink > 1:
                        key = (st.st_dev, st.st_ino)
                        if key in self.links:
                            continue
                        if len(self.links) >= DISK_LINKS:
                            # Can't tell this one from a copy already counted:
                            # left out, so every figure stays a floor.
                            self.partial = True
                            continue
                        self.links.add(key)
                    size = st.st_blocks * 512
                    place["bytes"] += size
                    place["files"] += 1
                    if len(self.biggest) < DISK_FILES_MAX or size > self.biggest[0][0]:
                        path = self.shown(place, entry.path)
                        if path:
                            item = (size, self.entries, path, place["place"], place["mount"], st.st_mtime)
                            if len(self.biggest) < DISK_FILES_MAX:
                                heapq.heappush(self.biggest, item)
                            else:
                                heapq.heapreplace(self.biggest, item)
                    if hook:
                        hook(place, folder, entry, st, size)

    # What a file means for the notes, by its place (disk-usage.md, "Notes").

    def saw_logs(self, place, folder, entry, st, size):
        # The access logs' own test of a rotated copy: the protocol's
        # suffixes, plus Caddy's access-2026-11-03T16-20-01.000.log.
        if ROTATED_LOG.search(entry.name):
            note = self.notes[(place["mount"], "rotated_logs")]
            note["bytes"] += size
            note["files"] += 1
        elif size > DISK_BIG_LOG:
            path = self.shown(place, entry.path)
            if path:
                self.big_logs.append((size, path, place["mount"]))

    def saw_journal(self, place, folder, entry, st, size):
        if JOURNAL_ARCHIVED.search(entry.name):
            self.journal[place["mount"]].append((st.st_mtime, size))

    def saw_temp(self, place, folder, entry, st, size):
        if self.started - st.st_mtime > DISK_OLD_TEMP:
            note = self.notes[(place["mount"], "old_temp")]
            note["bytes"] += size
            note["files"] += 1

    def saw_backups(self, place, folder, entry, st, size):
        if self.started - st.st_mtime > DISK_OLD_BACKUP:
            note = self.notes[(place["mount"], "old_backups")]
            note["bytes"] += size
            note["files"] += 1

    def saw_crash(self, place, folder, entry, st, size):
        note = self.notes[(place["mount"], "crash_dumps")]
        note["bytes"] += size
        note["files"] += 1
        program = crash_program(entry.name)
        if program:
            self.crash_names[place["mount"]][program] += size

    def saw_docker_logs(self, place, folder, entry, st, size):
        if entry.name.endswith("-json.log") and size > DISK_BIG_LOG:
            container = os.path.basename(folder)
            value = container[:12] if CONTAINER_FULL_ID.match(container) else printable(entry.name[:-len("-json.log")], 100)
            self.docker_logs.append((size, value, place["mount"]))

    def saw_mysql(self, place, folder, entry, st, size):
        if folder == place["real"] and MYSQL_BINLOG.match(entry.name):
            note = self.notes[(place["mount"], "mysql_binlogs")]
            note["bytes"] += size
            note["files"] += 1

    def saw_postgres(self, place, folder, entry, st, size):
        at = entry.path.find("/pg_wal/")
        if at >= 0:
            self.pg_wal[(place["mount"], entry.path[:at + len("/pg_wal")])] += size

    def saw_caches(self, place, folder, entry, st, size):
        tool = place.get("tool")
        if not tool:
            # ~/.cache: only its pip and yarn folders are a tool's.
            sub = entry.path[len(place["real"]) + 1:].split("/", 1)
            tool = HOME_CACHE_SUBDIRS.get(sub[0]) if len(sub) > 1 else None
        if tool:
            self.user_caches[(place["mount"], place.get("user", ""), tool)] += size

    def disk_devices(self):
        """{st_dev: reported disk} for every mount whose files are on one: the
        disk itself, the same device mounted again, and each overlay (a
        container's root) under the disk its upperdir is on. A deleted file is
        placed by its device, never by its name: a memfd's "/memfd:x" and a
        container's own paths look like the host's and aren't."""
        out = {}
        for device, mount, fstype, options in self.table:
            disk = mount if mount in self.reported else self.devices.get(device)
            if not disk and fstype == "overlay":
                upper = next((o[len("upperdir="):] for o in options.split(",") if o.startswith("upperdir=")), "")
                disk = self.mount_of(upper)[0] if upper.startswith("/") else None
            if disk:
                try:
                    out.setdefault(os.stat(mount).st_dev, disk)
                except OSError:
                    pass
        return out

    def deleted_files(self):
        """Deleted files a process still holds open (disk-usage.md, "Deleted
        files still open"): every /proc/<pid>/fd link ending " (deleted)" to a
        regular file no folder holds any more (no links left) on a reported
        disk, each once however many hold it, named by its first holder."""
        found, looked, devices = {}, 0, self.disk_devices()
        try:
            pids = sorted((int(p) for p in os.listdir(self.proc) if p.isdigit()))
        except OSError:
            return []
        for pid in pids:
            fd_dir = os.path.join(self.proc, str(pid), "fd")
            try:
                fds = os.listdir(fd_dir)
            except OSError:
                continue
            for fd in fds:
                looked += 1
                if looked > DISK_FDS:
                    self.partial = True
                    return self.deleted_list(found)
                link = os.path.join(fd_dir, fd)
                try:
                    target = os.readlink(link)
                    if not target.endswith(" (deleted)") or not target.startswith("/"):
                        continue
                    st = os.stat(link)
                except OSError:
                    continue
                if not stat.S_ISREG(st.st_mode) or st.st_nlink or (st.st_dev, st.st_ino) in found:
                    continue
                path = named(target[:-len(" (deleted)")])
                mount = devices.get(st.st_dev)
                size = st.st_blocks * 512
                if not mount or not path or not size:
                    continue
                unit, container = cgroup_owner(read_text(os.path.join(self.proc, str(pid), "cgroup"), 16384))
                found[(st.st_dev, st.st_ino)] = {
                    "mount": mount, "path": path, "bytes": size,
                    "process": printable(read_text(os.path.join(self.proc, str(pid), "comm"), 256).strip(), 32),
                    "pid": pid, "fd": int(fd) if fd.isdigit() else 0, "unit": unit, "container_id": container}
        return self.deleted_list(found)

    def deleted_list(self, found):
        everything = sorted(found.values(), key=lambda d: -d["bytes"])
        for item in everything:
            note = self.notes[(item["mount"], "open_deleted")]
            note["bytes"] += item["bytes"]
            note["files"] += 1
        return everything[:DISK_DELETED_MAX]

    def snap_notes(self):
        """Disabled snap revisions: a snap file whose revision isn't the one
        /snap/<name>/current points at."""
        out = []
        for place in self.places:
            if place["place"] != "snaps":
                continue
            try:
                entries = list(os.scandir(place["real"]))
            except OSError:
                continue
            for entry in entries:
                match = SNAP_FILE.match(entry.name)
                if not match:
                    continue
                try:
                    current = os.readlink(os.path.join("/snap", match.group(1), "current"))
                    size = entry.stat(follow_symlinks=False).st_blocks * 512
                except OSError:
                    continue
                if current != match.group(2) and entry.is_file(follow_symlinks=False):
                    out.append({"mount": place["mount"], "code": "snap_old", "value": printable(match.group(1), 100),
                                "revision": printable(match.group(2), 20), "bytes": size})
        return out

    def note_list(self):
        notes = []
        for (mount, code), note in sorted(self.notes.items()):
            row = {"mount": mount, "code": code, "bytes": note["bytes"], "files": note["files"]}
            if code == "crash_dumps":
                names = [n for n, _ in self.crash_names[mount].most_common(3)]
                if names:
                    row["value"] = ",".join(names)[:100]
            notes.append(row)
        patterns = logrotate_patterns() if self.big_logs else []
        for size, path, mount in sorted(self.big_logs, reverse=True)[:DISK_BIG_LOGS]:
            notes.append({"mount": mount, "code": "big_log", "path": path, "bytes": size,
                          "flag": rotated_by(path, patterns)})
        for mount, files in sorted(self.journal.items()):
            gone = journal_vacuum(files)
            if gone:
                notes.append({"mount": mount, "code": "journal_archived", "bytes": gone})
        journal = next((p for p in self.places if p["place"] == "journal"), None)
        if journal and not journald_limit():
            notes.append({"mount": journal["mount"], "code": "journal_no_limit"})
        docker = next((p for p in self.places if p["place"] == "docker_images"), None)
        if docker:
            for code, size in sorted((self.docker or {}).items()):
                if size:
                    notes.append({"mount": docker["mount"], "code": code, "bytes": size})
            if self.docker_installed and self.daemon is not None and not docker_log_limit(self.daemon):
                notes.append({"mount": docker["mount"], "code": "docker_no_log_limit"})
        for size, value, mount in sorted(self.docker_logs, reverse=True)[:DISK_BIG_LOGS]:
            notes.append({"mount": mount, "code": "docker_big_log", "value": value, "bytes": size})
        for place in self.places:
            if place["place"] == "packages" and place["bytes"]:
                notes.append({"mount": place["mount"], "code": "package_cache", "value": place["tool"],
                              "bytes": place["bytes"]})
        for (mount, user, tool), size in sorted(self.user_caches.items()):
            if size > DISK_USER_CACHE_MIN:
                notes.append({"mount": mount, "code": "user_cache", "value": tool, "user": user, "bytes": size})
        for (mount, _), size in sorted(self.pg_wal.items()):
            if size > DISK_PG_WAL_MIN:
                notes.append({"mount": mount, "code": "pg_wal", "bytes": size})
        notes.extend(self.snap_notes())
        return notes[:DISK_NOTES_MAX]

    def run(self):
        self.prepare()
        for place in self.places:
            if self.stop:
                break
            self.walk(place)
        deleted = self.deleted_files()
        walked = sorted((p for p in self.places if p["walked"]), key=lambda p: -p["bytes"])[:DISK_PLACES_MAX]
        places = [{"mount": p["mount"], "place": p["place"], "path": p["path"], "bytes": p["bytes"], "files": p["files"]}
                  for p in sorted(walked, key=lambda p: (p["mount"], -p["bytes"]))]
        files = [{"mount": mount, "place": place, "path": path, "bytes": size,
                  "age_days": max(0, int((self.started - mtime) // 86400))}
                 for size, _, path, place, mount, mtime in sorted(self.biggest, reverse=True)]
        return {"scanned_at": iso(int(self.started)), "took_s": round(time.time() - self.started, 1),
                "partial": self.partial, "places": places, "notes": self.note_list(), "files": files,
                "deleted": deleted}


def disk_scan_child():
    """`analytics-agent disk-scan`: what the agent runs as its child. Lowers
    itself first, before any work: nice 19, and the memory cap (the agent
    sets neither through preexec_fn, which isn't safe to run in a process with
    threads, as the agent is). Options come on stdin from the agent, never
    from the network; the report goes to stdout as one JSON object."""
    try:
        os.nice(19)
    except OSError:
        pass
    try:
        _, hard = resource.getrlimit(resource.RLIMIT_AS)
        cap = DISK_MEMORY if hard == resource.RLIM_INFINITY else min(DISK_MEMORY, hard)
        resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
    except (ValueError, OSError):
        pass
    options = {}
    if not sys.stdin.isatty():
        try:
            options = json.loads(sys.stdin.read(1024 * 1024) or "{}")
        except ValueError:
            options = {}
    daemon = docker_daemon()
    places = disk_places(disk_scan_paths(options.get("paths")), docker_data_root(daemon))
    scan = DiskScan(places, read_text("/proc/mounts", 4 * 1024 * 1024),
                    [d["mount"] for d in disk_rows(read_text("/proc/mounts"))],
                    docker=options.get("docker"), daemon=daemon,
                    docker_installed=bool(shutil.which("docker") or shutil.which("dockerd")),
                    budget=max(10, float(options.get("budget") or DISK_SCAN_TIMEOUT - 30)))
    sys.stdout.write(json.dumps(scan.run()))
    sys.stdout.flush()


def disk_child_args():
    args = [sys.executable or "python3", os.path.abspath(__file__), "disk-scan"]
    return (["ionice", "-c3"] + args) if shutil.which("ionice") else args


def run_disk_child(options, timeout, args=None):
    """(report, None) from a child process running the scan, or (None, why).
    The child is killed past `timeout` or when the agent stops, and what it
    prints is read up to DISK_OUT_BYTES. This thread waits on it; no other
    does."""
    try:
        proc = subprocess.Popen(args or disk_child_args(), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, close_fds=True)
    except OSError as error:
        return None, "could not start: %s" % error
    out, err, why = bytearray(), bytearray(), None
    deadline = time.time() + timeout
    try:
        try:
            proc.stdin.write(json.dumps(options).encode())
            proc.stdin.close()
        except OSError:
            pass
        streams = {proc.stdout.fileno(): out, proc.stderr.fileno(): err}
        while streams and not why:
            left = deadline - time.time()
            if left <= 0:
                why = "took longer than %ds and was stopped" % timeout
                break
            if stopping:
                why = "stopped with the agent"
                break
            ready, _, _ = select.select(list(streams), [], [], min(left, 1.0))
            for fd in ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    del streams[fd]
                elif streams[fd] is out:
                    if len(out) + len(chunk) > DISK_OUT_BYTES:
                        why = "answered more than %d bytes" % DISK_OUT_BYTES
                        break
                    out.extend(chunk)
                else:
                    err.extend(chunk[:max(0, DISK_ERR_BYTES - len(err))])
    finally:
        if why:
            proc.kill()
        try:
            code = proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            code = proc.wait()
        for stream in (proc.stdout, proc.stderr):
            stream.close()
    if why:
        return None, why
    if code != 0:
        tail = err.decode("utf-8", "replace").strip().splitlines()
        return None, "exited with %s%s" % (code, ": " + tail[-1][:300] if tail else "")
    try:
        report = json.loads(out.decode("utf-8"))
    except ValueError:
        return None, "answered something that isn't JSON"
    if not isinstance(report, dict) or not isinstance(report.get("places"), list):
        return None, "answered without places"
    return report, None


def disk_body(site, report, names):
    """One site's POST body. `names`: whether it may see file names (the
    main site, unless disk_scan_files is false), so files, deleted and a
    note's path go to it alone: the same machine is posted to every site on
    it, and on an agency's server those are different customers'."""
    notes = [n if names else {k: v for k, v in n.items() if k != "path"} for n in report.get("notes") or []]
    body = {"v": 1, "site_id": site["site_id"], "server_name": socket.gethostname()[:100],
            "client": "vps-agent/%s" % VERSION, "scanned_at": report["scanned_at"], "took_s": report.get("took_s"),
            "partial": bool(report.get("partial")), "places": report["places"][:DISK_PLACES_MAX],
            "notes": notes[:DISK_NOTES_MAX]}
    if names:
        body["files"] = (report.get("files") or [])[:DISK_FILES_MAX]
        body["deleted"] = (report.get("deleted") or [])[:DISK_DELETED_MAX]
    return body


class DiskUsage:
    """Scans every disk_scan_every seconds, and when the dashboard asks
    ("scan now", carried on the resources answer), and posts the report to
    every site; a report the collector couldn't take is sent again."""

    def __init__(self, config):
        self.config = config
        self.sites = resources_sites(config)
        try:
            every = int(config.get("disk_scan_every") or DISK_SCAN_EVERY)
        except (TypeError, ValueError):
            every = DISK_SCAN_EVERY
        self.every = max(DISK_SCAN_MIN_EVERY, every)
        try:
            self.timeout = max(30, int(config.get("disk_scan_timeout") or DISK_SCAN_TIMEOUT))
        except (TypeError, ValueError):
            self.timeout = DISK_SCAN_TIMEOUT
        self.paths = disk_scan_paths(config.get("disk_scan_paths"))
        self.names = config.get("disk_scan_files") is not False
        self.lock = threading.Lock()
        self.thread = None
        self.next_scan = time.time() + DISK_SCAN_FIRST
        self.last_done = None
        # site ID -> the last "scan now" ID it answered with; the first answer
        # after start only sets it, so a restart doesn't rescan an old click.
        self.requests = {}
        self.wanted = False
        # Sites whose last answer said the resources module is off.
        self.off = set()
        self.pending = []
        self.pending_since = 0
        self.retry_at = 0

    def answered(self, site_id, answer):
        """What a site's answer to the resources (or disk-usage) report says:
        whether the module is on, and whether someone pressed "Scan now"."""
        with self.lock:
            if answer.get("enabled") is False:
                self.off.add(site_id)
            else:
                self.off.discard(site_id)
            asked = answer.get("disk_scan")
            asked = asked if isinstance(asked, str) and 0 < len(asked) <= 64 else None
            if site_id not in self.requests:
                self.requests[site_id] = asked
            elif asked and asked != self.requests[site_id]:
                self.requests[site_id] = asked
                self.wanted = True

    def due(self, now):
        with self.lock:
            if all(site["site_id"] in self.off for site in self.sites):
                return False
            if now >= self.next_scan:
                return True
            return self.wanted and (self.last_done is None or now >= self.last_done + DISK_SCAN_NOW_GAP)

    def scan(self):
        """The report, or None (logged) when the child failed."""
        options = {"paths": self.paths, "docker": docker_reclaimable(),
                   "budget": max(10, min(self.timeout * 0.9, self.timeout - 20))}
        report, why = run_disk_child(options, self.timeout)
        if report is None:
            log("disk usage scan failed (%s); the next one is at the usual time" % why)
        return report

    def queue(self, report, now=None):
        with self.lock:
            off = set(self.off)
        self.pending = [(site, disk_body(site, report, self.names and i == 0))
                        for i, site in enumerate(self.sites) if site["site_id"] not in off]
        self.pending_since = time.time() if now is None else now

    def deliver(self, now=None):
        """Posts what's waiting to each site. Kept for another try in
        DISK_RETRY when the collector couldn't take it, for an hour at most;
        a 4xx won't change by resending."""
        now = time.time() if now is None else now
        keep = []
        for site, body in self.pending:
            status, _, raw = request(site, "POST", "/events/disk-usage", body=body)
            if status in (200, 202):
                try:
                    answer = json.loads(raw or b"{}")
                except ValueError:
                    answer = {}
                if not isinstance(answer, dict):
                    answer = {}
                if answer.get("enabled") is False and site["site_id"] not in self.off:
                    log("disk usage is off in the dashboard for %s (it follows Server resources)" % site["site_id"])
                with self.lock:
                    if answer.get("enabled") is False:
                        self.off.add(site["site_id"])
                    else:
                        self.off.discard(site["site_id"])
            elif status == 0 or status >= 500:
                keep.append((site, body))
            else:
                log("collector answered %s to the disk usage report" % status)
        if keep and now - self.pending_since >= DISK_RETRY_FOR:
            log("disk usage report dropped: the collector couldn't take it for an hour")
            keep = []
        self.pending = keep
        self.retry_at = now + DISK_RETRY
        return not keep

    def tick(self, now=None):
        """Called often; retries what's waiting and scans when due."""
        now = time.time() if now is None else now
        if self.pending and now >= self.retry_at:
            self.deliver(now)
        if not self.due(now):
            return
        self.next_scan = now + self.every
        with self.lock:
            self.wanted = False
        report = self.scan()
        self.last_done = time.time()
        if report is not None:
            # A newer report replaces one still waiting.
            self.queue(report, self.last_done)
            self.deliver(self.last_done)

    def start(self):
        if self.thread and self.thread.is_alive():
            return

        def work():
            while not stopping:
                try:
                    self.tick()
                except Exception as error:
                    log("disk usage round failed:", error)
                    self.next_scan = time.time() + self.every
                time.sleep(1)

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


def disk_command(config):
    """`analytics-agent disk`: one scan now, in the same child process the
    running agent uses, printed and reported."""
    job = DiskUsage(config)
    print("scanning (at most %ds)..." % job.timeout)
    report = job.scan()
    if report is None:
        sys.exit(1)
    print("scanned in %ss%s" % (report.get("took_s"), ", stopped early: every figure is at least" if report.get("partial") else ""))
    mounts = sorted({p["mount"] for p in report["places"]})
    for mount in mounts:
        print("disk %s" % mount)
        for place in [p for p in report["places"] if p["mount"] == mount]:
            print("  %-15s %10s  %8d files  %s" % (place["place"], _size(place["bytes"]), place["files"], place["path"]))
    if report.get("notes"):
        print("notes")
    for note in report.get("notes") or []:
        detail = " ".join(str(note[k]) for k in ("value", "user", "revision", "path") if note.get(k))
        if "files" in note:
            detail = ("%d files %s" % (note["files"], detail)).strip()
        if note.get("flag"):
            detail += " (a logrotate rule names it)"
        size = _size(note["bytes"]) if "bytes" in note else ""
        print("  %-26s %-4s %10s  %s" % (note["code"], note["mount"], size, detail))
    if report.get("files"):
        print("biggest files")
    for file in report.get("files") or []:
        print("  %10s  %5d days  %s" % (_size(file["bytes"]), file["age_days"], file["path"]))
    if report.get("deleted"):
        print("deleted, still open (the space comes back when the process closes them)")
    for item in report.get("deleted") or []:
        holder = " ".join(x for x in (item["unit"], item["container_id"] and "container " + item["container_id"]) if x)
        print("  %10s  %s  %s pid %d fd %d%s" % (_size(item["bytes"]), item["path"], item["process"], item["pid"], item["fd"],
                                               "  (%s)" % holder if holder else ""))
    job.queue(report)
    print("reported" if job.deliver() else "not reported, see above")


# ---- Whether its services run (sdk/protocols/services.md, POST /events/services)

# Every minute, on a thread of its own: does each service on this machine
# answer? The ones listed under "services" in the config (a port, an address,
# a systemd unit, a process name) and, unless "services_detect" is false, the
# common ones found here (systemd units of databases, queues, web servers and
# Docker, and Docker's containers). Health → All systems gives each a light.
#
# The list lives in this file on purpose, never in the dashboard: an address
# set from there would let anyone with dashboard access make this machine
# knock on its private network. Only reads: a TCP connect, one GET that
# follows no redirect and sends no secret, `systemctl show`, `docker ps`,
# `crictl ps` / `crictl pods`, Podman's containers.json, and /proc. Nothing runs through a shell, and a unit name is checked before it
# reaches systemctl.
#
# A found service is reported while it runs, and for SERVICES_KEEP_GONE after
# it last did (remembered in the state folder, so a restart doesn't forget a
# database that stopped): a service that stops is red, not missing. One
# removed altogether (a unit uninstalled, a container taken down) was removed
# on purpose, and goes at once.
SERVICES_EVERY = 60
SERVICES_TIMEOUT = 5
SERVICES_MAX = 50
SERVICES_KEEP_GONE = 7 * 24 * 3600
SERVICES_DETAIL_CHARS = 200
SERVICES_HTTP_BYTES = 64 * 1024
SERVICE_NAME = re.compile(r"[^A-Za-z0-9 ._@:/-]+")
UNIT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._:\\-]{0,127}$")
# The units worth a light when found: databases, caches, queues, web servers,
# PHP, Docker and pm2. Only .service units; postgresql.service is Debian's
# wrapper, "active" whatever its clusters do, so its instances are used.
DETECT_UNITS = re.compile(
    r"^(redis(-server)?|valkey(-server)?|postgresql@[\w.-]+|postgresql|mysql|mysqld|mariadb|mongod|"
    r"rabbitmq-server|clickhouse-server|memcached|elasticsearch|opensearch|nginx|apache2|httpd|caddy|"
    r"haproxy|php[\d.]*-fpm|docker|pm2-[\w.-]+|supervisor|supervisord)\.service$")
UNIT_UP = ("active", "reloading")
# The fields attach_usage adds to a result.
USAGE_KEYS = ("mem_mb", "mem_limit_mb", "cpu_pct", "oom_kills", "container_id")
UNIT_ENABLED = ("enabled", "enabled-runtime", "linked", "linked-runtime")
# The order found services are reported in, by the kind in their key.
FOUND_ORDER = {"unit": 0, "container": 1, "podman": 2, "podman-user": 3, "k8s": 4}


def clean_service_name(value):
    return SERVICE_NAME.sub("-", str(value or "")).strip(" -")[:80]


def service_list(entries):
    """The checks the config lists, each as {name, type, ...}. An entry that
    can't be one is logged and skipped rather than stopping the agent."""
    out, names = [], set()
    for entry in entries if isinstance(entries, list) else []:
        if not isinstance(entry, dict):
            log("services: %r isn't an object, skipped" % (entry,))
            continue
        check = None
        if "tcp" in entry:
            host, _, port = str(entry["tcp"]).rpartition(":")
            try:
                number = int(port)
            except ValueError:
                number = 0
            if 0 < number < 65536:
                check = {"type": "tcp", "host": host.strip("[]") or "127.0.0.1", "port": number,
                         "target": "%s:%d" % (host or "127.0.0.1", number)}
        elif "http" in entry:
            url = str(entry["http"])
            if re.match(r"^https?://[^\s]+$", url, re.I):
                check = {"type": "http", "url": url, "expect_ok": entry.get("expect_ok") is True, "target": shown_url(url)}
        elif "unit" in entry:
            unit = str(entry["unit"])
            unit = unit if "." in unit else unit + ".service"
            if UNIT_NAME.match(unit):
                check = {"type": "unit", "unit": unit, "target": unit}
        elif "process" in entry:
            proc = str(entry["process"])
            if proc and "/" not in proc and len(proc) <= 64:
                check = {"type": "process", "process": proc, "target": proc}
        if not check:
            log("services: %r needs one of tcp, http, unit or process, skipped" % (entry,))
            continue
        name = clean_service_name(entry.get("name") or check["target"])
        if not name or name.lower() in names:
            log("services: %r has no name or the same name as another, skipped" % (entry,))
            continue
        names.add(name.lower())
        check["name"] = name
        out.append(check)
    return out[:SERVICES_MAX]


def shown_url(url):
    """The address as the dashboard may show it: no user, password, query or
    fragment, any of which can carry a token."""
    try:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
        if ":" in host:
            host = "[%s]" % host
        return "%s://%s%s%s" % (parts.scheme.lower(), host, ":%d" % parts.port if parts.port else "", parts.path or "/")
    except ValueError:
        return "(an address)"


def check_tcp(host, port, timeout=SERVICES_TIMEOUT):
    """(ok, detail, ms) of connecting to host:port."""
    started = time.time()
    try:
        socket.create_connection((host, port), timeout=timeout).close()
    except socket.timeout:
        return False, "Not answering (timed out)", None
    except OSError as error:
        return False, (error.strerror or str(error))[:SERVICES_DETAIL_CHARS], None
    return True, "", int((time.time() - started) * 1000)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def check_http(url, expect_ok=False, timeout=SERVICES_TIMEOUT):
    """(ok, detail, ms) of one GET. Any 2xx or 3xx answer is up (a redirect is
    an answer, and isn't followed); with expect_ok the body must also be JSON
    with "ok": true, as a /health that knows its own parts says."""
    started = time.time()
    opener = urllib.request.build_opener(_NoRedirect)
    req = urllib.request.Request(url, headers={"User-Agent": "analytics-platform-agent/%s (service check)" % VERSION})
    try:
        with opener.open(req, timeout=timeout) as res:
            status, body = res.status, res.read(SERVICES_HTTP_BYTES)
    except urllib.error.HTTPError as error:
        status, body = error.code, b""
        if not 300 <= status < 400:
            return False, "Answered %d" % status, None
    except socket.timeout:
        return False, "Not answering (timed out)", None
    except Exception as error:
        reason = getattr(error, "reason", error)
        return False, ("Not reachable: %s" % reason)[:SERVICES_DETAIL_CHARS], None
    ms = int((time.time() - started) * 1000)
    if status >= 400:
        return False, "Answered %d" % status, ms
    if expect_ok and status < 300:
        try:
            ok = json.loads(body.decode("utf-8", "replace")).get("ok") is True
        except (ValueError, AttributeError):
            ok = False
        if not ok:
            return False, "Answered %d without \"ok\": true" % status, ms
    return True, "", ms


def running_processes(proc="/proc"):
    """The names of the processes running now: each one's comm and the base
    name of its first argument, from /proc. No command is run."""
    names = set()
    for pid in os.listdir(proc) if os.path.isdir(proc) else []:
        if not pid.isdigit():
            continue
        comm = read_text(os.path.join(proc, pid, "comm"), 256).strip()
        if comm:
            names.add(comm)
        argv0 = read_text(os.path.join(proc, pid, "cmdline"), 4096).split("\0")[0]
        if argv0:
            names.add(os.path.basename(argv0))
    return names


def parse_unit_show(text):
    """`systemctl show -p Id,ActiveState,SubState,UnitFileState,LoadState`'s
    blocks, by unit."""
    units, block = {}, {}
    for line in (text or "").splitlines() + [""]:
        if not line.strip():
            if block.get("Id"):
                units[block["Id"]] = block
            block = {}
            continue
        key, _, value = line.partition("=")
        block[key] = value
    return units


def parse_unit_list(text):
    """The loaded .service units in `systemctl list-units --all --plain
    --no-legend` that are worth a light."""
    found = []
    for line in (text or "").splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1] == "loaded" and DETECT_UNITS.match(parts[0]):
            found.append(parts[0])
    if any(u.startswith("postgresql@") for u in found):
        found = [u for u in found if u != "postgresql.service"]
    return sorted(found)


def parse_containers(text):
    """`docker ps -a --format '{{.Names}}\\t{{.State}}\\t{{.Status}}'`, as
    {name: (state, status)}."""
    out = {}
    for line in (text or "").splitlines():
        parts = line.split("\t")
        if len(parts) >= 3 and parts[0]:
            out[parts[0].split(",")[0][:80]] = (parts[1].strip().lower(), parts[2].strip())
    return out


def unit_result(unit, info):
    if not info or info.get("LoadState") == "not-found":
        return False, "No such unit"
    state = info.get("ActiveState") or "unknown"
    if state in UNIT_UP:
        return True, ""
    sub = info.get("SubState")
    return False, ("%s (%s)" % (state, sub) if sub and sub != state else state)[:SERVICES_DETAIL_CHARS]


def container_result(state, status):
    if state == "running" and "(unhealthy)" not in status:
        return True, ""
    return False, (status or state or "not running")[:SERVICES_DETAIL_CHARS]


def container_ids(text):
    """{name: full ID} from the same `docker ps` output, whose fourth column
    is {{.ID}}. An ID that isn't 64 hex characters is left out: it becomes
    part of a path below."""
    out = {}
    for line in (text or "").splitlines():
        parts = line.split("\t")
        if len(parts) >= 4 and parts[0] and CONTAINER_FULL_ID.match(parts[3].strip()):
            out[parts[0].split(",")[0][:80]] = parts[3].strip()
    return out


# ---- What each service uses (sdk/protocols/services.md, "Usage") ------------
#
# Every systemd unit and Docker container has a cgroup of its own, and the
# kernel keeps its memory, its CPU time and its out-of-memory kills there —
# what `docker stats` and `systemctl status` print, read from the files
# directly, with nothing installed in the container. The machine's figures
# (resources) say the box is at 80%; these say it is ClickHouse.
#
# Memory is the working set (current less inactive_file), as the server
# packages report a container's: page cache counts against a cgroup, and
# without the subtraction every container that reads files looks full. It
# still holds active cache, so the services can add up to more than the
# machine's "used", which counts all cache as available.
#
# CPU is a share of the whole machine, as the machine's own figure is, from
# two readings of the cgroup's CPU time; the first round has none. A kill
# here is one the app inside can't report, since it dies with it.
CGROUP_ROOT = "/sys/fs/cgroup"
CONTAINER_FULL_ID = re.compile(r"^[0-9a-f]{64}$")
# cgroup v1's "no limit" is the largest page-aligned 64-bit number.
CGROUP_NO_LIMIT = 2 ** 62
# A CPU pair further apart than this isn't this minute's average.
USAGE_MAX_PAIR_S = 300


# Where other runtimes put a container, found by walking the few slices they
# use rather than built from parts (a Kubernetes path holds the pod's UID and
# its QoS class, which nothing else here knows):
#   Podman, systemd manager   machine.slice/libpod-<id>.scope
#   Podman, rootless          user.slice/user-<uid>.slice/user@<uid>.service/user.slice/libpod-<id>.scope
#   Podman, cgroupfs manager  libpod_parent/libpod-<id>
#   Kubernetes, systemd       kubepods.slice/kubepods-<qos>.slice/kubepods-<qos>-pod<uid>.slice/<runtime>-<id>.scope
#   Kubernetes, cgroupfs      kubepods/<qos>/pod<uid>/<id>
# where <runtime> is cri-containerd, crio or docker (cri-dockerd), and a
# Guaranteed pod has no <qos> level. The conmon scopes beside them
# (libpod-conmon-<id>, crio-conmon-<id>) are the runtime's, not the app's.
CONTAINER_CGROUP = re.compile(r"^(?:docker|libpod|cri-containerd|crio|containerd)-([0-9a-f]{64})(?:\.scope)?$")
CGROUP_WALK_TOPS = ("kubepods.slice", "kubepods", "machine.slice", "libpod_parent", "user.slice")
CGROUP_WALK_DEPTH = 6
# A machine with thousands of user sessions still costs one bounded walk: at
# most this many entries looked at, files included. A user's own slice is
# delegated to them, so they can make cgroups there, but not a longer walk.
CGROUP_WALK_MAX = 200000


def container_cgroups(base, tops=CGROUP_WALK_TOPS):
    """{full container ID: its cgroup's path relative to `base`} for the
    containers under Podman's and Kubernetes' slices. Directories only, never
    through a symlink, CGROUP_WALK_DEPTH deep and CGROUP_WALK_MAX entries at
    most; an ID is matched in full, so nothing found can name a path outside
    the tree."""
    out, seen = {}, 0
    stack = [(top, 1) for top in reversed(tops)]
    while stack:
        rel, depth = stack.pop()
        try:
            with os.scandir(os.path.join(base, rel)) as entries:
                for entry in entries:
                    seen += 1
                    if seen > CGROUP_WALK_MAX:
                        return out
                    try:
                        if not entry.is_dir(follow_symlinks=False):
                            continue
                    except OSError:
                        continue
                    match = CONTAINER_CGROUP.match(entry.name)
                    found = match.group(1) if match else (entry.name if CONTAINER_FULL_ID.match(entry.name) else None)
                    if found:
                        out.setdefault(found, rel + "/" + entry.name)
                    elif depth < CGROUP_WALK_DEPTH:
                        stack.append((rel + "/" + entry.name, depth + 1))
        except OSError:
            continue
    return out


def cgroup_dirs(kind, target, root=None, isdir=os.path.isdir, index=None):
    """(memory dir, cpu dir, version) of a unit's or a container's own cgroup,
    or None. `target` is a unit name that passed UNIT_NAME or a full container
    ID, so neither can climb out of the cgroup tree. v2 is one tree; Docker's
    systemd driver puts a container in system.slice/docker-<id>.scope, its
    cgroupfs driver in docker/<id>, Podman in machine.slice/libpod-<id>.scope,
    and anywhere else (rootless Podman, Kubernetes) is found by
    container_cgroups. v1 has a tree per controller, the same paths in each.
    `index` is a dict the walks are kept in, so a round walks each tree once."""
    root = root or CGROUP_ROOT
    if kind == "unit":
        if not UNIT_NAME.match(target or "") or "/" in target:
            return None
        places = ["system.slice/" + target]
    elif kind == "container":
        if not CONTAINER_FULL_ID.match(target or ""):
            return None
        places = ["system.slice/docker-%s.scope" % target, "docker/" + target, "machine.slice/libpod-%s.scope" % target]
    else:
        return None
    cache = index if index is not None else {}

    def walked(base):
        if kind != "container":
            return None
        if base not in cache:
            cache[base] = container_cgroups(base)
        rel = cache[base].get(target)
        return rel if rel and isdir(os.path.join(base, rel)) else None

    if os.path.exists(os.path.join(root, "cgroup.controllers")):
        for place in places:
            path = os.path.join(root, place)
            if isdir(path):
                return path, path, 2
        rel = walked(root)
        return (os.path.join(root, rel),) * 2 + (2,) if rel else None
    cpu_trees = ("cpu,cpuacct", "cpuacct", "cpu")
    memory = next((os.path.join(root, "memory", p) for p in places if isdir(os.path.join(root, "memory", p))), None)
    cpu = next((os.path.join(root, tree, p) for tree in cpu_trees for p in places
                if isdir(os.path.join(root, tree, p))), None)
    if not memory and not cpu:
        rel = walked(os.path.join(root, "memory")) or walked(os.path.join(root, "cpu,cpuacct"))
        if rel:
            memory = os.path.join(root, "memory", rel) if isdir(os.path.join(root, "memory", rel)) else None
            cpu = next((os.path.join(root, tree, rel) for tree in cpu_trees if isdir(os.path.join(root, tree, rel))), None)
    return (memory, cpu, 1) if memory or cpu else None


# ---- Podman's and Kubernetes' containers ------------------------------------
#
# Found without running anything that could write: `podman ps` as root sets up
# its storage on a machine that never used it, and can't see a user's
# rootless containers anyway. Each storage's own containers.json says which
# containers exist and their names; a container runs while its libpod cgroup
# is there. So a stopped one is red ("Not running": no exit code without
# Podman's database) and a removed one goes at once. Podman's health checks
# aren't read: an unhealthy Podman container that runs is green.
#
# Kubernetes' containers come from `crictl ps -a -o json` (read-only, on the
# node wherever kubeadm or k3s put crictl), only on a machine with a kubepods
# cgroup. Named <namespace>/<pod>/<container>, the latest attempt of each:
# a container in CrashLoopBackOff is red while it waits, not missing.
PODMAN_STORAGE = "/var/lib/containers/storage"
PODMAN_STORAGE_CONF = "/etc/containers/storage.conf"
PODMAN_JSON_BYTES = 4 * 1024 * 1024
# containers.json files read per storage folder: one per driver (overlay, vfs,
# btrfs...) in practice, and a user's folder can't make root read thousands.
PODMAN_DRIVERS_MAX = 4
PODMAN_USER_SCOPE = re.compile(r"(?:^|/)user@(\d+)\.service/")
KUBE_STATES = {"CONTAINER_RUNNING": ("running", "Running"), "CONTAINER_EXITED": ("exited", "Exited"),
               "CONTAINER_CREATED": ("created", "Created")}


def read_regular(path, limit, owner=None):
    """A regular file's text, or None. Never a FIFO or a device, which a user's
    home could hold where a file is expected and whose read could hang. With
    `owner`, only a file that account owns: root reading a user's home must
    never be steered by a symlink or a hard link to a file the user couldn't
    read, so the file actually opened is checked, not its path."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOCTTY", 0))
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or (owner is not None and info.st_uid != owner):
            return None
        data = b""
        while len(data) < limit:
            chunk = os.read(fd, limit - len(data))
            if not chunk:
                break
            data += chunk
        return data.decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        os.close(fd)


def storage_setting(text, key):
    """`key = "value"` from a containers storage.conf, or None."""
    match = re.search(r'^[ \t]*%s[ \t]*=[ \t]*"([^"\n]+)"' % re.escape(key), text or "", re.M)
    return match.group(1) if match else None


def podman_root_storage(reader=read_regular):
    """Root's Podman storage folder: storage.conf's graphroot, or the default."""
    return storage_setting(reader(PODMAN_STORAGE_CONF, 65536), "graphroot") or PODMAN_STORAGE


def user_podman_storage(account, reader=read_regular):
    """A rootless user's storage folder: their own storage.conf's graphroot,
    the machine's rootless_storage_path, or ~/.local/share/containers/storage."""
    home = account.pw_dir
    own = reader(os.path.join(home, ".config/containers/storage.conf"), 65536, owner=account.pw_uid)
    path = storage_setting(own, "graphroot") \
        or storage_setting(reader(PODMAN_STORAGE_CONF, 65536), "rootless_storage_path")
    if path:
        path = path.replace("$HOME", home).replace("$UID", str(account.pw_uid)).replace("$USER", account.pw_name)
        if path.startswith("~/"):
            path = os.path.join(home, path[2:])
    if not path or "$" in path or not path.startswith("/"):
        path = os.path.join(home, ".local/share/containers/storage")
    return path


def podman_container(entry):
    """Whether a containers.json entry is Podman's own. The same storage
    holds CRI-O's (Kubernetes', named by crictl instead), whose metadata
    names a pod, and Buildah's working containers, which never run."""
    if not isinstance(entry, dict) or not CONTAINER_FULL_ID.match(str(entry.get("id") or "")):
        return False
    extra = entry.get("big-data-names")
    if isinstance(extra, list) and "buildah.json" in extra:
        return False
    try:
        meta = json.loads(entry.get("metadata") or "{}")
    except (TypeError, ValueError):
        meta = {}
    return not (isinstance(meta, dict) and ("pod-id" in meta or "pod-name" in meta))


def podman_containers(storage, reader=read_regular, owner=None):
    """{full ID: name} of the containers in a Podman storage folder's
    containers.json (one per storage driver), {} when there is none, None when
    one is there but can't be read (rewritten as we read it, or too big).
    With `owner` (a rootless user's storage), a file that account doesn't own
    is as good as none."""
    out = {}
    paths = sorted(glob.glob(os.path.join(glob.escape(storage), "*-containers", "containers.json")))
    for path in paths[:PODMAN_DRIVERS_MAX]:
        text = reader(path, PODMAN_JSON_BYTES, owner=owner)
        if text is None:
            continue
        try:
            entries = json.loads(text)
        except ValueError:
            return None
        for entry in entries if isinstance(entries, list) else []:
            if not podman_container(entry):
                continue
            names = entry.get("names")
            if isinstance(names, list) and names and isinstance(names[0], str) and names[0].strip():
                out.setdefault(entry["id"], names[0].strip()[:80])
    return out


def parse_crictl(text):
    """`crictl ps -a -o json` as {"<namespace>/<pod>/<container>": (state,
    status, full ID, pod sandbox ID)}, the latest attempt of each pod's
    container. None when it isn't crictl's JSON."""
    try:
        listed = json.loads(text or "").get("containers")
    except (ValueError, AttributeError):
        return None
    if not isinstance(listed, list):
        return None
    latest = {}
    for entry in listed:
        if not isinstance(entry, dict) or not CONTAINER_FULL_ID.match(str(entry.get("id") or "")):
            continue
        labels = entry.get("labels") if isinstance(entry.get("labels"), dict) else {}
        meta = entry.get("metadata") if isinstance(entry.get("metadata"), dict) else {}
        namespace = labels.get("io.kubernetes.pod.namespace")
        pod = labels.get("io.kubernetes.pod.name")
        name = labels.get("io.kubernetes.container.name") or meta.get("name")
        if not all(isinstance(v, str) and v for v in (namespace, pod, name)):
            continue
        label = "%s/%s/%s" % (namespace, pod, name)
        try:
            order = (int(meta.get("attempt") or 0), int(entry.get("createdAt") or 0))
        except (TypeError, ValueError):
            order = (0, 0)
        state, status = KUBE_STATES.get(entry.get("state"), ("unknown", "Unknown"))
        sandbox = entry.get("podSandboxId") if isinstance(entry.get("podSandboxId"), str) else ""
        if label not in latest or order > latest[label][0]:
            latest[label] = (order, (state, status, entry["id"], sandbox))
    return {label: found for label, (_, found) in latest.items()}


def parse_crictl_pods(text):
    """The IDs of the ready pod sandboxes in `crictl pods -o json`, or None
    when it isn't crictl's JSON."""
    try:
        items = json.loads(text or "").get("items")
    except (ValueError, AttributeError):
        return None
    if not isinstance(items, list):
        return None
    return {item["id"] for item in items
            if isinstance(item, dict) and isinstance(item.get("id"), str) and item.get("state") == "SANDBOX_READY"}


def has_kubepods(root=None):
    root = root or CGROUP_ROOT
    return any(os.path.isdir(os.path.join(root, *place)) for place in
               (("kubepods.slice",), ("kubepods",), ("memory", "kubepods.slice"), ("memory", "kubepods")))


def _cgroup_number(text):
    text = (text or "").strip()
    try:
        return int(text)
    except ValueError:
        return None


def _cgroup_pairs(text):
    out = {}
    for line in (text or "").splitlines():
        parts = line.split()
        if len(parts) == 2:
            value = _cgroup_number(parts[1])
            if value is not None:
                out[parts[0]] = value
    return out


def cgroup_reading(dirs, reader=read_text):
    """One reading of a cgroup: working-set and limit bytes, the kill count and
    CPU microseconds, each None where its file isn't there."""
    memory, cpu, version = dirs
    out = {"mem": None, "limit": None, "oom": None, "cpu_us": None}
    if memory and version == 2:
        current = _cgroup_number(reader(os.path.join(memory, "memory.current"), 64))
        if current is not None:
            out["mem"] = max(0, current - _cgroup_pairs(reader(os.path.join(memory, "memory.stat"))).get("inactive_file", 0))
        out["limit"] = _cgroup_number(reader(os.path.join(memory, "memory.max"), 64))
        out["oom"] = _cgroup_pairs(reader(os.path.join(memory, "memory.events"), 4096)).get("oom_kill")
    elif memory:
        usage = _cgroup_number(reader(os.path.join(memory, "memory.usage_in_bytes"), 64))
        if usage is not None:
            out["mem"] = max(0, usage - _cgroup_pairs(reader(os.path.join(memory, "memory.stat"))).get("total_inactive_file", 0))
        out["limit"] = _cgroup_number(reader(os.path.join(memory, "memory.limit_in_bytes"), 64))
        out["oom"] = _cgroup_pairs(reader(os.path.join(memory, "memory.oom_control"), 4096)).get("oom_kill")
    if cpu and version == 2:
        out["cpu_us"] = _cgroup_pairs(reader(os.path.join(cpu, "cpu.stat"), 4096)).get("usage_usec")
    elif cpu:
        ns = _cgroup_number(reader(os.path.join(cpu, "cpuacct.usage"), 64))
        out["cpu_us"] = ns // 1000 if ns is not None else None
    return out


def usage_fields(before, after, elapsed, cores, mem_total_mb):
    """The protocol's usage fields from two readings `elapsed` seconds apart
    (`before` None on the first). A limit at or above the machine's memory is
    no limit; a counter that went down was reset and says nothing."""
    MB = 1024 * 1024
    out = {}
    if after["mem"] is not None:
        out["mem_mb"] = after["mem"] // MB
    limit = after["limit"]
    if limit and 0 < limit < CGROUP_NO_LIMIT and not (mem_total_mb and limit // MB >= mem_total_mb):
        out["mem_limit_mb"] = limit // MB
    if before and cores and 1 <= elapsed <= USAGE_MAX_PAIR_S \
            and before["cpu_us"] is not None and after["cpu_us"] is not None and after["cpu_us"] >= before["cpu_us"]:
        share = 100.0 * (after["cpu_us"] - before["cpu_us"]) / (elapsed * 1e6 * cores)
        out["cpu_pct"] = round(min(100.0, share), 1)
    if before and before["oom"] is not None and after["oom"] is not None and after["oom"] >= before["oom"]:
        out["oom_kills"] = after["oom"] - before["oom"]
    return out


class Services:
    """Runs the checks every minute and reports them to every site on this
    server (the machine is the same for all of them, as with resources)."""

    def __init__(self, config):
        self.config = config
        self.sites = resources_sites(config)
        self.listed = service_list(config.get("services"))
        self.detect = config.get("services_detect") is not False
        self.state_file = os.path.join(config["state_dir"], "services.json")
        # name -> when it was last seen running, for the found ones.
        self.seen = {}
        # name -> (ok, since): how long each has been as it is now. Saved too:
        # a restart would otherwise make every stopped service newly stopped,
        # which brings back one the owner removed from the dashboard.
        self.since = {}
        # The users whose rootless Podman containers ran here: a user's stopped
        # container has no cgroup to find them by, and must still go red.
        self.podman_users = set()
        try:
            with open(self.state_file) as f:
                saved = json.load(f)
            self.seen = {k: float(v) for k, v in (saved.get("seen") or {}).items()}
            self.since = {k: (v[0] is True, float(v[1])) for k, v in (saved.get("since") or {}).items()}
            self.podman_users = {u for u in saved.get("podman_users") or [] if type(u) is int and u >= 0}
        except (OSError, ValueError, TypeError, AttributeError, IndexError):
            pass
        # name -> the last result, for a round whose read failed.
        self.last = {}
        # Container name -> full ID, from the last read of each kind that
        # answered (source_ids: kind -> {name: ID}), and "unit:<name>" /
        # "container:<id>" -> (when, cgroup reading), the previous round's,
        # for CPU and kills.
        self.container_ids = {}
        self.source_ids = {}
        self.usage_last = {}
        self.every = SERVICES_EVERY
        self.next_at = 0
        # Whether the last report had checks: an empty one is sent once, to clear them.
        self.reported = False
        self.thread = None

    def _save(self):
        try:
            fd, tmp = tempfile.mkstemp(dir=self.config["state_dir"])
            with os.fdopen(fd, "w") as f:
                json.dump({"seen": self.seen, "since": self.since, "podman_users": sorted(self.podman_users)}, f)
            os.replace(tmp, self.state_file)
        except OSError as error:
            log("could not save the services seen:", error)

    def found(self, now, present, read):
        """The found units and containers worth reporting, from `present`
        [(key, running, enabled)]: running now, or set to start at boot, or
        still there and seen running in the last SERVICES_KEEP_GONE. Keys are
        "unit:<name>" and "container:<name>"; `read` holds the kinds whose
        list was read, since only those can say something is gone."""
        keep, here = set(), set()
        for key, up, enabled in present:
            here.add(key)
            if up:
                self.seen[key] = now
            if up or enabled:
                keep.add(key)
        for key, at in list(self.seen.items()):
            gone = key.partition(":")[0] in read and key not in here
            if gone or now - at > SERVICES_KEEP_GONE:
                del self.seen[key]
            else:
                keep.add(key)
        # Units first, Kubernetes last: only SERVICES_MAX are sent, and a
        # node's dozens of pods mustn't push its database off the list.
        return sorted(keep, key=lambda key: (FOUND_ORDER.get(key.partition(":")[0], len(FOUND_ORDER)), key))

    def run_checks(self, now=None):
        """The results now, as the protocol's checks."""
        now = now or time.time()
        before = (dict(self.seen), dict(self.since), set(self.podman_users))
        has_systemctl, has_docker = shutil.which("systemctl"), shutil.which("docker")
        # A read that failed (systemd or Docker busy, timed out) says nothing:
        # what it would have said last time stands, rather than a red "gone".
        found_units, units_read = [], bool(has_systemctl)
        if self.detect and has_systemctl:
            code, out = _command(["systemctl", "list-units", "--type=service", "--all", "--plain", "--no-legend", "--no-pager"],
                                 timeout=SERVICES_TIMEOUT)
            found_units, units_read = (parse_unit_list(out), True) if code == 0 else ([], False)
        listed_units = [c["unit"] for c in self.listed if c["type"] == "unit"]
        wanted = sorted(set(found_units + listed_units))
        shown = {}
        if wanted and has_systemctl:
            code, out = _command(["systemctl", "show", "--no-pager", "-p", "Id,ActiveState,SubState,UnitFileState,LoadState", "--"]
                                 + wanted, timeout=SERVICES_TIMEOUT)
            shown, units_read = (parse_unit_show(out), True) if code == 0 else ({}, False)
        containers, containers_read = {}, bool(has_docker)
        if self.detect and has_docker:
            code, out = _command(["docker", "ps", "-a", "--no-trunc", "--format", "{{.Names}}\t{{.State}}\t{{.Status}}\t{{.ID}}"],
                                 timeout=SERVICES_TIMEOUT)
            containers, containers_read = (parse_containers(out), True) if code == 0 else ({}, False)
            if code == 0:
                self.source_ids["container"] = container_ids(out)
        # Each kind of container: its key prefix -> ({name: (state, status)},
        # whether it was read). Docker's keys keep the "container:" they had.
        sources = {"container": (containers, containers_read)}
        index = {}
        if self.detect:
            others, ids = self.other_containers(self.source_ids.get("container", {}), index)
            sources.update(others)
            self.source_ids.update(ids)
        self.container_ids = {}
        for kind in sources:
            for name, cid in self.source_ids.get(kind, {}).items():
                self.container_ids.setdefault(name, cid)

        results = []
        processes = running_processes() if any(c["type"] == "process" for c in self.listed) else set()
        for check in self.listed:
            if check["type"] == "tcp":
                ok, detail, ms = check_tcp(check["host"], check["port"])
            elif check["type"] == "http":
                ok, detail, ms = check_http(check["url"], check["expect_ok"])
            elif check["type"] == "unit":
                if not has_systemctl:
                    (ok, detail), ms = (False, "No systemd here"), None
                elif not units_read:
                    if check["name"] in self.last:
                        results.append(self.last[check["name"]])
                    continue
                else:
                    (ok, detail), ms = unit_result(check["unit"], shown.get(check["unit"])), None
            else:
                ok, ms = check["process"] in processes, None
                detail = "" if ok else "Not running"
            results.append({"name": check["name"], "type": check["type"], "target": check["target"][:200],
                            "ok": ok, "detail": detail, "ms": ms, "auto": False})

        if self.detect:
            taken = {r["name"].lower() for r in results} | {u.lower() for u in listed_units}
            present = [("unit:" + u, shown[u].get("ActiveState") in UNIT_UP, shown[u].get("UnitFileState") in UNIT_ENABLED)
                       for u in found_units if u in shown and u.lower() not in taken]
            for kind, (listed, _) in sources.items():
                present += [(kind + ":" + name, state == "running", False) for name, (state, _) in listed.items()]
            read = {"unit"} if units_read else set()
            read |= {kind for kind, (_, ok) in sources.items() if ok}
            for key in self.found(now, present, read):
                kind, _, name = key.partition(":")
                if kind == "unit":
                    label = clean_service_name(name[:-len(".service")] if name.endswith(".service") else name)
                    if name.lower() in taken:
                        continue
                    if not units_read:
                        result = self.last.get(label)
                    else:
                        ok, detail = unit_result(name, shown.get(name))
                        result = {"name": label, "type": "unit", "target": name, "ok": ok, "detail": detail, "ms": None, "auto": True}
                else:
                    label = clean_service_name(name)
                    listed, listed_read = sources.get(kind, ({}, False))
                    if not listed_read:
                        result = self.last.get(label)
                    elif name in listed:
                        ok, detail = container_result(*listed[name])
                        result = {"name": label, "type": "container", "target": name[:200], "ok": ok, "detail": detail,
                                  "ms": None, "auto": True}
                    else:
                        result = None
                if result:
                    results.append(result)

        out, names = [], set()
        for result in results:
            if not result["name"] or result["name"].lower() in names:
                continue
            names.add(result["name"].lower())
            was = self.since.get(result["name"])
            if not was or was[0] != result["ok"]:
                self.since[result["name"]] = (result["ok"], now)
            result["for_s"] = int(now - self.since[result["name"]][1])
            out.append(result)
        for name in [n for n in self.since if n not in names]:
            del self.since[name]
        if (self.seen, self.since, self.podman_users) != before:
            self._save()
        out = out[:SERVICES_MAX]
        self.attach_usage(out, now, index=index)
        self.last = {r["name"]: dict(r) for r in out}
        return out

    def other_containers(self, docker_ids, index, root=None):
        """Podman's (root's and rootless) and Kubernetes' containers, as
        {kind: ({name: (state, status)}, read)} and {kind: {name: full ID}}.
        One Docker already lists (podman-docker, cri-dockerd) stays Docker's.
        `index` keeps the cgroup walk for attach_usage, which needs it again."""
        root = root or CGROUP_ROOT
        sources, ids = {}, {}
        taken = set(docker_ids.values())
        # Kubernetes first: on a CRI-O node its containers sit in the same
        # storage as root's Podman ones, and are Kubernetes'.
        if has_kubepods(root) and shutil.which("crictl"):
            code, out = _command(["crictl", "ps", "-a", "-o", "json"], timeout=SERVICES_TIMEOUT)
            parsed = parse_crictl(out) if code == 0 else None
            if parsed is None:
                sources["k8s"] = ({}, False)
            else:
                kept = {label: found for label, found in parsed.items() if found[2] not in taken}
                if any(found[0] != "running" for found in kept.values()):
                    # A stopped container in a pod that is over (a Job that
                    # finished, a pod being deleted) is done, not down; one
                    # in a pod still up (CrashLoopBackOff) is red.
                    code, pods = _command(["crictl", "pods", "-o", "json"], timeout=SERVICES_TIMEOUT)
                    ready = parse_crictl_pods(pods) if code == 0 else None
                    if ready is not None:
                        kept = {label: found for label, found in kept.items() if found[0] == "running" or found[3] in ready}
                sources["k8s"] = ({label: found[:2] for label, found in kept.items()}, True)
                ids["k8s"] = {label: found[2] for label, found in kept.items()}
                taken |= {found[2] for found in parsed.values()}
        else:
            sources["k8s"], ids["k8s"] = ({}, True), {}
        if shutil.which("podman"):
            base = root if os.path.exists(os.path.join(root, "cgroup.controllers")) else os.path.join(root, "memory")
            if base not in index:
                index[base] = container_cgroups(base)
            scopes = {cid: rel for cid, rel in index[base].items() if os.path.basename(rel).startswith("libpod-")}
            for rel in scopes.values():
                match = PODMAN_USER_SCOPE.search(rel)
                if match:
                    self.podman_users.add(int(match.group(1)))

            def found_in(listed, label_of):
                found, named = {}, {}
                for cid, name in sorted(listed.items(), key=lambda item: item[1]):
                    label = label_of(name)
                    if cid in taken or label in found:
                        continue
                    found[label] = ("running", "Up") if cid in scopes else ("exited", "Not running")
                    named[label] = cid
                return found, named

            listed = podman_containers(podman_root_storage())
            if listed is None:
                sources["podman"] = ({}, False)
            else:
                found, ids["podman"] = found_in(listed, lambda name: name)
                sources["podman"] = (found, True)
            found, named, read = {}, {}, True
            for uid in sorted(self.podman_users):
                try:
                    account = pwd.getpwuid(uid)
                except KeyError:
                    self.podman_users.discard(uid)
                    continue
                listed = podman_containers(user_podman_storage(account), owner=account.pw_uid)
                if listed is None:
                    read = False
                    continue
                if not listed:
                    # Nothing of theirs left to go red.
                    self.podman_users.discard(uid)
                    continue
                more, more_ids = found_in(listed, lambda name, user=account.pw_name: "%s/%s" % (user, name))
                found.update(more)
                named.update(more_ids)
            sources["podman-user"] = (found, read)
            ids["podman-user"] = named
        else:
            # No Podman: nothing of it is here, so any remembered goes.
            sources["podman"] = sources["podman-user"] = ({}, True)
            ids["podman"] = ids["podman-user"] = {}
        return sources, ids

    def attach_usage(self, results, now, root=None, reader=read_text, index=None):
        """Adds what each unit and container uses (the protocol's "Usage") to
        its result, from its own cgroup. Read afresh every round, whether or
        not systemd and Docker answered: a result repeated from last time
        loses last time's figures first, so a stale reading is never sent."""
        cores = os.cpu_count()
        mem_total = memory_mb(reader("/proc/meminfo")).get("mem_total_mb")
        index = {} if index is None else index
        kept = {}
        for result in results:
            for key in USAGE_KEYS:
                result.pop(key, None)
            if result["type"] == "unit":
                key, target = "unit:" + result["target"], result["target"]
            elif result["type"] == "container":
                target = self.container_ids.get(result["target"])
                key = "container:%s" % target
                if target:
                    result["container_id"] = target[:12]
            else:
                continue
            dirs = cgroup_dirs(result["type"], target, root, index=index) if target else None
            if not dirs:
                continue
            after = cgroup_reading(dirs, reader)
            was = self.usage_last.get(key)
            result.update(usage_fields(was[1] if was else None, after, now - was[0] if was else 0, cores, mem_total))
            kept[key] = (now, after)
        # Only what still exists: a removed container's reading goes with it.
        self.usage_last = kept

    def post(self, checks):
        """Sends one round to every site. True when all of them took it."""
        all_ok = True
        for site in self.sites:
            body = {"v": PROTOCOL, "site_id": site["site_id"], "server_name": socket.gethostname()[:100],
                    "client": "vps-agent/%s" % VERSION, "checks": checks}
            status, _, raw = request(site, "POST", "/events/services", body=body)
            if status in (200, 202):
                try:
                    self.every = max(30, int(json.loads(raw or b"{}").get("every") or SERVICES_EVERY))
                except (ValueError, TypeError, AttributeError):
                    self.every = SERVICES_EVERY
            else:
                all_ok = False
                if status != 0:
                    log("collector answered %s to the services report" % status)
        return all_ok

    def tick(self, now=None):
        """Called often; checks and reports when due. Cheap when not."""
        now = now or time.time()
        if now < self.next_at:
            return
        self.next_at = now + self.every
        try:
            checks = self.run_checks(now)
            # Nothing to say about a machine with no services found or listed,
            # unless it had some before: an empty list clears them.
            if (checks or self.reported) and self.post(checks):
                self.reported = bool(checks)
        except Exception as error:
            log("services check failed:", error)
            self.next_at = now + RETRY

    def start(self):
        if self.thread and self.thread.is_alive():
            return

        def work():
            while not stopping:
                self.tick()
                time.sleep(1)

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


# ---- Databases and queues (sdk/protocols/databases.md, queues.md) ---------------

# Every minute, on a thread of its own: each database listed under "databases"
# in the config, as the database itself sees it (the statements that cost it
# the most time and the rows each read, the tables read end to end, how full
# it is), to POST /events/server-databases; and each RabbitMQ listed under
# "queues", its queues' backlog, to POST /events/server-queues. For Health →
# Server speed → Database and Jobs.
#
# Only reads, and only the databases' own statistics: never a setting
# changed, an extension installed or a profiler turned on. What a database
# can't give (pg_stat_statements not installed, the profiler off) is a note
# the dashboard explains, not a zero. The list lives in this file, never in
# the dashboard, as "services" does. A password given in a connection string
# reaches the client through its environment or a file only root can read,
# never its command line, which anyone on the machine can see in `ps`.
#
# Statements arrive already normalized by each database, but not always
# fully (PostgreSQL keeps the literals of a statement it can't parameterize,
# MongoDB's profiler keeps the values): every one goes through the same rule
# as the server packages' queries (sdk/protocols/queries.md) before it leaves,
# and the collector applies it again.
READINGS_EVERY = 60
READINGS_TIMEOUT = 8
READINGS_MAX = 20
DB_STATEMENTS = 100
DB_TABLES = 50
# Rows read from each database's statistics before the top ones are kept.
DB_READ_LIMIT = 1000
# Marks the agent's own queries, so they're left out of what it reports.
AGENT_MARK = "sitegoose-agent"
DB_KINDS = ("postgresql", "mysql", "clickhouse", "mongodb", "redis")

# The normalizer: a port of expresscollect/Analytics/queryText.js (as the
# Python package's queries.py has it). Every package's copy passes
# sdk/protocols/query-cases.json; so does this one (test_readings.py).
Q_MAX = 1000
Q_DATABASES = frozenset(("postgresql", "mysql", "mariadb", "sqlite", "mssql", "oracle", "clickhouse", "mongodb", "redis", "other"))
Q_SPACE = "\t\n\v\f\r                  　﻿"
Q_SPACES = frozenset(Q_SPACE)
Q_S = "[" + re.escape(Q_SPACE) + "]"
Q_WORD = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_$@:")
Q_DIGITS = frozenset("0123456789")
Q_NAME = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_")
Q_WORD_RUN = re.compile(r"[A-Za-z0-9_$@:]+")
Q_NUMBER = re.compile(r"0[xX][0-9a-fA-F]+|(?:[0-9]+\.?[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?")
Q_DOLLAR_TAG = re.compile(r"\$(?:[A-Za-z_][A-Za-z0-9_]*)?\$")
Q_PLACEHOLDER = r"(?:\?|\$[0-9]+|:[A-Za-z0-9_]+|@[A-Za-z0-9_]+)"
Q_LIST = re.compile(r"\(%s*%s(?:%s*,%s*%s)*%s*\)" % (Q_S, Q_PLACEHOLDER, Q_S, Q_S, Q_PLACEHOLDER, Q_S))
Q_ROWS = re.compile(r"\(\?\)(?:%s*,%s*\(\?\))+" % (Q_S, Q_S))
Q_MONGO = re.compile(r"([^%s]+)(?: ([^%s]+))?(?: (.*))?\Z" % (re.escape(Q_SPACE), re.escape(Q_SPACE)), re.S)
Q_INDEX_KEY = re.compile(r"(?:0|[1-9][0-9]*)\Z")
Q_LONE_SURROGATE = re.compile("[\ud800-\udfff]")
# Redis: the command, its subcommand and its first key's shape (queries.md, "Redis").
Q_REDIS_WORD = re.compile(r"[A-Za-z][A-Za-z0-9_.|-]{0,39}\Z")
Q_REDIS_SEGMENT = re.compile(r"[A-Za-z_]{1,32}\Z")
Q_REDIS_SPLIT = re.compile(Q_S + "+")
Q_REDIS_CONTAINERS = frozenset(("ACL", "CLIENT", "CLUSTER", "COMMAND", "CONFIG", "DEBUG", "FUNCTION", "LATENCY", "MEMORY", "MODULE",
                                "OBJECT", "PUBSUB", "SCRIPT", "SLOWLOG", "XGROUP", "XINFO"))
# Waiting, not working: a queue worker sits in these for seconds.
Q_REDIS_WAITING = frozenset(("BLPOP", "BRPOP", "BRPOPLPUSH", "BLMOVE", "BLMPOP", "BZPOPMIN", "BZPOPMAX", "BZMPOP", "WAIT", "WAITAOF",
                             "SUBSCRIBE", "PSUBSCRIBE", "SSUBSCRIBE", "UNSUBSCRIBE", "PUNSUBSCRIBE", "SUNSUBSCRIBE", "MONITOR"))
Q_REDIS_PREFIXES = frozenset(("PIPELINE", "MULTI"))
# ASCII only, as queryText.js: str.upper() would change other letters too.
Q_UPPER = {c: c - 32 for c in range(97, 123)}


def _q_quote_end(sql, start, quote, backslash=True):
    i, n = start + 1, len(sql)
    while i < n:
        c = sql[i]
        if c == "\\" and backslash:
            i += 2
        elif c == quote:
            if i + 1 < n and sql[i + 1] == quote:
                i += 2
            else:
                return i + 1
        else:
            i += 1
    return n


def _q_prefix(out):
    """The one-letter prefix written just before a string (E'..' N'..'), or ""."""
    piece = out[-1] if out else ""
    if not piece or piece[-1] not in "EeNnXxBb":
        return ""
    before = piece[-2] if len(piece) > 1 else (out[-2][-1] if len(out) > 1 else "")
    return "" if before and before in Q_NAME else piece[-1]


def _q_drop_prefix(out):
    if not _q_prefix(out):
        return
    piece = out[-1]
    if len(piece) > 1:
        out[-1] = piece[:-1]
    else:
        out.pop()


def _q_sql(sql, db, backslash_literal=None):
    mysql = db in ("mysql", "mariadb")
    postgres = db == "postgresql"
    # A backslash in a string is just a character on PostgreSQL (but E'..'),
    # SQLite, SQL Server and Oracle (queryText.js says why).
    literal = (postgres or db in ("sqlite", "mssql", "oracle")) if backslash_literal is None else backslash_literal
    out, last, n, i = [], "", len(sql), 0
    while i < n:
        c = sql[i]
        nxt = sql[i + 1] if i + 1 < n else ""
        prev = sql[i - 1] if i > 0 else ""
        if (c == "-" and nxt == "-") or (c == "#" and mysql):
            end = sql.find("\n", i)
            i = n if end == -1 else end
            if out and last != " ":
                out.append(" ")
                last = " "
        elif c == "/" and nxt == "*":
            end = sql.find("*/", i + 2)
            i = n if end == -1 else end + 2
            if out and last != " ":
                out.append(" ")
                last = " "
        elif c == "'" or (c == '"' and mysql):
            # Only PostgreSQL's E'..' escapes with a backslash where it is literal.
            escapes = not literal or (postgres and _q_prefix(out) in ("E", "e"))
            _q_drop_prefix(out)
            i = _q_quote_end(sql, i, c, escapes)
            out.append("?")
            last = "?"
        elif c == '"' or c == "`":
            end = _q_quote_end(sql, i, c, not literal)
            out.append(sql[i:end])
            last = sql[end - 1]
            i = end
        elif c == "$" and prev not in Q_WORD and Q_DOLLAR_TAG.match(sql[i:i + 64]):
            tag = Q_DOLLAR_TAG.match(sql[i:i + 64]).group(0)
            end = sql.find(tag, i + len(tag))
            i = n if end == -1 else end + len(tag)
            out.append("?")
            last = "?"
        elif (c in Q_DIGITS or (c == "." and nxt in Q_DIGITS)) and prev not in Q_WORD:
            i = Q_NUMBER.match(sql, i, i + 400).end()
            out.append("?")
            last = "?"
        elif c in Q_SPACES:
            i += 1
            if out and last != " ":
                out.append(" ")
                last = " "
        elif c in Q_WORD:
            end = Q_WORD_RUN.match(sql, i).end()
            out.append(sql[i:end])
            last = sql[end - 1]
            i = end
        else:
            out.append(c)
            last = c
            i += 1
    return Q_ROWS.sub("(?)", Q_LIST.sub("(?)", "".join(out))).strip(Q_SPACE)


class _QObject(list):
    """An object's entries in the order JavaScript writes them."""


def _q_index_key(key):
    return bool(Q_INDEX_KEY.match(key)) and int(key) < 4294967295


def _q_shape(value, depth=0):
    if depth >= 6 or not isinstance(value, (dict, list)):
        return "?"
    if isinstance(value, list):
        items = [_q_shape(item, depth + 1) for item in value]
        return [items[0]] if len({_q_json(item) for item in items}) == 1 else items
    keys = sorted((k for k in value if _q_index_key(k)), key=int) + [k for k in value if not _q_index_key(k)]
    return _QObject((k, _q_shape(value[k], depth + 1)) for k in keys)


def _q_json(value):
    if isinstance(value, _QObject):
        return "{" + ",".join(_q_json(k) + ":" + _q_json(v) for k, v in value) + "}"
    if isinstance(value, list):
        return "[" + ",".join(_q_json(item) for item in value) + "]"
    return Q_LONE_SURROGATE.sub(lambda m: "\\u%04x" % ord(m.group(0)), json.dumps(value, ensure_ascii=False))


def _q_no_constant(name):
    raise ValueError(name)


def _q_mongo(text):
    match = Q_MONGO.match(text.strip(Q_SPACE))
    if not match:
        return ""
    command, collection, rest = match.groups()
    if collection and any(ch in collection for ch in "{}[]\"'"):
        rest = collection if rest is None else collection + " " + rest
        collection = None
    shape = ""
    if rest:
        try:
            shape = _q_json(_q_shape(json.loads(rest, parse_constant=_q_no_constant)))
        except (ValueError, RecursionError):
            shape = ""
    return " ".join(part for part in (command, collection, shape) if part)


def redis_key_shape(key):
    """user:42:cart -> user:?:cart: each segment that isn't only letters and _ is ?."""
    if not isinstance(key, str) or key == "":
        return "?"
    return ":".join(part if part == "" or Q_REDIS_SEGMENT.match(part) else "?" for part in key.split(":"))


def _q_redis(text):
    """[PIPELINE|MULTI] COMMAND [SUBCOMMAND] [key]; anything more is (other)."""
    words = Q_REDIS_SPLIT.split(text.strip(Q_SPACE))
    if words[0] == "":
        return ""
    out, i = [], 0
    if words[0].translate(Q_UPPER) in Q_REDIS_PREFIXES and len(words) > 1:
        out.append(words[0].translate(Q_UPPER))
        i = 1
    if not Q_REDIS_WORD.match(words[i]):
        return "(other)"
    name = words[i].translate(Q_UPPER)
    i += 1
    if name in Q_REDIS_WAITING:
        return "(other)"
    out.append(name)
    if name in Q_REDIS_CONTAINERS and i < len(words) and Q_REDIS_WORD.match(words[i]):
        out.append(words[i].translate(Q_UPPER))
        i += 1
    if i < len(words) - 1:
        return "(other)"
    if i < len(words):
        out.append(redis_key_shape(words[i]))
    return " ".join(out)


def normalize_statement(text, db):
    """The statement with every value taken out, or "" when nothing is left.
    db: one of Q_DATABASES; anything else is "other"."""
    if not isinstance(text, str):
        return ""
    if text == "(other)":
        return text
    db = str(db or "").lower()
    db = db if db in Q_DATABASES else "other"
    if db == "mongodb":
        shaped = _q_mongo(text)
    elif db == "redis":
        shaped = _q_redis(text)
    elif db == "other" and "\\" in text:
        # An unknown database may or may not take a backslash as an escape;
        # where the two readings differ the text is left out, as (other).
        escaped = _q_sql(text, db, False)
        shaped = escaped if escaped == _q_sql(text, db, True) else "(other)"
    else:
        shaped = _q_sql(text, db)
    return shaped[:Q_MAX].strip(Q_SPACE) if len(shaped) > Q_MAX else shaped


def mongo_text(command, op=None, ns=None):
    """"find users {...}" from a profiled command, as the packages write a
    Mongo query (queries.md): the command, its collection and its filter.
    The profiler logs a single update or remove as the statement itself
    ({q, u, ...}), so its op and ns name the command and collection."""
    if not isinstance(command, dict) or not command:
        return ""
    if op in ("update", "remove") and "q" in command and op not in command and "delete" not in command:
        name, collection = ("delete" if op == "remove" else "update"), str(ns or "").partition(".")[2]
        if not collection:
            return name
        return mongo_text({name: collection, ("deletes" if name == "delete" else "updates"): [{"q": command.get("q")}]})
    name = next(iter(command))
    collection = command.get(name)
    if name == "find":
        found = command.get("filter")
    elif name == "aggregate":
        found = command.get("pipeline")
    elif name in ("count", "distinct", "findAndModify"):
        found = command.get("query")
    elif name in ("delete", "update"):
        items = command.get("deletes" if name == "delete" else "updates") or [{}]
        found = items[0].get("q") if isinstance(items, list) and items and isinstance(items[0], dict) else None
    else:
        found = None
    if not isinstance(collection, str) or not collection:
        return name
    text = "%s %s" % (name, collection)
    if found is not None:
        try:
            text += " " + json.dumps(found, separators=(",", ":"), ensure_ascii=False)
        except (TypeError, ValueError):
            pass
    return text


def _whole(value):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return int(round(number)) if number == number else None


def _number(value, places=1):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return round(number, places) if number == number else None


def clickhouse_memory_limit(info):
    """The memory ClickHouse lets itself use, in MB, as it works it out at
    start-up: max_server_memory_usage_to_ram_ratio (0.9) of the machine's
    memory, or of the container's when that is smaller, and a
    max_server_memory_usage set in its config only lowers that. None when
    neither could be read."""
    ram = _whole(info.get("ram")) or 0
    container = _whole(info.get("container_ram")) or 0
    if container and (not ram or container < ram):
        ram = container
    ceiling = ram * (_number(info.get("memory_ratio"), 3) or 0.9)
    setting = _whole(info.get("memory_setting")) or 0
    limit = min(setting, ceiling) if setting and ceiling else setting or ceiling
    return int(limit // 1048576) or None


def database_list(entries):
    """The databases the config lists, each {kind, target, name}: target is
    "local" or a connection string. An entry that can't be one is skipped."""
    out = []
    for entry in entries if isinstance(entries, list) else []:
        kind = next((k for k in DB_KINDS if isinstance(entry, dict) and isinstance(entry.get(k), str)), None)
        if not kind:
            # Only the entry's keys: its values may be passwords.
            log("databases: an entry with %s needs one of %s, skipped" % (_entry_keys(entry), ", ".join(DB_KINDS)))
            continue
        target = entry[kind].strip()
        if kind == "clickhouse" and not re.match(r"^https?://", target, re.I):
            log("databases: clickhouse needs its HTTP address (http://127.0.0.1:8123), skipped")
            continue
        if kind == "mongodb" and not re.match(r"^mongodb(\+srv)?://", target, re.I):
            log("databases: mongodb needs a connection string (mongodb://127.0.0.1:27017), skipped")
            continue
        if kind == "redis" and not redis_address(target):
            log("databases: redis needs \"local\", redis://host:port, rediss://host:port or unix:///path, skipped")
            continue
        out.append({"kind": kind, "target": target})
    return out[:READINGS_MAX]


def _entry_keys(entry):
    if isinstance(entry, dict):
        return ", ".join(sorted(str(k)[:40] for k in entry)) or "no keys"
    return "a %s" % type(entry).__name__


def queue_list(entries):
    out = []
    for entry in entries if isinstance(entries, list) else []:
        url = entry.get("rabbitmq") if isinstance(entry, dict) else None
        if not isinstance(url, str) or not re.match(r"^https?://", url.strip(), re.I):
            log("queues: an entry with %s needs \"rabbitmq\": its management address (http://user:pass@127.0.0.1:15672), skipped" % _entry_keys(entry))
            continue
        out.append({"kind": "rabbitmq", "target": url.strip()})
    return out[:READINGS_MAX]


def split_url(url):
    """(address without user or password, user, password, host:port)."""
    parts = urllib.parse.urlsplit(url)
    credentials, _, netloc = parts.netloc.rpartition("@")
    user, _, password = credentials.partition(":")
    clean = urllib.parse.urlunsplit((parts.scheme, netloc, parts.path, parts.query, ""))
    return (clean, urllib.parse.unquote(user), urllib.parse.unquote(password), netloc or "127.0.0.1")


def http_json(url, user="", password="", body=None, timeout=READINGS_TIMEOUT, lines=False):
    """GET (or POST body) url with basic auth: its JSON, or None on any failure."""
    headers = {"User-Agent": "analytics-platform-agent/%s" % VERSION}
    if user or password:
        headers["Authorization"] = "Basic " + base64.b64encode(("%s:%s" % (user, password)).encode()).decode()
    data = body.encode() if isinstance(body, str) else None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers), timeout=timeout) as res:
            raw = res.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as error:
        try:
            detail = error.read().decode("utf-8", "replace")[:300]
        except Exception:
            detail = ""
        return {"_error": error.code, "_detail": detail}
    except Exception as error:
        log("could not read %s:" % split_url(url)[3], error)
        return None
    try:
        return [json.loads(line) for line in raw.splitlines() if line.strip()] if lines else json.loads(raw)
    except ValueError:
        return None


def counter_deltas(previous, current):
    """{key: {field: now - before}} for keys read both times; a counter that
    went down (statistics reset, a restart) gives nothing for that key."""
    out = {}
    for key, now in current.items():
        before = previous.get(key)
        if before is None:
            continue
        delta = {}
        for field, value in now.items():
            if field.startswith("_"):
                continue
            old = before.get(field)
            if value is None or old is None:
                delta[field] = None
            elif value < old:
                delta = None
                break
            else:
                delta[field] = value - old
        if delta is not None:
            out[key] = delta
    return out


# Redis (and Valkey, KeyDB, Dragonfly): spoken to directly, in RESP2 over its
# socket, as no client may be installed. Only AUTH, INFO and SLOWLOG GET are
# sent: nothing that changes a setting or a key, not even CLIENT SETNAME.
REDIS_SOCKETS = ("/run/redis/redis-server.sock", "/var/run/redis/redis.sock")
REDIS_TIMEOUT = 5
REDIS_SLOWLOG = 128
# The most a reply may hold, all its strings together, before it's taken for
# something that isn't Redis.
REDIS_REPLY_MAX = 8 * 1048576
# Left out of the statements: commands that wait rather than work (as the
# packages leave them out, queryText.js REDIS_WAITING), and the agent's own.
REDIS_LEFT_OUT = Q_REDIS_WAITING | frozenset(("INFO", "SLOWLOG", "AUTH", "PING", "HELLO"))


class RedisError(Exception):
    """An error reply, by its code alone (NOPERM, NOAUTH, WRONGPASS...)."""


def redis_address(target):
    """How to reach a Redis: {"unix": path} or {"host", "port", "tls",
    "verify"}, with "instance" (never a user or password) and the user and
    password, which stay here. None when target can't be one."""
    if target == "local":
        for path in REDIS_SOCKETS:
            try:
                if stat.S_ISSOCK(os.stat(path).st_mode):
                    return {"unix": path, "instance": path, "user": "", "password": ""}
            except OSError:
                continue
        return {"host": "127.0.0.1", "port": 6379, "tls": False, "verify": True, "instance": "127.0.0.1:6379", "user": "", "password": ""}
    try:
        parts = urllib.parse.urlsplit(target)
        port = parts.port
    except ValueError:
        return None
    scheme = parts.scheme.lower()
    query = dict(urllib.parse.parse_qsl(parts.query))
    user, password = urllib.parse.unquote(parts.username or ""), urllib.parse.unquote(parts.password or "")
    if user and not password:
        # redis://secret@host: AUTH needs a password, so a lone one is it.
        user, password = "", user
    password = password or query.get("password", "")
    if scheme == "unix":
        if not parts.path.startswith("/"):
            return None
        return {"unix": parts.path, "instance": parts.path, "user": user, "password": password}
    if scheme not in ("redis", "rediss"):
        return None
    host = parts.hostname or "127.0.0.1"
    port = port or 6379
    return {"host": host, "port": port, "tls": scheme == "rediss",
            "verify": query.get("ssl_cert_reqs", "").lower() not in ("none", "cert_none"),
            "instance": ("[%s]:%d" if ":" in host else "%s:%d") % (host, port), "user": user, "password": password}


class RedisConnection:
    """One connection, RESP2: a command's reply, or RedisError for an error
    reply. Any other failure (refused, timed out, not Redis) is an OSError."""

    def __init__(self, address, timeout=REDIS_TIMEOUT, deadline=READINGS_TIMEOUT):
        # The whole reading's: a Redis that answers a byte at a time can't
        # hold up the other databases' readings past it.
        self.deadline = time.monotonic() + deadline
        self.timeout = timeout
        if "unix" in address:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            try:
                sock.connect(address["unix"])
            except OSError:
                sock.close()
                raise
        else:
            sock = socket.create_connection((address["host"], address["port"]), timeout=timeout)
            if address.get("tls"):
                context = ssl.create_default_context()
                if not address.get("verify", True):
                    context.check_hostname = False
                    context.verify_mode = ssl.CERT_NONE
                try:
                    sock = context.wrap_socket(sock, server_hostname=address["host"])
                except (OSError, ssl.SSLError):
                    sock.close()
                    raise
        self.sock = sock
        self.file = sock.makefile("rb")

    def call(self, *args):
        self.sock.settimeout(max(0.05, min(self.timeout, self.deadline - time.monotonic())))
        out = [b"*%d\r\n" % len(args)]
        for arg in args:
            data = arg if isinstance(arg, bytes) else str(arg).encode("utf-8")
            out.append(b"$%d\r\n%s\r\n" % (len(data), data))
        self.sock.sendall(b"".join(out))
        self.left = REDIS_REPLY_MAX
        return self._reply(0)

    def _reply(self, depth):
        if time.monotonic() > self.deadline:
            raise OSError("Redis took too long")
        line = self.file.readline(65538)
        if not line.endswith(b"\r\n"):
            raise OSError("not a Redis reply")
        kind, rest = line[:1], line[1:-2]
        if kind == b"+":
            return rest.decode("utf-8", "replace")
        if kind == b"-":
            raise RedisError(rest.decode("utf-8", "replace").split(" ", 1)[0][:40])
        try:
            number = int(rest)
        except ValueError:
            raise OSError("not a Redis reply")
        if kind == b":":
            return number
        if kind == b"$":
            if number < 0:
                return None
            self.left -= number
            if self.left < 0:
                raise OSError("a Redis reply too long")
            data = self.file.read(number + 2)
            if len(data) != number + 2:
                raise OSError("a Redis reply cut short")
            return data[:-2]
        if kind == b"*":
            if number < 0:
                return None
            self.left -= number
            if number > 100000 or depth > 4 or self.left < 0:
                raise OSError("a Redis reply too long")
            return [self._reply(depth + 1) for _ in range(number)]
        raise OSError("not a Redis reply")

    def close(self):
        for thing in (self.file, self.sock):
            try:
                thing.close()
            except OSError:
                pass


def redis_info(raw):
    """INFO's "field:value" lines as a dict."""
    text = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else str(raw or "")
    out = {}
    for line in text.splitlines():
        if line and not line.startswith("#"):
            key, sep, value = line.partition(":")
            if sep:
                out[key.strip()] = value.strip()
    return out


def redis_command_stats(info):
    """{statement: {calls, usec, errors}} from INFO commandstats: GET,
    CLIENT SETNAME (cmdstat_client|setname). errors is failed + rejected
    calls (Redis 6.2+), None before."""
    out = {}
    for key, value in info.items():
        if not key.startswith("cmdstat_"):
            continue
        name = key[8:].translate(Q_UPPER).replace("|", " ")
        if not name or name.split(" ")[0] in REDIS_LEFT_OUT:
            continue
        fields = {}
        for part in value.split(","):
            field, _, number = part.partition("=")
            fields[field] = number
        failed, rejected = _whole(fields.get("failed_calls")), _whole(fields.get("rejected_calls"))
        out[name] = {"calls": _whole(fields.get("calls")), "usec": _whole(fields.get("usec")),
                     "errors": None if failed is None and rejected is None else (failed or 0) + (rejected or 0)}
    return out


class DatabaseReader:
    """One database, read once a minute. Counters (pg_stat_statements,
    performance_schema) are cumulative, so each reading is kept to subtract
    from the next; ClickHouse's query log and MongoDB's profiler are read
    from where the last reading stopped. The first reading of each sends
    health and notes only."""

    def __init__(self, kind, target, state_dir):
        self.kind = kind
        self.target = target
        self.state_dir = state_dir
        self.previous = {}
        self.tables_before = {}
        # ClickHouse's query log: up to when it was read. MongoDB's profiler:
        # the same, per database.
        self.watermark = None
        # The cache's cumulative (hits, reads): PostgreSQL's blocks, InnoDB's
        # buffer pool requests and misses.
        self.blocks = None

    # -- Running the database's own client --

    def _pg_command(self, sql, database=None):
        """sql's one JSON value, parsed. database None: the address's own
        database (postgres locally); a name: exactly that one."""
        sql = "/* %s */ %s" % (AGENT_MARK, sql)
        base = ["psql", "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1"]
        env = dict(os.environ, PGAPPNAME=AGENT_MARK, PGCONNECT_TIMEOUT="5")
        if self.target == "local":
            # As the postgres account, by peer authentication, as its own tools are run.
            args = (["runuser", "-u", "postgres", "--"] if os.geteuid() == 0 else []) + base + ["-d", database or "postgres", "-c", sql]
        else:
            parts = urllib.parse.urlsplit(self.target)
            env.update({"PGHOST": parts.hostname or "127.0.0.1", "PGPORT": str(parts.port or 5432),
                        "PGUSER": urllib.parse.unquote(parts.username or ""), "PGPASSWORD": urllib.parse.unquote(parts.password or "")})
            for key, value in urllib.parse.parse_qsl(parts.query):
                if key == "sslmode":
                    env["PGSSLMODE"] = value
            args = base + ["-d", database or urllib.parse.unquote(parts.path.strip("/")) or "postgres", "-c", sql]
        code, out = _command(args, env=env, timeout=READINGS_TIMEOUT)
        if code != 0:
            return None
        try:
            return json.loads(out.strip() or "null")
        except ValueError:
            return None

    def _mysql_command(self, sql):
        """Each row of sql, which selects one JSON value per row, parsed."""
        sql = "/* %s */ %s" % (AGENT_MARK, sql)
        options = ["--batch", "--raw", "--skip-column-names", "--connect-timeout=5", "-e", sql]
        if self.target == "local":
            code, out = _command(["mysql"] + options, timeout=READINGS_TIMEOUT)
        else:
            parts = urllib.parse.urlsplit(self.target)
            # The password in a file only root can read, never on the command line.
            fd, path = tempfile.mkstemp(dir=self.state_dir, prefix="mysql-", suffix=".cnf")
            try:
                with os.fdopen(fd, "w") as f:
                    f.write("[client]\nhost=%s\nport=%d\nuser=%s\npassword=\"%s\"\n" % (
                        parts.hostname or "127.0.0.1", parts.port or 3306, urllib.parse.unquote(parts.username or ""),
                        urllib.parse.unquote(parts.password or "").replace("\\", "\\\\").replace('"', '\\"')))
                code, out = _command(["mysql", "--defaults-extra-file=" + path] + options, timeout=READINGS_TIMEOUT)
            finally:
                try:
                    os.unlink(path)
                except OSError:
                    pass
        if code != 0:
            return None
        rows = []
        for line in out.splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
        return rows

    def _clickhouse(self, sql):
        """Its rows, a dict carrying "_error" when ClickHouse refused, or None.
        No settings are sent: a user made read-only may not change any."""
        clean, user, password, _ = split_url(self.target)
        sql = "/* %s */ %s FORMAT JSONEachRow" % (AGENT_MARK, sql)
        return http_json(clean.split("?")[0].rstrip("/") + "/", user, password, body=sql, lines=True)

    def _mongo(self, script):
        """The JSON a mongosh script prints. The address reaches mongosh in its
        environment, so `ps` never shows a password."""
        env = dict(os.environ, SITEGOOSE_MONGO_URI=self.target)
        wrapped = ("const client = new Mongo(process.env.SITEGOOSE_MONGO_URI); const admin = client.getDB('admin');"
                   "print(EJSON.stringify((() => { " + script + " })(), { relaxed: true }));")
        code, out = _command(["mongosh", "--nodb", "--quiet", "--norc", "--eval", wrapped], env=env, timeout=READINGS_TIMEOUT)
        if code != 0:
            return None
        try:
            return json.loads(out.strip().splitlines()[-1])
        except (ValueError, IndexError):
            return None

    # -- Each database --

    def read_postgresql(self):
        info = self._pg_command("""SELECT json_build_object(
          'version', current_setting('server_version'), 'version_num', current_setting('server_version_num')::int,
          'port', current_setting('port'),
          'max_connections', current_setting('max_connections')::int,
          'connections', (SELECT count(*) FROM pg_stat_activity WHERE backend_type = 'client backend'),
          'running', (SELECT count(*) FROM pg_stat_activity WHERE backend_type = 'client backend' AND state = 'active' AND pid <> pg_backend_pid()),
          'waiting', (SELECT count(*) FROM pg_stat_activity WHERE wait_event_type = 'Lock'),
          -- A backup's dump is one long query by design, not a stuck one: left out
          -- of the longest, or every night's dump reads as "struggling".
          'longest_s', (SELECT COALESCE(max(EXTRACT(EPOCH FROM now() - query_start)), 0) FROM pg_stat_activity
                        WHERE backend_type = 'client backend' AND state = 'active' AND pid <> pg_backend_pid()
                          AND application_name NOT IN ('pg_dump', 'pg_dumpall')),
          'hit', (SELECT sum(blks_hit) FROM pg_stat_database), 'read', (SELECT sum(blks_read) FROM pg_stat_database),
          'databases', (SELECT json_agg(datname) FROM pg_database WHERE datallowconn AND NOT datistemplate),
          'statements', EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_stat_statements'),
          -- Without these, other users' sessions show no state: their work can't be counted.
          'sees_all', (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) OR pg_has_role(current_user, 'pg_read_all_stats', 'MEMBER'))""")
        if not isinstance(info, dict):
            return None
        reading = {"version": str(info.get("version") or "")[:32], "notes": [],
                   "instance": self._instance("5432", info.get("port"))}
        hit, read = _whole(info.get("hit")), _whole(info.get("read"))
        cache = None
        if self.blocks and hit is not None and read is not None and hit >= self.blocks[0] and read >= self.blocks[1]:
            touched = (hit - self.blocks[0]) + (read - self.blocks[1])
            cache = round(100.0 * (hit - self.blocks[0]) / touched, 1) if touched else None
        self.blocks = (hit, read) if hit is not None and read is not None else None
        sees = info.get("sees_all") is True
        reading["health"] = {"connections": _whole(info.get("connections")), "max_connections": _whole(info.get("max_connections")),
                             "running": _whole(info.get("running")) if sees else None, "waiting": _whole(info.get("waiting")) if sees else None,
                             "longest_s": _number(info.get("longest_s")) if sees else None, "cache_hit_pct": cache}
        statements = []
        if info.get("statements"):
            rows = self._pg_command("""SELECT COALESCE(json_agg(t), '[]') FROM (SELECT s.dbid::text || ':' || s.userid::text || ':' || s.queryid::text AS key, d.datname AS database,
                s.query AS statement, s.calls, s.%s AS total_ms, s.rows, s.shared_blks_hit + s.shared_blks_read AS blocks
              FROM pg_stat_statements s LEFT JOIN pg_database d ON d.oid = s.dbid
              WHERE s.queryid IS NOT NULL AND s.query NOT LIKE '%%%s%%' ORDER BY total_ms DESC LIMIT %d) t""" % (
                # total_time before PostgreSQL 13.
                "total_exec_time" if (_whole(info.get("version_num")) or 0) >= 130000 else "total_time", AGENT_MARK, DB_READ_LIMIT))
            current = {}
            if rows is None:
                # Listed but unreadable (not in shared_preload_libraries, or no access).
                reading["notes"].append("no_pg_stat_statements")
                current = self.previous
                rows = []
            for row in rows:
                current[row["key"]] = {"calls": _whole(row.get("calls")), "total_ms": _number(row.get("total_ms"), 3),
                                       "rows": _whole(row.get("rows")), "blocks": _whole(row.get("blocks")),
                                       "_database": row.get("database") or "", "_statement": row.get("statement") or ""}
            for key, delta in counter_deltas(self.previous, current).items():
                if not delta.get("calls"):
                    continue
                statements.append({"database": current[key]["_database"], "statement": current[key]["_statement"],
                                   "calls": delta["calls"], "errors": None, "total_ms": round(delta["total_ms"] or 0, 1),
                                   "rows_read": None, "rows_returned": delta.get("rows"),
                                   "bytes_read": None if delta.get("blocks") is None else delta["blocks"] * 8192,
                                   "peak_memory_mb": None, "no_index": None})
            self.previous = current
        else:
            reading["notes"].append("no_pg_stat_statements")
        # Tables, in every database (pg_stat_user_tables is per database).
        tables, now = [], {}
        for database in (info.get("databases") or [])[:READINGS_MAX]:
            rows = self._pg_command("""SELECT COALESCE(json_agg(t), '[]') FROM (SELECT schemaname || '.' || relname AS table, seq_scan, seq_tup_read,
                idx_scan, n_live_tup FROM pg_stat_user_tables WHERE seq_scan > 0 ORDER BY seq_tup_read DESC LIMIT 200) t""", database)
            if rows is None:
                # Unreadable this minute: its counters carry over, so the next reading still has a baseline.
                now.update((k, v) for k, v in self.tables_before.items() if k.startswith(database + "|"))
            for row in rows or []:
                now["%s|%s" % (database, row["table"])] = {"full_scans": _whole(row.get("seq_scan")), "rows_scanned": _whole(row.get("seq_tup_read")),
                                                          "index_scans": _whole(row.get("idx_scan")), "_rows": _whole(row.get("n_live_tup"))}
        for key, delta in counter_deltas(self.tables_before, now).items():
            if delta.get("full_scans"):
                database, _, table = key.partition("|")
                tables.append({"database": database, "table": table, "full_scans": delta["full_scans"],
                               "rows_scanned": delta.get("rows_scanned") or 0, "index_scans": delta.get("index_scans"), "rows": now[key]["_rows"]})
        self.tables_before = now
        reading["statements"], reading["tables"] = statements, tables
        return reading

    def read_mysql(self):
        info = self._mysql_command("""SELECT JSON_OBJECT('version', VERSION(), 'port', @@port, 'max_connections', @@max_connections,
            'schema', @@performance_schema,
            'running', (SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE COMMAND = 'Query' AND ID <> CONNECTION_ID()),
            'waiting', (SELECT COUNT(*) FROM information_schema.PROCESSLIST WHERE COMMAND = 'Query' AND STATE LIKE '%lock%'),
            -- mysqldump's reads carry SQL_NO_CACHE; a dump isn't a stuck query.
            'longest_s', (SELECT COALESCE(MAX(TIME), 0) FROM information_schema.PROCESSLIST WHERE COMMAND = 'Query' AND ID <> CONNECTION_ID()
              AND COALESCE(INFO, '') NOT LIKE '%SQL_NO_CACHE%'),
            -- Without PROCESS the list holds only this user's own threads.
            'sees_all', EXISTS (SELECT 1 FROM information_schema.USER_PRIVILEGES WHERE PRIVILEGE_TYPE IN ('PROCESS', 'SUPER')
              AND GRANTEE = CONCAT("'", SUBSTRING_INDEX(CURRENT_USER(), '@', 1), "'@'", SUBSTRING_INDEX(CURRENT_USER(), '@', -1), "'")))""")
        status = self._mysql_command("""SELECT JSON_OBJECTAGG(VARIABLE_NAME, VARIABLE_VALUE) FROM information_schema.GLOBAL_STATUS
            WHERE VARIABLE_NAME IN ('THREADS_CONNECTED', 'INNODB_BUFFER_POOL_READ_REQUESTS', 'INNODB_BUFFER_POOL_READS')""")
        if status is None or not any(status):
            # MySQL 8 keeps status in performance_schema; MariaDB in information_schema.
            status = self._mysql_command("""SELECT JSON_OBJECTAGG(UPPER(VARIABLE_NAME), VARIABLE_VALUE) FROM performance_schema.global_status
                WHERE VARIABLE_NAME IN ('Threads_connected', 'Innodb_buffer_pool_read_requests', 'Innodb_buffer_pool_reads')""")
        if not info or not isinstance(info[0], dict):
            return None
        info = info[0]
        status = {str(k).upper(): v for k, v in ((status or [{}])[0] or {}).items()}
        version = str(info.get("version") or "")
        reading = {"db": "mariadb" if "mariadb" in version.lower() else "mysql", "version": version[:32], "notes": [],
                   "instance": self._instance("3306", info.get("port"))}
        requests, misses = _whole(status.get("INNODB_BUFFER_POOL_READ_REQUESTS")), _whole(status.get("INNODB_BUFFER_POOL_READS"))
        cache = None
        if self.blocks and requests is not None and misses is not None and requests >= self.blocks[0] and misses >= self.blocks[1]:
            asked = requests - self.blocks[0]
            cache = round(100.0 * (asked - (misses - self.blocks[1])) / asked, 1) if asked else None
        self.blocks = (requests, misses) if requests is not None and misses is not None else None
        reading["health"] = {"connections": _whole(status.get("THREADS_CONNECTED")), "max_connections": _whole(info.get("max_connections")),
                             "cache_hit_pct": None if cache is None else max(0.0, cache)}
        sees = str(info.get("sees_all")) in ("1", "true", "True")
        for field, value in (("running", _whole(info.get("running"))), ("waiting", _whole(info.get("waiting"))),
                             ("longest_s", _number(info.get("longest_s")))):
            reading["health"][field] = value if sees else None
        statements, tables = [], []
        if str(info.get("schema")) in ("1", "ON", "True", "true"):
            rows = self._mysql_command("""SELECT JSON_OBJECT('key', CONCAT(IFNULL(SCHEMA_NAME, ''), ':', DIGEST), 'database', SCHEMA_NAME,
                'statement', DIGEST_TEXT, 'calls', COUNT_STAR, 'timer', SUM_TIMER_WAIT, 'errors', SUM_ERRORS,
                'examined', SUM_ROWS_EXAMINED, 'sent', SUM_ROWS_SENT, 'no_index', SUM_NO_INDEX_USED)
              FROM performance_schema.events_statements_summary_by_digest
              WHERE DIGEST_TEXT IS NOT NULL AND DIGEST_TEXT NOT LIKE '%%performance_schema%%' AND DIGEST_TEXT NOT LIKE '%%information_schema%%'
                AND DIGEST_TEXT NOT LIKE '%%%s%%'
              ORDER BY SUM_TIMER_WAIT DESC LIMIT %d""" % (AGENT_MARK, DB_READ_LIMIT))
            current = {}
            if rows is None:
                # On but unreadable (no SELECT on performance_schema): what was read last stays the baseline.
                reading["notes"].append("no_performance_schema")
                current = self.previous
            for row in rows or []:
                current[row["key"]] = {"calls": _whole(row.get("calls")), "timer": _whole(row.get("timer")), "errors": _whole(row.get("errors")),
                                       "examined": _whole(row.get("examined")), "sent": _whole(row.get("sent")), "no_index": _whole(row.get("no_index")),
                                       "_database": row.get("database") or "", "_statement": row.get("statement") or ""}
            for key, delta in counter_deltas(self.previous, current).items():
                if not delta.get("calls"):
                    continue
                statements.append({"database": current[key]["_database"], "statement": current[key]["_statement"], "calls": delta["calls"],
                                   "errors": delta.get("errors"),
                                   # Picoseconds.
                                   "total_ms": round((delta.get("timer") or 0) / 1e9, 1),
                                   "rows_read": delta.get("examined"), "rows_returned": delta.get("sent"), "bytes_read": None,
                                   "peak_memory_mb": None, "no_index": delta.get("no_index")})
            self.previous = current
            # Rows read with no index, per table: what a full scan reads.
            rows = self._mysql_command("""SELECT JSON_OBJECT('key', CONCAT(u.OBJECT_SCHEMA, '|', u.OBJECT_NAME), 'scanned', u.COUNT_READ,
                'rows', t.TABLE_ROWS)
              FROM performance_schema.table_io_waits_summary_by_index_usage u
              LEFT JOIN information_schema.TABLES t ON t.TABLE_SCHEMA = u.OBJECT_SCHEMA AND t.TABLE_NAME = u.OBJECT_NAME
              WHERE u.INDEX_NAME IS NULL AND u.COUNT_READ > 0
                AND u.OBJECT_SCHEMA NOT IN ('mysql', 'performance_schema', 'sys', 'information_schema')
              ORDER BY u.COUNT_READ DESC LIMIT 200""")
            now = {row["key"]: {"rows_scanned": _whole(row.get("scanned")), "_rows": _whole(row.get("rows"))} for row in rows or []}
            if rows is None:
                now = dict(self.tables_before)
            for key, delta in counter_deltas(self.tables_before, now).items():
                if delta.get("rows_scanned"):
                    database, _, table = key.partition("|")
                    tables.append({"database": database, "table": table, "full_scans": None, "rows_scanned": delta["rows_scanned"],
                                   "index_scans": None, "rows": now[key]["_rows"]})
            self.tables_before = now
        else:
            reading["notes"].append("no_performance_schema")
        reading["statements"], reading["tables"] = statements, tables
        return reading

    def read_clickhouse(self):
        info = self._clickhouse("""SELECT version() AS version, tcpPort() AS port,
            (SELECT sum(value) FROM system.metrics WHERE metric IN ('TCPConnection', 'HTTPConnection', 'MySQLConnection', 'PostgreSQLConnection')) AS connections,
            (SELECT toUInt64OrNull(any(value)) FROM system.server_settings WHERE name = 'max_connections') AS max_connections,
            (SELECT count() FROM system.processes WHERE query_id != queryID()) AS running,
            -- BACKUP and RESTORE run for many minutes by design; counted, they made
            -- every nightly backup an "is struggling" alert (2026-11-10).
            (SELECT max(elapsed) FROM system.processes WHERE query_id != queryID()
               AND NOT match(query, '(?i)^[[:space:]]*(BACKUP|RESTORE)[[:space:]]')) AS longest_s,
            (SELECT any(value) FROM system.metrics WHERE metric = 'MemoryTracking') AS memory,
            -- What it may use: see clickhouse_memory_limit.
            (SELECT toFloat64OrZero(any(value)) FROM system.server_settings WHERE name = 'max_server_memory_usage') AS memory_setting,
            (SELECT toFloat64OrZero(any(value)) FROM system.server_settings WHERE name = 'max_server_memory_usage_to_ram_ratio') AS memory_ratio,
            (SELECT any(value) FROM system.asynchronous_metrics WHERE metric = 'OSMemoryTotal') AS ram,
            (SELECT any(value) FROM system.asynchronous_metrics WHERE metric = 'CGroupMemoryTotal') AS container_ram,
            (SELECT max(c) FROM (SELECT count() AS c FROM system.parts WHERE active GROUP BY database, table, partition)) AS parts_max,
            (SELECT count() FROM system.merges) AS merges,
            -- The query log is written a few seconds after a query ends.
            toString(now() - 15) AS until""")
        if not isinstance(info, list) or not info or not isinstance(info[0], dict):
            if isinstance(info, dict) and info.get("_error") in (401, 403, 516):
                return {"instance": split_url(self.target)[3], "version": "", "health": {}, "notes": ["no_access"], "statements": [], "tables": []}
            return None
        info = info[0]
        reading = {"version": str(info.get("version") or "")[:32], "notes": [], "instance": split_url(self.target)[3],
                   "health": {"connections": _whole(info.get("connections")), "max_connections": _whole(info.get("max_connections")),
                              "running": _whole(info.get("running")), "waiting": None, "longest_s": _number(info.get("longest_s")),
                              "memory_mb": None if _whole(info.get("memory")) is None else _whole(info.get("memory")) // 1048576,
                              "memory_limit_mb": clickhouse_memory_limit(info),
                              "parts_max": _whole(info.get("parts_max")), "merges": _whole(info.get("merges"))},
                   "statements": [], "tables": []}
        # Up to 15 s ago, from where the last reading stopped.
        until = str(info.get("until") or "")[:19]
        if self.watermark and until:
            rows = self._clickhouse("""SELECT current_database AS database, any(normalizeQuery(query)) AS statement, count() AS calls,
                countIf(type != 'QueryFinish') AS errors, sum(query_duration_ms) AS total_ms, sum(read_rows) AS rows_read,
                sum(result_rows) AS rows_returned, sum(read_bytes) AS bytes_read, max(memory_usage) / 1048576 AS peak_memory_mb
              FROM system.query_log
              WHERE event_date >= toDate(toDateTime('%s')) AND event_time > toDateTime('%s') AND event_time <= toDateTime('%s')
                AND type IN ('QueryFinish', 'ExceptionWhileProcessing', 'ExceptionBeforeStart') AND is_initial_query
                AND query NOT LIKE '%%%s%%'
              GROUP BY normalized_query_hash, current_database ORDER BY total_ms DESC LIMIT %d""" % (
                self.watermark, self.watermark, until, AGENT_MARK, DB_STATEMENTS))
            if not isinstance(rows, list):
                reading["notes"].append("no_query_log")
            else:
                for row in rows:
                    reading["statements"].append({"database": row.get("database") or "", "statement": row.get("statement") or "",
                                                  "calls": _whole(row.get("calls")), "errors": _whole(row.get("errors")),
                                                  "total_ms": _number(row.get("total_ms")), "rows_read": _whole(row.get("rows_read")),
                                                  "rows_returned": _whole(row.get("rows_returned")), "bytes_read": _whole(row.get("bytes_read")),
                                                  "peak_memory_mb": _number(row.get("peak_memory_mb")), "no_index": None})
        self.watermark = until or self.watermark
        return reading

    def read_mongodb(self):
        since = self.watermark or {}
        script = """
          const status = admin.runCommand({ serverStatus: 1, repl: 0, metrics: 0, locks: 0 });
          let ops = null;
          try {
            ops = admin.aggregate([{ $currentOp: { allUsers: true, idleConnections: false } },
              { $match: { active: true, op: { $nin: ['none'] }, 'command.hello': { $exists: false } } },
              { $group: { _id: null, running: { $sum: 1 }, waiting: { $sum: { $cond: ['$waitingForLock', 1, 0] } },
                  longest: { $max: { $cond: [{ $eq: ['$appName', 'mongodump'] }, 0, '$secs_running'] } } } }]).toArray()[0] || { running: 0, waiting: 0, longest: 0 };
          } catch (e) { ops = null; }
          const since = SINCE;
          const profiled = {}; let anyOn = false;
          for (const d of admin.adminCommand({ listDatabases: 1, nameOnly: true }).databases.map((x) => x.name)) {
            if (['admin', 'local', 'config'].includes(d)) continue;
            const db = client.getDB(d);
            let level = 0;
            try { level = db.runCommand({ profile: -1 }).was; } catch (e) { level = 0; }
            if (!level) continue;
            anyOn = true;
            // An entry is written as its operation ends, so the last seconds may still be arriving.
            let until = new Date(Date.now() - 15000);
            const page = since[d] ? db.system.profile.find(
              { ts: { $gt: new Date(since[d]), $lte: until }, ns: { $not: /\\.system\\./ } },
              { ts: 1, op: 1, ns: 1, command: 1, millis: 1, docsExamined: 1, nreturned: 1, planSummary: 1, ok: 1, errMsg: 1 }).sort({ ts: 1 }).limit(LIMIT).toArray() : [];
            // A full page: the rest is read next minute, from where this one stopped.
            if (page.length === LIMIT) until = page[page.length - 1].ts;
            profiled[d] = { until: until.toISOString(), ops: page };
          }
          return { version: status.version, port: (status.host || '').split(':').pop(), connections: status.connections,
                   memory: status.mem && status.mem.resident, ops, profiled, anyOn };
        """.replace("SINCE", json.dumps(since)).replace("LIMIT", str(DB_READ_LIMIT * 5))
        info = self._mongo(script)
        if not isinstance(info, dict):
            return None
        connections = info.get("connections") or {}
        current, available = _whole(connections.get("current")), _whole(connections.get("available"))
        ops = info.get("ops") if isinstance(info.get("ops"), dict) else {}
        reading = {"version": str(info.get("version") or "")[:32], "notes": [] if info.get("anyOn") else ["profiler_off"],
                   "instance": split_url(self.target)[3],
                   "health": {"connections": current, "max_connections": None if current is None or available is None else current + available,
                              "running": _whole(ops.get("running")) if ops else None, "waiting": _whole(ops.get("waiting")) if ops else None,
                              "longest_s": _number(ops.get("longest")) if ops else None, "memory_mb": _whole(info.get("memory"))},
                   "statements": [], "tables": []}
        grouped, watermark = {}, dict(since)
        for database, found in (info.get("profiled") or {}).items():
            watermark[database] = found.get("until")
            for op in found.get("ops") or []:
                statement = normalize_statement(mongo_text(op.get("command"), op.get("op"), op.get("ns")), "mongodb")
                if not statement:
                    continue
                entry = grouped.setdefault((database, statement), {"database": database, "statement": statement, "calls": 0, "errors": 0,
                                                                   "total_ms": 0, "rows_read": 0, "rows_returned": 0, "bytes_read": None,
                                                                   "peak_memory_mb": None, "no_index": 0})
                entry["calls"] += 1
                entry["errors"] += 1 if op.get("errMsg") or op.get("ok") == 0 else 0
                entry["total_ms"] += _whole(op.get("millis")) or 0
                entry["rows_read"] += _whole(op.get("docsExamined")) or 0
                entry["rows_returned"] += _whole(op.get("nreturned")) or 0
                entry["no_index"] += 1 if str(op.get("planSummary") or "").startswith("COLLSCAN") else 0
        self.watermark = watermark
        reading["statements"] = list(grouped.values())
        return reading

    def read_redis(self):
        """INFO (clients, memory, stats, commandstats) and SLOWLOG. Of a slow
        log entry only its ID and duration are kept: never its arguments, its
        client's address or name."""
        address = redis_address(self.target)
        if not address:
            return None
        refused = {"instance": address["instance"], "version": "", "health": {}, "notes": ["no_access"], "statements": [], "tables": []}
        connection = RedisConnection(address)
        try:
            if address["password"]:
                try:
                    if address["user"]:
                        connection.call("AUTH", address["user"], address["password"])
                    else:
                        connection.call("AUTH", address["password"])
                except RedisError as error:
                    # ERR: no password is set (Redis before 6), so INFO decides.
                    if str(error) != "ERR":
                        return refused
            try:
                info = redis_info(connection.call("INFO", "all"))
            except RedisError:
                return refused
            try:
                slow = connection.call("SLOWLOG", "GET", str(REDIS_SLOWLOG))
            except RedisError:
                slow = False
        finally:
            connection.close()
        if not info:
            return None
        state = self.watermark or {}
        first = not state
        total = _whole(info.get("total_commands_processed"))
        restarted = not first and (state.get("run_id") != info.get("run_id"))
        # CONFIG RESETSTAT, or a restart: the counters start again from here.
        counted = not first and not restarted and not (total is not None and state.get("total") is not None and total < state["total"])

        def change(field, name):
            before, now = state.get(field), _whole(info.get(name))
            return now - before if counted and before is not None and now is not None and now >= before else None

        evicted = change("evicted", "evicted_keys")
        hits, misses = change("hits", "keyspace_hits"), change("misses", "keyspace_misses")
        looked = None if hits is None or misses is None else hits + misses
        notes, longest, newest = [], None, None
        if slow is False:
            notes.append("no_access")
        elif isinstance(slow, list):
            entries = [(entry[0], entry[2]) for entry in slow
                       if isinstance(entry, list) and len(entry) >= 3 and isinstance(entry[0], int) and isinstance(entry[2], int)]
            newest = max([i for i, _ in entries] or [-1])
            last = state.get("slow_id")
            # A restart numbers the log from 0 again: all of it came since.
            if restarted or (last is not None and newest < last):
                last = -1
            if not first and last is not None:
                durations = [us for i, us in entries if i > last]
                # Nothing newer: no command was slower than the log's threshold.
                longest = round(max(durations) / 1e6, 4) if durations else 0.0
        current = redis_command_stats(info)
        statements = []
        if counted:
            # A command missing last time hadn't been called since the counters started.
            before = {key: self.previous.get(key) or {field: 0 for field in value} for key, value in current.items()}
            for name, delta in counter_deltas(before, current).items():
                if delta.get("calls"):
                    statements.append({"database": "", "statement": name, "calls": delta["calls"], "errors": delta.get("errors"),
                                       "total_ms": round((delta.get("usec") or 0) / 1000.0, 3), "rows_read": None, "rows_returned": None,
                                       "bytes_read": None, "peak_memory_mb": None, "no_index": None})
        self.previous = current
        self.watermark = {"run_id": info.get("run_id"), "total": total, "evicted": _whole(info.get("evicted_keys")),
                          "hits": _whole(info.get("keyspace_hits")), "misses": _whole(info.get("keyspace_misses")), "slow_id": newest}
        used, limit = _whole(info.get("used_memory")), _whole(info.get("maxmemory"))
        version = info.get("valkey_version") or info.get("keydb_version") or info.get("dragonfly_version") or info.get("redis_version") or ""
        return {"instance": address["instance"], "version": version[:32], "notes": notes, "statements": statements, "tables": [],
                "health": {"connections": _whole(info.get("connected_clients")), "max_connections": _whole(info.get("maxclients")),
                           # blocked_clients are workers waiting for a job, not on a lock.
                           "running": None, "waiting": None, "longest_s": longest,
                           "cache_hit_pct": round(100.0 * hits / looked, 1) if looked else None,
                           "memory_mb": None if used is None else used // 1048576,
                           "memory_limit_mb": limit // 1048576 if limit else None, "evicted": evicted}}

    def _instance(self, default_port, port):
        if self.target == "local":
            return "local:%s" % (port or default_port)
        parts = urllib.parse.urlsplit(self.target)
        return "%s:%s" % (parts.hostname or "127.0.0.1", parts.port or port or default_port)

    def read(self, now=None):
        """This database's reading now, as databases.md has it, or None when
        it couldn't be read (skipped this minute)."""
        try:
            reading = getattr(self, "read_" + self.kind)()
        except Exception as error:
            log("could not read the %s database:" % self.kind, error)
            return None
        if not reading:
            log("could not read the %s database (is its client installed, and may root reach it?)" % self.kind)
            return None
        db = reading.pop("db", self.kind)
        statements = []
        for row in reading.get("statements") or []:
            row["statement"] = normalize_statement(row.get("statement") or "", db)
            if row["statement"] and row.get("calls"):
                statements.append(row)
        statements.sort(key=lambda row: -(row.get("total_ms") or 0))
        tables = sorted(reading.get("tables") or [], key=lambda row: -(row.get("rows_scanned") or 0))
        return {"minute": datetime.fromtimestamp(now or time.time(), timezone.utc).strftime("%Y-%m-%dT%H:%M:00.000Z"),
                "db": db, "instance": reading["instance"][:100], "version": reading.get("version") or "",
                "health": reading.get("health") or {}, "statements": statements[:DB_STATEMENTS], "tables": tables[:DB_TABLES],
                "notes": reading.get("notes") or []}


class RabbitReader:
    """A RabbitMQ's queues through its management API, once a minute:
    messages ready (waiting) and unacknowledged (running), the oldest
    message's age when publishers set a timestamp, and published and
    acknowledged since the last reading (the broker's own counts: shared)."""

    def __init__(self, target):
        self.target = target
        self.previous = {}

    def read(self, now=None):
        clean, user, password, netloc = split_url(self.target)
        columns = "name,vhost,messages_ready,messages_unacknowledged,head_message_timestamp,message_stats.publish,message_stats.ack"
        queues = http_json(clean.rstrip("/") + "/api/queues?columns=" + urllib.parse.quote(columns), user, password)
        if not isinstance(queues, list):
            log("could not read RabbitMQ's queues at %s%s" % (netloc, " (%s)" % queues.get("_error") if isinstance(queues, dict) else ""))
            return None
        now = now or time.time()
        minute = datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%dT%H:%M:00.000Z")
        current, rows = {}, []
        for queue in queues[:500]:
            name = str(queue.get("name") or "")
            vhost = str(queue.get("vhost") or "/")
            if not name or name.startswith("amq."):
                continue
            label = name if vhost == "/" else "%s/%s" % (vhost, name)
            stats = queue.get("message_stats") or {}
            current[label] = {"added": _whole(stats.get("publish")), "finished": _whole(stats.get("ack"))}
            waiting = _whole(queue.get("messages_ready"))
            head = _whole(queue.get("head_message_timestamp"))
            rows.append({"minute": minute, "system": "rabbitmq", "broker": netloc, "queue": label[:200],
                         "waiting": waiting, "running": _whole(queue.get("messages_unacknowledged")), "delayed": None, "failed": None,
                         "oldest_s": 0 if waiting == 0 else (max(0, int(now - head)) if head else None),
                         "added": None, "finished": None, "shared": True})
        deltas = counter_deltas(self.previous, current)
        for row in rows:
            delta = deltas.get(row["queue"]) or {}
            row["added"], row["finished"] = delta.get("added"), delta.get("finished")
        self.previous = current
        return rows


def health_only(databases, rows):
    """The readings without what counts since the last one: the gauges are
    right at any time, but counts that span more than a minute (or overlap
    the running agent's) would be stored as one minute's."""
    return ([dict(d, statements=[], tables=[]) for d in databases],
            [dict(r, added=None, finished=None) for r in rows])


class Readings:
    """Reads the listed databases and queues every minute and reports them to
    every site on this server, as resources are (the machine is the same for
    all of them). A site that has them off in the dashboard (Server speed)
    hears from us every ten minutes, only to learn when it is back on; with
    every site off, the reading itself is every ten minutes too."""

    PROBE_EVERY = 600

    def __init__(self, config):
        self.config = config
        self.sites = resources_sites(config)
        self.databases = [DatabaseReader(d["kind"], d["target"], config["state_dir"]) for d in database_list(config.get("databases"))]
        self.queues = [RabbitReader(q["target"]) for q in queue_list(config.get("queues"))]
        # site_id: on, and when an off site is next asked.
        self.enabled = {}
        self.probe_at = {}
        self.next_at = 0
        self.read_at = None
        self.thread = None

    def read(self, now=None):
        """(database readings, queue rows) now."""
        databases = [r for r in (reader.read(now) for reader in self.databases) if r]
        rows = []
        for reader in self.queues:
            rows.extend(reader.read(now) or [])
        return databases, rows

    def post(self, databases, rows, sites=None):
        """Sends them to each site (all by default); True when every one took them."""
        ok = True
        for site in self.sites if sites is None else sites:
            base = {"site_id": site["site_id"], "server_name": socket.gethostname()[:100], "runtime": "agent %s" % VERSION}
            for path, key, items, size in (("/events/server-databases", "databases", databases, READINGS_MAX),
                                           ("/events/server-queues", "rows", rows, 500)):
                for i in range(0, len(items), size):
                    status, _, raw = request(site, "POST", path, body=dict(base, **{key: items[i:i + size]}))
                    if status in (200, 202):
                        try:
                            self.enabled[site["site_id"]] = json.loads(raw or b"{}").get("enabled") is not False
                        except ValueError:
                            pass
                    else:
                        ok = False
                        log("collector answered %s to %s" % (status, path))
        return ok

    def tick(self, now=None):
        now = now or time.time()
        if now < self.next_at or not (self.databases or self.queues):
            return
        on = [site for site in self.sites if self.enabled.get(site["site_id"], True)]
        self.next_at = now + (READINGS_EVERY if on else self.PROBE_EVERY)
        sites = on + [site for site in self.sites if site not in on and now >= self.probe_at.get(site["site_id"], 0)]
        for site in sites:
            if site not in on:
                self.probe_at[site["site_id"]] = now + self.PROBE_EVERY
        try:
            gap = self.read_at is not None and now - self.read_at > 2 * READINGS_EVERY
            self.read_at = now
            databases, rows = self.read(now)
            if gap:
                databases, rows = health_only(databases, rows)
            if (databases or rows) and sites:
                self.post(databases, rows, sites)
        except Exception as error:
            log("database and queue readings failed:", error)

    def start(self):
        if not (self.databases or self.queues) or (self.thread and self.thread.is_alive()):
            return

        def work():
            while not stopping:
                self.tick()
                time.sleep(1)

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


# ---- What's deployed (sdk/protocols/deploys.md, POST /events/apps) -------------

# The commit each of the site's git work trees is on, and the image each running
# container came from, read every five minutes on a thread of its own. The
# collector compares each app's version with this host's last report: a changed
# one is a deploy, so the time on the chart is right to within these minutes.
#
# Only reads. git runs as the folder's owner, with their HOME, so it uses their
# keys and never needs safe.directory; it never prompts, every call has a
# timeout, and nothing here fetches or pulls: that would write into the
# customer's repository. Whether the branch has moved on is one `git ls-remote`
# an hour per folder, compared with objects already on disk.
#
# Nothing leaves the machine but paths, hashes, names and commit subjects. A
# remote's URL never does: it can carry a token, so it is cut down to the
# repository's owner/name first.
APPS_READ_EVERY = 300
APPS_REPORT_EVERY = 3600
APPS_REMOTE_EVERY = 3600
APPS_TIMEOUT = 20
APPS_MAX = 50
APPS_DEPTH = 2
APPS_MESSAGE_CHARS = 200
APPS_SKIP_DIRS = {".git", "node_modules", "vendor"}
APP_NAME = re.compile(r"[^A-Za-z0-9._/-]+")
COMMIT = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")
REPO = re.compile(r"^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$")
HOST = re.compile(r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")
# What git may be asked here. Each of these reads; fetch, pull, gc and the rest
# are refused before anything runs. `config` is `config --get` only.
GIT_READS = {"rev-parse", "log", "config", "symbolic-ref", "ls-remote", "cat-file", "merge-base", "rev-list"}
GIT_ENV = {
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=10",
    # A credential manager that would open a window asks nothing either.
    "GCM_INTERACTIVE": "never",
    # A partial clone fetches a missing object on demand; that's a write.
    "GIT_NO_LAZY_FETCH": "1",
    # Nor may a read refresh the index on its way past.
    "GIT_OPTIONAL_LOCKS": "0",
    # Not a command a person typed: a transport that is really a program
    # (`ext::`), a local file, or any helper git doesn't know is refused.
    "GIT_PROTOCOL_FROM_USER": "0",
    # A password asked for is answered with nothing, never by a program the
    # repository's config names (core.askPass).
    "GIT_ASKPASS": "/bin/true",
}
# A repository's own .git/config is written by whoever can write in the folder
# (an upload folder: the site's account, or what got into it), and git takes
# addresses and programs from it. These stand above that file for every read
# here (GIT_CONFIG_COUNT, git 2.31 and later): only https or ssh is dialled,
# no proxy is taken from the config, TLS stays checked, and no credential,
# signing or file-watching program is run from it.
GIT_CONFIG = (
    ("protocol.allow", "never"),
    ("protocol.https.allow", "always"),
    ("protocol.ssh.allow", "always"),
    ("http.proxy", ""),
    ("http.sslVerify", "true"),
    ("credential.helper", ""),
    ("log.showSignature", "false"),
    ("core.fsmonitor", "false"),
)


def app_paths(paths):
    return [os.path.abspath(p) for p in paths if isinstance(p, str) and p.strip()] if isinstance(paths, list) else []


def _command(args, env=None, cwd=None, timeout=APPS_TIMEOUT):
    """(exit code, stdout) of a command, or (None, "") when it couldn't run or
    took too long. It runs in a session of its own so a timeout kills
    everything under it: runuser's git and git's ssh, not runuser alone."""
    try:
        proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                env=env, cwd=cwd, start_new_session=True)
    except (OSError, ValueError):
        return None, ""
    try:
        out, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        return None, ""
    return proc.returncode, out.decode("utf-8", "replace")


def folder_owner(path):
    """(name, home) of the account that owns the folder, or None."""
    try:
        owner = pwd.getpwuid(os.stat(path).st_uid)
    except (OSError, KeyError):
        return None
    return owner.pw_name, owner.pw_dir or "/"


def git(folder, owner, *args, config=()):
    """(exit code, stdout) of one read-only git command run as `owner`, or
    (None, "") when it failed to run, timed out or isn't a read. `config`:
    (key, value) settings for this command on top of GIT_CONFIG."""
    if not args or args[0] not in GIT_READS or (args[0] == "config" and args[1:2] != ("--get",)):
        return None, ""
    name, home = owner
    env = dict(GIT_ENV, HOME=home, USER=name, LOGNAME=name, LANG="C", LC_ALL="C",
               PATH=os.environ.get("PATH") or "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    settings = GIT_CONFIG + tuple(config)
    env["GIT_CONFIG_COUNT"] = str(len(settings))
    for i, (key, value) in enumerate(settings):
        env["GIT_CONFIG_KEY_%d" % i], env["GIT_CONFIG_VALUE_%d" % i] = key, value
    command = ["git", "-C", folder] + list(args)
    if os.geteuid() == 0 and name != "root":
        command = ["runuser", "-u", name, "--"] + command
    return _command(command, env=env, cwd=folder)


def git_out(folder, owner, *args, **options):
    """git's first line of output when it succeeded, else None."""
    code, out = git(folder, owner, *args, **options)
    return out.strip() if code == 0 and out.strip() else None


def repo_name(url):
    """A remote's URL cut down to `owner/name` (`group/sub/name` on GitLab), or
    None. The URL itself never leaves the machine: `https://token@github.com/...`
    carries a credential, and so can a query string."""
    url = (url or "").strip()
    match = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*)://(.*)$", url)
    if match:
        if match.group(1).lower() == "file":
            return None
        rest = match.group(2)
        # The path starts at the first "/" after the host, and the host after
        # the last "@" before the path: a password may hold a "/" or an "@".
        rest = rest.split("?", 1)[0].split("#", 1)[0]
        at = rest.rfind("@")
        rest = rest[at + 1:] if at >= 0 else rest
        if "/" not in rest:
            return None
        path = rest.split("/", 1)[1]
    elif re.match(r"^[^/]*:", url):
        # scp-like: [user@]host:owner/repo.git
        rest = url.rsplit("@", 1)[-1]
        path = rest.split(":", 1)[1] if ":" in rest else ""
    else:
        # A folder on this machine or a share: there is no owner/name to give.
        return None
    path = path.strip("/").lstrip("~")
    if path.endswith(".git"):
        path = path[:-4]
    path = path.strip("/")
    return path if len(path) <= 200 and REPO.match(path) else None


def repo_host(url):
    """The host a remote lives on ("github.com"), lowercased, without a user,
    password or port, or None. Sent with `repo` so the dashboard can link to
    the repository; a host name carries no credential."""
    url = (url or "").strip()
    match = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*)://(.*)$", url)
    if match:
        if match.group(1).lower() == "file":
            return None
        rest = match.group(2).split("?", 1)[0].split("#", 1)[0]
        at = rest.rfind("@")
        rest = rest[at + 1:] if at >= 0 else rest
        if "/" not in rest:
            return None
        host = rest.split("/", 1)[0].split(":", 1)[0]
    elif re.match(r"^[^/]*:", url):
        host = url.rsplit("@", 1)[-1].split(":", 1)[0]
    else:
        return None
    host = host.lower()
    return host if len(host) <= 100 and HOST.match(host) else None


def git_upstream(folder, owner, branch):
    """(remote, branch on it) the folder follows, or None. A detached HEAD
    follows nothing of its own, so the remote's default branch stands in."""
    if branch and branch != "HEAD":
        remote = git_out(folder, owner, "config", "--get", "branch.%s.remote" % branch)
        merge = git_out(folder, owner, "config", "--get", "branch.%s.merge" % branch)
        if not remote or remote == "." or not merge or not merge.startswith("refs/heads/"):
            return None
        upstream = (remote, merge[len("refs/heads/"):])
    else:
        ref = git_out(folder, owner, "symbolic-ref", "-q", "refs/remotes/origin/HEAD")
        if not ref or not ref.startswith("refs/remotes/origin/"):
            return None
        upstream = ("origin", ref[len("refs/remotes/origin/"):])
    # Never something git would read as an option.
    if any(not part or part.startswith("-") for part in upstream):
        return None
    return upstream


def remote_reachable(url):
    """Whether a remote's address may be dialled from here: https or ssh, to a
    host with a name. The address is the repository's own config, written by
    whoever can write in the folder, so the agent must not be made to reach
    what it names: an address inside the network (plain http, a bare IP, this
    machine), a file, or a command dressed as a transport (`ext::`)."""
    url = (url or "").strip()
    scheme = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*)://", url)
    if scheme:
        if scheme.group(1).lower() not in ("https", "ssh"):
            return False
    elif "::" in url or not re.match(r"^([^@/:\s]+@)?[A-Za-z0-9.-]+:", url):
        # Neither a URL nor scp-like `[user@]host:path`: a helper (`ext::`),
        # a folder, a share.
        return False
    host = repo_host(url)
    if not host or host == "localhost" or host.endswith(".localhost"):
        return False
    return not all(part.isdigit() for part in host.split("."))


def remote_head(folder, owner, remote, branch):
    """The commit the branch is on at the remote, or None. Reads the remote's
    list of branches; nothing is downloaded and nothing written. The address
    is taken as git would dial it (the config's rewrites applied) and checked
    first: an https or ssh address of a named host, or the remote isn't asked."""
    # No proxy for this remote from the config either (remote.<name>.proxy).
    config = (("remote.%s.proxy" % remote, ""),)
    url = git_out(folder, owner, "ls-remote", "--get-url", remote, config=config)
    if not remote_reachable(url):
        return None
    code, out = git(folder, owner, "ls-remote", remote, "refs/heads/" + branch, config=config)
    if code != 0:
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 2 and parts[1].strip() == "refs/heads/" + branch and COMMIT.match(parts[0].strip()):
            return parts[0].strip()
    return None


def branch_state(folder, owner, head, remote):
    """(state, commits behind) of HEAD against the remote's commit, from objects
    already on disk. Any answer git couldn't give is "unknown"."""
    if not remote:
        return "unknown", None
    if remote == head:
        return "current", None
    code, _ = git(folder, owner, "cat-file", "-e", remote + "^{commit}")
    if code is None:
        return "unknown", None
    if code != 0:
        # The branch moved and this server never fetched it: how far is unknown.
        return "newer_remote", None
    code, _ = git(folder, owner, "merge-base", "--is-ancestor", head, remote)
    if code == 0:
        count = git_out(folder, owner, "rev-list", "--count", "%s..%s" % (head, remote))
        return ("behind", int(count)) if count and count.isdigit() else ("unknown", None)
    if code != 1:
        return "unknown", None
    code, _ = git(folder, owner, "merge-base", "--is-ancestor", remote, head)
    if code == 0:
        return "ahead", None
    return ("diverged", None) if code == 1 else ("unknown", None)


def git_app(folder, checks, now):
    """One git work tree as the protocol's app (without its name), or None when
    git can't say what it's on. `checks` holds each folder's last ls-remote:
    {folder: {"upstream", "version", "head", "at"}}, run again once it is an
    hour old, whatever it found, or as soon as the folder is on another commit:
    a pull moves HEAD past the remote commit last seen, and comparing it with
    that would read as "ahead" for up to an hour."""
    owner = folder_owner(folder)
    if owner is None:
        return None
    head = git_out(folder, owner, "rev-parse", "HEAD")
    if not head or not COMMIT.match(head):
        return None
    branch = git_out(folder, owner, "rev-parse", "--abbrev-ref", "HEAD")
    upstream = git_upstream(folder, owner, branch)
    app = {"kind": "git", "path": folder, "version": head}
    if branch and branch != "HEAD":
        app["branch"] = branch
    elif upstream:
        app["branch"] = upstream[1]
    url = git_out(folder, owner, "config", "--get", "remote.%s.url" % (upstream[0] if upstream else "origin"))
    repo = repo_name(url)
    if repo:
        app["repo"] = repo
        host = repo_host(url)
        if host:
            app["repo_host"] = host
    code, out = git(folder, owner, "log", "-1", "--format=%s%x00%ct")
    if code == 0 and "\x00" in out:
        message, committed = out.strip("\n").rsplit("\x00", 1)
        if message.strip():
            app["message"] = message.strip()[:APPS_MESSAGE_CHARS]
        if committed.strip().isdigit():
            app["committed_at"] = iso(int(committed.strip()))
    last = checks.get(folder)
    if last is None or now - last["at"] >= APPS_REMOTE_EVERY or last.get("head") != head:
        version = remote_head(folder, owner, *upstream) if upstream else None
        last = checks[folder] = {"upstream": upstream, "version": version, "head": head, "at": now}
    # Checked against another branch than the one checked out now: unknown
    # until the next hourly check, rather than an answer about the wrong branch.
    remote = last["version"] if last["upstream"] == upstream else None
    state, behind = branch_state(folder, owner, head, remote)
    app["remote"] = None if state == "unknown" else {"version": remote, "checked_at": iso(int(last["at"]))}
    app["state"] = state
    if behind is not None:
        app["behind"] = behind
    return app


def git_folders(roots, paths=()):
    """The git work trees at the roots and up to APPS_DEPTH folders below them,
    then the folders listed in the config. A work tree's own folders aren't
    searched further, and links aren't followed."""
    found, seen = [], set()

    def add(folder):
        real = os.path.realpath(folder)
        if real not in seen and len(found) < APPS_MAX:
            seen.add(real)
            found.append(folder.rstrip("/") or "/")

    for root in roots:
        queue = [(root, 0)]
        while queue and len(found) < APPS_MAX:
            folder, depth = queue.pop(0)
            if os.path.lexists(os.path.join(folder, ".git")):
                add(folder)
                continue
            if depth >= APPS_DEPTH:
                continue
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                path = os.path.join(folder, name)
                if name not in APPS_SKIP_DIRS and not os.path.islink(path) and os.path.isdir(path):
                    queue.append((path, depth + 1))
    for path in paths:
        if os.path.lexists(os.path.join(path, ".git")):
            add(path)
    return found


# A running program that is an app's own runtime, by its executable's name.
# Web servers, databases and the rest run from "/" or their data folder and
# never carry an app's files, but a stray script can: so a folder without git
# counts only when one of these runs in it and it holds one of APP_FILES.
APP_RUNTIMES = re.compile(r"^(node|nodejs|bun|deno|python[\d.]*|php[\d.]*|php-cgi[\d.]*|ruby[\d.]*|"
                          r"puma|unicorn|uwsgi|gunicorn|java|dotnet)$")
APP_FILES = {"package.json", "pyproject.toml", "requirements.txt", "Pipfile", "manage.py", "composer.json",
             "Gemfile", "go.mod", "pom.xml", "build.gradle", "build.gradle.kts"}
APP_FILE_ENDINGS = (".jar", ".csproj", ".runtimeconfig.json")
# What a deploy rewrites and a running app doesn't: its manifests, lock files
# and code. A data file, cache or log beside them changes on its own, and
# counting it would make every few minutes a deploy.
FINGERPRINT_FILES = APP_FILES | {"package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb", "composer.lock",
                                 "Gemfile.lock", "poetry.lock", "uv.lock", "Pipfile.lock", "go.sum"}
FINGERPRINT_ENDINGS = APP_FILE_ENDINGS + (".js", ".mjs", ".cjs", ".ts", ".py", ".php", ".rb", ".war", ".dll")
FINGERPRINT_MAX = 2000


def inside_any(path, roots):
    """Whether `path` is one of `roots` or in one of them."""
    return any(path == r or path.startswith(r.rstrip("/") + "/") for r in roots)


def runtime_of(exe):
    """"node" for /usr/bin/node, None for a program that isn't an app runtime."""
    name = os.path.basename(str(exe or "").replace(" (deleted)", ""))
    return name if APP_RUNTIMES.match(name) else None


def has_app_files(folder):
    try:
        names = os.listdir(folder)
    except OSError:
        return False
    return any(n in APP_FILES or n.endswith(APP_FILE_ENDINGS) for n in names)


def running_apps(proc="/proc"):
    """What the running services were started in: (git work trees, [(folder,
    runtime)] of apps that aren't in git). Each process's working folder, or
    a folder up to APPS_DEPTH above it, is looked at: a work tree is an app
    whatever runs in it; a plain folder only when an app runtime runs there
    and it holds an app's files (package.json, composer.json, a .jar...). So an
    app run by PM2, systemd, supervisor or a plain `nohup` is found wherever it
    lives, deployed by `git pull` or copied by a pipeline, with nothing to
    configure. Left out: processes on a terminal (someone's shell and what
    they run from it) and those in another mount namespace (a container: its
    folders aren't this machine's, and Docker reports it already). Without
    root, only the agent's own user's processes can be read."""
    try:
        own = os.readlink(os.path.join(proc, "self", "ns", "mnt"))
    except OSError:
        own = None
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return [], []
    git, plain, looked = [], {}, set()
    for pid in pids:
        base = os.path.join(proc, pid)
        try:
            with open(os.path.join(base, "stat")) as f:
                fields = f.read().rsplit(")", 1)[1].split()
            if int(fields[4]) != 0:
                continue
            if own and os.readlink(os.path.join(base, "ns", "mnt")) != own:
                continue
            cwd = os.readlink(os.path.join(base, "cwd"))
        except (OSError, ValueError, IndexError):
            continue
        try:
            runtime = runtime_of(os.readlink(os.path.join(base, "exe")))
        except OSError:
            runtime = None
        if (cwd, runtime) in looked or not cwd.startswith("/"):
            continue
        looked.add((cwd, runtime))
        folders, folder = [], cwd.rstrip("/")
        for _ in range(APPS_DEPTH + 1):
            if not folder:
                break
            folders.append(folder)
            folder = os.path.dirname(folder).rstrip("/")
        tree = next((f for f in folders if os.path.lexists(os.path.join(f, ".git"))), None)
        if tree:
            if tree not in git:
                git.append(tree)
        elif runtime:
            app = next((f for f in folders if has_app_files(f)), None)
            if app:
                plain.setdefault(app, runtime)
    # An app folder inside a work tree another process runs in is that tree.
    return sorted(git), sorted((f, r) for f, r in plain.items() if not inside_any(f, git))


def folder_app(folder, runtime):
    """An app that isn't in git, as the protocol's app (without its name), or
    None when its folder can't be read. The version is a fingerprint of the
    manifests, lock files and code at its top level (names, sizes and
    modification times): a deploy rewrites them, a restart doesn't. A deploy
    that only changes files in subfolders isn't seen, but one that changes
    the lock file or the entry point is."""
    try:
        names = sorted(os.listdir(folder))[:FINGERPRINT_MAX]
    except OSError:
        return None
    digest, newest = hashlib.sha256(), 0
    for name in names:
        if name not in FINGERPRINT_FILES and not name.endswith(FINGERPRINT_ENDINGS):
            continue
        try:
            st = os.lstat(os.path.join(folder, name))
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode):
            continue
        digest.update(("%s\0%d\0%d\n" % (name, st.st_size, int(st.st_mtime))).encode("utf-8", "replace"))
        newest = max(newest, int(st.st_mtime))
    app = {"kind": "folder", "path": folder, "version": digest.hexdigest()[:24], "runtime": runtime}
    if newest:
        app["changed_at"] = iso(newest)
    return app


DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")


def image_repo(ref):
    """An image reference without its tag or digest: "ghcr.io/acme/api:1.4"
    is "ghcr.io/acme/api". A colon before the last "/" is a registry's port."""
    ref = str(ref or "").split("@", 1)[0]
    head, _, last = ref.rpartition("/")
    return (head + "/" if head else "") + last.split(":", 1)[0]


def image_digests(text):
    """{image ID: its RepoDigests} from `docker image inspect`'s output."""
    try:
        items = json.loads(text or "[]")
    except ValueError:
        return {}
    out = {}
    for item in items if isinstance(items, list) else []:
        if isinstance(item, dict) and isinstance(item.get("Id"), str) and isinstance(item.get("RepoDigests"), list):
            out[item["Id"]] = [d for d in item["RepoDigests"] if isinstance(d, str)]
    return out


def docker_apps(text, images_text=""):
    """The running containers in `docker inspect`'s output, as the protocol's
    apps: the image ID is the version, so a new image is a deploy. `digest`
    is what the registry calls the image it was pulled as, from `docker image
    inspect` (`images_text`): the dashboard compares it with what the tag
    points at now, which is how a newer `latest` is told apart."""
    try:
        items = json.loads(text or "[]")
    except ValueError:
        return []
    digests = image_digests(images_text)
    out = []
    for item in items if isinstance(items, list) else []:
        if not isinstance(item, dict) or not (item.get("State") or {}).get("Running"):
            continue
        image = item.get("Image")
        name = str(item.get("Name") or "").lstrip("/")
        if not name or not isinstance(image, str) or not image:
            continue
        config = item.get("Config") or {}
        app = {"name": name, "kind": "docker", "version": image[:100]}
        if isinstance(config.get("Image"), str) and config["Image"]:
            app["image"] = config["Image"][:200]
        pulled = digests.get(image) or []
        # The digest for the repository the container names; an image pulled
        # under two names has one each, and the same digest under both.
        mine = [d for d in pulled if image_repo(d) == image_repo(config.get("Image"))] or (pulled if len(pulled) == 1 else [])
        digest = mine[0].split("@", 1)[1] if mine and "@" in mine[0] else ""
        if DIGEST.match(digest):
            app["digest"] = digest
        revision = (config.get("Labels") or {}).get("org.opencontainers.image.revision")
        if isinstance(revision, str) and revision.strip():
            app["revision"] = revision.strip()[:100]
        started = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?Z$", str((item.get("State") or {}).get("StartedAt") or ""))
        if started and not started.group(1).startswith("0001"):
            app["started_at"] = started.group(1) + "Z"
        out.append(app)
    return sorted(out, key=lambda a: a["name"])


def docker_containers():
    """The running containers, or [] without Docker or when it didn't answer."""
    if not shutil.which("docker"):
        return []
    code, out = _command(["docker", "ps", "-q", "--no-trunc"])
    ids = out.split()[:APPS_MAX] if code == 0 else []
    if not ids:
        return []
    code, out = _command(["docker", "inspect"] + ids)
    if code != 0:
        return []
    try:
        images = sorted({i.get("Image") for i in json.loads(out or "[]") if isinstance(i, dict) and isinstance(i.get("Image"), str)})
    except (ValueError, TypeError):
        images = []
    # Without the digests the containers are still reported, only not
    # comparable with what their tag points at now.
    code, images_out = _command(["docker", "image", "inspect"] + images) if images else (1, "")
    return docker_apps(out, images_out if code == 0 else "")


def name_apps(apps):
    """Gives each app a name the protocol takes, unique on this host: the
    folder's name, or the last two parts of its path when two share it."""
    def clean(text):
        return APP_NAME.sub("-", text).strip("-/")[:100] or "app"

    short = [clean(os.path.basename(a["path"].rstrip("/")) if "path" in a else a["name"]) for a in apps]
    taken, named = set(), []
    for app, name in zip(apps, short):
        if "path" in app and short.count(name) > 1:
            name = clean("/".join(app["path"].rstrip("/").split("/")[-2:]))
        unique, n = name, 2
        while unique in taken:
            suffix = "-%d" % n
            unique, n = name[:100 - len(suffix)] + suffix, n + 1
        taken.add(unique)
        named.append(dict(app, name=unique) if "name" in app else dict({"name": unique}, **app))
    return named


def collect_apps(site, checks, now=None):
    """What's deployed for one site now: its git work trees, those the
    running services were started in, the running apps that aren't in git,
    then (for the main site, when that's on) the running containers."""
    now = now or time.time()
    apps = []
    listed = list(site.get("apps") or [])
    plain = []
    if site.get("running_apps"):
        # A running app inside a site's folders is that site's; the main site
        # (`within` None) takes the ones inside nobody's.
        real = lambda paths: [os.path.realpath(p) for p in paths]
        if site.get("within") is not None:
            mine = lambda f: inside_any(os.path.realpath(f), real(site["within"]))
        else:
            mine = lambda f: not inside_any(os.path.realpath(f), real(site.get("elsewhere") or []))
        git, plain = running_apps()
        listed += [f for f in git if mine(f)]
        plain = [(f, r) for f, r in plain if mine(f)]
    folders = git_folders(site.get("files_roots") or [], listed)
    for folder in folders:
        try:
            app = git_app(folder, checks, now)
        except Exception as error:
            log("could not read %s: %s" % (folder, error))
            app = None
        if app:
            apps.append(app)
    for folder, runtime in plain:
        app = folder_app(folder, runtime)
        if app:
            apps.append(app)
    if site.get("docker_apps"):
        apps += docker_containers()
    # A folder that's gone doesn't keep its check.
    for folder in [f for f in checks if f not in folders]:
        checks.pop(folder, None)
    return name_apps(apps[:APPS_MAX])


def apps_fingerprint(apps):
    """What counts as a change: everything but when the remote was last asked."""
    plain = []
    for app in apps:
        app = dict(app)
        if app.get("remote"):
            app["remote"] = {"version": app["remote"]["version"]}
        plain.append(app)
    return json.dumps(sorted(plain, key=lambda a: a["name"]), sort_keys=True)


def apps_sites(config):
    """A config per site with apps to report. Each looks in its own folders
    and reports under its own secret; Docker goes with the main site only,
    and only when it is the one site here or the config says so."""
    docker = config.get("docker_apps")
    if not isinstance(docker, bool):
        docker = not config["sites"]
    # Running apps are found on every server, with one site or several: each
    # goes to the site whose folders it's in, and the main site takes the rest.
    running = config.get("running_apps") is not False and os.path.isdir("/proc")
    folders = lambda site: site["files_roots"] + (site.get("apps") or [])
    elsewhere = [p for site in config["sites"] for p in folders(site)]
    out = [dict(config, docker_apps=docker, running_apps=running, elsewhere=elsewhere, within=None)]
    for site in config["sites"]:
        out.append(dict(config, site_id=site["site_id"], secret=site["secret"], files_roots=site["files_roots"],
                        apps=site.get("apps") or [], docker_apps=False, running_apps=running, within=folders(site)))
    return [s for s in out if s["files_roots"] or s["apps"] or s["running_apps"]
            or (s["docker_apps"] and shutil.which("docker"))]


class Apps:
    """One site's apps: read every five minutes, reported when they change and
    at least hourly. Kept in memory only: after a restart the first report is
    sent whatever it holds, and the collector, comparing with this host's last
    one, sees no deploy unless a version really changed."""

    def __init__(self, config):
        self.config = config
        self.checks = {}
        self.apps, self.read_print, self.sent = None, None, None
        self.every = APPS_REPORT_EVERY
        self.next_read = self.next_report = self.retry_at = 0

    def read(self, now=None):
        self.apps = collect_apps(self.config, self.checks, now)
        self.read_print = apps_fingerprint(self.apps)
        return self.apps

    def post(self, now=None):
        """Reports the last read. True when the collector took it."""
        now = now or time.time()
        if self.apps is None:
            self.read(now)
        body = {"v": PROTOCOL, "site_id": self.config["site_id"], "host": socket.gethostname()[:100],
                "client": "vps-agent/%s" % VERSION, "apps": self.apps}
        status, _, raw = request(self.config, "POST", "/events/apps", body=body)
        if status in (200, 202):
            try:
                answer = json.loads(raw or b"{}")
                self.every = max(60, int(answer.get("every") or APPS_REPORT_EVERY))
            except (ValueError, TypeError, AttributeError):
                self.every = APPS_REPORT_EVERY
            self.sent = self.read_print
            self.next_report, self.retry_at = now + self.every, 0
            return True
        if status == 0 or status >= 500:
            # Unreachable or storage down: the same report goes again shortly.
            wait = RETRY * 5
        else:
            # 4xx: sending it again straight away won't make it acceptable.
            log("collector answered %s to the apps report" % status)
            wait = APPS_REPORT_EVERY
        self.next_report = self.retry_at = now + wait
        return False

    def tick(self, now=None):
        """Called often; reads and reports when due. Cheap when neither is."""
        now = now or time.time()
        try:
            if now >= self.next_read:
                self.next_read = now + APPS_READ_EVERY
                self.read(now)
            if self.apps is None:
                return
            changed = self.read_print != self.sent
            if (changed and now >= self.retry_at) or now >= self.next_report:
                self.post(now)
        except Exception as error:
            log("apps report failed:", error)
            self.next_report = self.retry_at = now + RETRY * 5


def start_apps(jobs):
    """All sites' apps on one thread of their own: a slow ls-remote must not
    hold up the firewall, and the file and set-up checks mustn't hold it up."""
    def work():
        while not stopping:
            for job in jobs:
                if stopping:
                    break
                job.tick()
            time.sleep(1)

    thread = threading.Thread(target=work, daemon=True)
    thread.start()
    return thread


# ---- Backups (sdk/protocols/backups.md, POST /events/backups) -------------------

# A copy of the server's databases and folders every night, into the owner's
# own storage (an S3 bucket, Backblaze, an SFTP server...) through restic,
# which encrypts it on this machine with a password only the owner has: we
# never hold the copies, the storage keys or the password. Each database is
# dumped with its own tool (pg_dump, mysqldump, mongodump, SQLite's backup),
# straight into restic, so nothing waits on this disk; each folder is a
# snapshot of its own. One night's snapshots share a "run:" tag, and that run
# is what the dashboard shows, downloads and puts back.
#
# What reaches the collector is the bookkeeping only: names, sizes, times and
# whether each part worked. Never a file, a row, a key or the password.
#
# Putting a run back (restore) is the one thing here that writes to the
# owner's data, so it is off until "allow_restore" is true in this file, which
# only root can edit; the dashboard can ask, never decide. Before anything is
# replaced the parts being put back are backed up as they are now, the site's
# alerts are paused, folders are swapped in whole (the old one is kept aside a
# week), and if a part fails or a service that ran before stops, everything is
# put back as it was.

BACKUP_DEFAULTS = {
    # Any restic repository: "s3:https://nbg1.your-objectstorage.com/bucket/server",
    # "b2:bucket:path", "sftp:user@host:/srv/backups", "rest:https://...", a path.
    "repository": "",
    "password_file": "/etc/analytics-backup-password",
    # The storage's keys, as restic reads them: AWS_ACCESS_KEY_ID,
    # AWS_SECRET_ACCESS_KEY, B2_ACCOUNT_ID, ... Only these names are passed on.
    "env": {},
    # The bucket's region, for signing download links; null: read from the address.
    "region": None,
    # null: the ones under "databases" restic can dump (PostgreSQL, MySQL,
    # MongoDB). A list: these, each {"postgresql"|"mysql"|"mongodb": "local",
    # a connection string or "docker:CONTAINER"} or {"sqlite": "/path/app.db"},
    # optionally with "only": [database names].
    "databases": None,
    # null: "files_roots" and "apps". A list of folders.
    "folders": None,
    "exclude": ["node_modules", ".cache", "__pycache__", "*.tmp", "*.swp"],
    "at": "03:00",  # this server's own time
    # "nightly", "weekly" (on "weekday") or "off" (only when asked). The
    # dashboard's choice, once made there, wins over this.
    "schedule": "nightly",
    "weekday": "sun",
    "keep": {"daily": 14, "weekly": 8, "monthly": 12},
    "allow_restore": False,
    # Where a download is made before it's uploaded; null: state_dir.
    "temp_dir": None,
}
RESTIC_VERSION = "0.19.1"
RESTIC_MIN = (0, 17)  # --stdin-from-command, snapshot:path restores, exit code 10
# From the release's SHA256SUMS, whose signature by restic's release key
# (CF8F18F2844575973F79D4E191A6868BD3F7A907) was checked when this was pinned.
RESTIC_SHA256 = {
    "amd64": "f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c",
    "arm64": "a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465",
    "386": "c715a3de2fffb70a4c7864ef2d195db8bad96bc0284757cd5bd0f43362f2a191",
    "arm": "1edc5f67b0dd0d028586ab28c34b4da7522eabce933b3f6cd04f9ea184c2a502",
}
RESTIC_BIN = "/usr/local/bin/restic"
RESTIC_ENV = re.compile(r"^(AWS_[A-Z_]+|B2_[A-Z_]+|AZURE_[A-Z_]+|GOOGLE_[A-Z_]+|OS_[A-Z_]+|ST_[A-Z_]+|RESTIC_REST_[A-Z_]+|RCLONE_[A-Z0-9_]+)$")
BACKUP_KINDS = ("postgresql", "mysql", "mongodb", "sqlite")
BACKUP_TAG = "sitegoose"
BACKUP_STATE = "backups.json"
BACKUP_TICK = 30
BACKUP_REPORT_EVERY = 3600
BACKUP_REQUESTS_EVERY = 60
BACKUP_TIMEOUT = 12 * 3600  # one dump or folder
BACKUP_QUICK = 120  # listing, init, stats
BACKUP_RUNS_SENT = 60
BACKUP_ERROR_CHARS = 300
BACKUP_PART = 64 * 1024 * 1024  # a download's upload parts
BACKUP_LINK_S = 3600  # how long a download link works
BACKUP_EXPORT_KEEP = 24 * 3600  # when the file behind it is deleted
BACKUP_ASIDE_KEEP = 7 * 24 * 3600  # a folder a restore replaced
BACKUP_HEALTH_WAIT = 60
RESTORE_PAUSE_MINUTES = 120
RUN_ID = re.compile(r"^\d{8}T\d{6}Z$")
SCHEDULES = ("nightly", "weekly", "off")
WEEKDAYS = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")  # time.struct_time.tm_wday order
BACKUP_PRUNE_EVERY = 6.5 * 24 * 3600  # prune and check once a week, whatever the schedule
BACKUP_DISK_SPARE = 512 * 1024 * 1024
DB_NAME = re.compile(r"^[A-Za-z0-9_$.-]{1,64}$")
MYSQL_SYSTEM = {"information_schema", "performance_schema", "sys", "mysql"}
# Folders a restore never swaps whole: putting back /etc or /var by renaming
# would take the system down with it. `restore --into` gets them out instead.
SYSTEM_FOLDERS = {"/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/lib64", "/opt", "/proc", "/root",
                  "/run", "/sbin", "/srv", "/sys", "/tmp", "/usr", "/var", "/var/lib", "/var/www"}


def _hhmm(value, default):
    return value if isinstance(value, str) and re.match(r"^([01]\d|2[0-3]):[0-5]\d$", value) else default


def backup_databases(entries):
    """The databases to back up, each {kind, target, label, only}. target is
    "local", a connection string, "docker:CONTAINER" or SQLite's path. label
    names it without anything a password could be in."""
    out = []
    for entry in entries if isinstance(entries, list) else []:
        if isinstance(entry, dict) and "mariadb" in entry and "mysql" not in entry:
            entry = dict(entry, mysql=entry["mariadb"])
        kind = next((k for k in BACKUP_KINDS if isinstance(entry, dict) and isinstance(entry.get(k), str)), None)
        if not kind:
            log("backups: a database with %s needs one of %s, skipped" % (_entry_keys(entry), ", ".join(BACKUP_KINDS)))
            continue
        target = entry[kind].strip()
        only = [n for n in entry.get("only") or [] if isinstance(n, str) and DB_NAME.match(n)]
        docker = target.startswith("docker:")
        if docker and not re.match(r"^docker:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", target):
            log("backups: %s docker: needs a container's name, skipped" % kind)
            continue
        if kind == "sqlite":
            if not os.path.isabs(target):
                log("backups: sqlite needs the database file's full path, skipped")
                continue
            label = "sqlite " + target
        elif docker:
            label = "%s in %s" % (kind, target[7:])
        elif target == "local":
            if kind == "mongodb":
                target = "mongodb://127.0.0.1:27017"
            label = "%s local" % kind
        else:
            if kind == "mongodb" and not re.match(r"^mongodb(\+srv)?://", target, re.I):
                log("backups: mongodb needs a connection string, \"local\" or docker:NAME, skipped")
                continue
            if kind in ("postgresql", "mysql") and not re.match(r"^(postgres(ql)?|mysql|mariadb)://", target, re.I):
                log("backups: %s needs \"local\", a connection string or docker:NAME, skipped" % kind)
                continue
            parts = urllib.parse.urlsplit(target)
            label = "%s %s%s" % (kind, parts.hostname or "?", (":%d" % parts.port) if parts.port else "")
        out.append({"kind": kind, "target": target, "label": label, "only": only})
    return out[:READINGS_MAX]


def backup_config(config):
    """The "backups" section filled in, or None when it names no repository."""
    raw = config.get("backups")
    if not isinstance(raw, dict) or not isinstance(raw.get("repository"), str) or not raw["repository"].strip():
        return None
    conf = dict(BACKUP_DEFAULTS, **raw)
    conf["repository"] = conf["repository"].strip()
    conf["password_file"] = str(conf["password_file"] or BACKUP_DEFAULTS["password_file"])
    conf["env"] = {k: str(v) for k, v in (conf["env"] if isinstance(conf["env"], dict) else {}).items() if RESTIC_ENV.match(str(k))}
    conf["at"] = _hhmm(conf["at"], BACKUP_DEFAULTS["at"])
    keep = conf["keep"] if isinstance(conf["keep"], dict) else {}
    conf["keep"] = {k: _count(keep.get(k, d), 0, 1000) or 0 for k, d in BACKUP_DEFAULTS["keep"].items()}
    if not any(conf["keep"].values()):
        conf["keep"] = dict(BACKUP_DEFAULTS["keep"])
    conf["exclude"] = [e for e in conf["exclude"] if isinstance(e, str) and e.strip()] if isinstance(conf["exclude"], list) else []
    skipped = []
    if conf["databases"] is None:
        listed = database_list(config.get("databases"))
        skipped = sorted({d["kind"] for d in listed if d["kind"] not in BACKUP_KINDS})
        conf["databases"] = backup_databases([{d["kind"]: d["target"]} for d in listed if d["kind"] in BACKUP_KINDS])
    else:
        conf["databases"] = backup_databases(conf["databases"])
    conf["skipped"] = skipped
    folders = conf["folders"] if isinstance(conf["folders"], list) else list(config.get("files_roots") or []) + list(config.get("apps") or [])
    seen, kept = set(), []
    for folder in folders:
        if isinstance(folder, str) and os.path.isabs(folder):
            path = os.path.normpath(folder)
            if path not in seen:
                seen.add(path)
                kept.append(path)
    conf["folders"] = kept
    conf["allow_restore"] = conf["allow_restore"] is True
    conf["schedule"] = conf["schedule"] if conf["schedule"] in SCHEDULES else BACKUP_DEFAULTS["schedule"]
    weekday = str(conf["weekday"]).lower()[:3]
    conf["weekday"] = weekday if weekday in WEEKDAYS else BACKUP_DEFAULTS["weekday"]
    conf["temp_dir"] = os.path.normpath(conf["temp_dir"]) if isinstance(conf["temp_dir"], str) and os.path.isabs(conf["temp_dir"]) \
        else config.get("state_dir") or "/var/lib/analytics-agent"
    return conf


def restic_version_of(text):
    match = re.search(r"restic (\d+)\.(\d+)\.(\d+)", text or "")
    return tuple(int(n) for n in match.groups()) if match else None


def shown_repository(repository):
    """The repository's address without a user's password (sftp:, rest: can carry one)."""
    text = re.sub(r"//[^/@\s]*:[^/@\s]*@", "//", repository)
    return re.sub(r"^(sftp:)[^@:/]*:[^@]*@", r"\1", text)[:200]


def s3_location(repository, region=None):
    """{scheme, host, bucket, prefix, region} of an s3: repository, or None."""
    if not repository.startswith("s3:"):
        return None
    rest = repository[3:]
    if not re.match(r"^https?://", rest, re.I):
        rest = "https://" + rest
    parts = urllib.parse.urlsplit(rest)
    path = parts.path.strip("/").split("/", 1)
    if not parts.netloc or not path[0]:
        return None
    if not region:
        host = parts.hostname or ""
        match = re.match(r"^([a-z0-9-]+)\.your-objectstorage\.com$", host) or re.match(r"^s3[.-]([a-z0-9-]+)\.", host)
        region = match.group(1) if match and match.group(1) not in ("amazonaws", "external-1") else "us-east-1"
    return {"scheme": parts.scheme.lower(), "host": parts.netloc, "bucket": path[0],
            "prefix": path[1].strip("/") if len(path) > 1 else "", "region": region}


def _s3_quote(text, safe="-_.~"):
    return urllib.parse.quote(text, safe=safe)


def s3_sign(method, loc, key, query, headers, payload_hash, access, secret, token=None, now=None, presign=0):
    """SigV4 for one request: (url, headers to send). presign: seconds a
    link stays good, signing it in the query instead of the headers."""
    now = now or datetime.now(timezone.utc)
    stamp, day = now.strftime("%Y%m%dT%H%M%SZ"), now.strftime("%Y%m%d")
    scope = "%s/%s/s3/aws4_request" % (day, loc["region"])
    # Path style (/bucket/key), which every S3 lookalike takes; no bucket: virtual style, the host names it.
    path = "/" + "/".join(p for p in (_s3_quote(loc["bucket"]), _s3_quote(key, safe="-_.~/")) if p)
    headers = dict(headers or {}, host=loc["host"])
    query = dict(query or {})
    if presign:
        query.update({"X-Amz-Algorithm": "AWS4-HMAC-SHA256", "X-Amz-Credential": "%s/%s" % (access, scope),
                      "X-Amz-Date": stamp, "X-Amz-Expires": str(presign), "X-Amz-SignedHeaders": "host"})
        if token:
            query["X-Amz-Security-Token"] = token
        headers = {"host": loc["host"]}
        payload_hash = "UNSIGNED-PAYLOAD"
    else:
        headers["x-amz-date"] = stamp
        headers["x-amz-content-sha256"] = payload_hash
        if token:
            headers["x-amz-security-token"] = token
    names = sorted(h.lower() for h in headers)
    values = {h.lower(): " ".join(str(v).split()) for h, v in headers.items()}
    canonical_query = "&".join("%s=%s" % (_s3_quote(k), _s3_quote(str(v))) for k, v in sorted(query.items()))
    canonical = "\n".join([method, path, canonical_query, "".join("%s:%s\n" % (n, values[n]) for n in names),
                           ";".join(names), payload_hash])
    to_sign = "\n".join(["AWS4-HMAC-SHA256", stamp, scope, hashlib.sha256(canonical.encode()).hexdigest()])
    signing = ("AWS4" + secret).encode()
    for part in (day, loc["region"], "s3", "aws4_request"):
        signing = hmac.new(signing, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(signing, to_sign.encode(), hashlib.sha256).hexdigest()
    url = "%s://%s%s" % (loc["scheme"], loc["host"], path)
    if presign:
        return url + "?" + canonical_query + "&X-Amz-Signature=" + signature, {}
    sent = {k: v for k, v in headers.items() if k != "host"}
    sent["Authorization"] = "AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s" % (
        access, scope, ";".join(names), signature)
    return url + ("?" + canonical_query if canonical_query else ""), sent


class S3:
    """The few S3 calls a download needs, signed with the repository's own keys."""

    def __init__(self, loc, env):
        self.loc = loc
        self.access = env.get("AWS_ACCESS_KEY_ID") or os.environ.get("AWS_ACCESS_KEY_ID") or ""
        self.secret = env.get("AWS_SECRET_ACCESS_KEY") or os.environ.get("AWS_SECRET_ACCESS_KEY") or ""
        self.token = env.get("AWS_SESSION_TOKEN") or os.environ.get("AWS_SESSION_TOKEN") or None

    def key(self, name):
        # Beside the repository, never inside it: restic owns everything under its prefix.
        return "/".join(p for p in ("sitegoose-downloads", re.sub(r"[^A-Za-z0-9._-]", "_", self.loc["prefix"]), name) if p)

    def call(self, method, key, query=None, body=b"", headers=None):
        url, sent = s3_sign(method, self.loc, key, query, headers, hashlib.sha256(body).hexdigest(),
                            self.access, self.secret, self.token)
        req = urllib.request.Request(url, data=body if method in ("PUT", "POST") else None, headers=sent, method=method)
        with urllib.request.urlopen(req, timeout=300) as res:
            return {k.lower(): v for k, v in res.headers.items()}, res.read()

    def upload(self, key, chunks, content_type):
        """Uploads the bytes `chunks` yields, in parts; their total size."""
        _, raw = self.call("POST", key, {"uploads": ""}, headers={"content-type": content_type})
        match = re.search(rb"<UploadId>([^<]+)</UploadId>", raw)
        if not match:
            raise RuntimeError("the bucket didn't start the upload")
        upload_id = match.group(1).decode()
        parts, size, buffer = [], 0, bytearray()

        def send(data):
            headers, _ = self.call("PUT", key, {"partNumber": str(len(parts) + 1), "uploadId": upload_id}, body=bytes(data))
            parts.append(headers.get("etag", ""))

        try:
            for chunk in chunks:
                buffer.extend(chunk)
                size += len(chunk)
                while len(buffer) >= BACKUP_PART:
                    send(buffer[:BACKUP_PART])
                    del buffer[:BACKUP_PART]
            if buffer or not parts:
                send(buffer)
            done = "<CompleteMultipartUpload>%s</CompleteMultipartUpload>" % "".join(
                "<Part><PartNumber>%d</PartNumber><ETag>%s</ETag></Part>" % (n + 1, tag) for n, tag in enumerate(parts))
            self.call("POST", key, {"uploadId": upload_id}, body=done.encode())
        except Exception:
            try:
                self.call("DELETE", key, {"uploadId": upload_id})
            except Exception:
                pass
            raise
        return size

    def link(self, key, filename, seconds=BACKUP_LINK_S):
        disposition = 'attachment; filename="%s"' % re.sub(r'[^A-Za-z0-9._-]', "_", filename)
        url, _ = s3_sign("GET", self.loc, key, {"response-content-disposition": disposition}, {}, "",
                         self.access, self.secret, self.token, presign=seconds)
        return url

    def delete(self, key):
        self.call("DELETE", key)


def _proc(args, env=None, stdin=None, stdout=subprocess.PIPE, timeout=BACKUP_QUICK):
    """(exit code, stdout text, stderr's last lines) of a command; code None
    when it couldn't run or timed out (and was killed, with what it started)."""
    try:
        proc = subprocess.Popen(args, stdin=stdin if stdin is not None else subprocess.DEVNULL, stdout=stdout,
                                stderr=subprocess.PIPE, env=env, start_new_session=True)
    except (OSError, ValueError) as error:
        return None, "", str(error)
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        return None, "", "took longer than %d minutes, stopped" % (timeout // 60)
    return proc.returncode, (out or b"").decode("utf-8", "replace"), _tail(err)


def _tail(err):
    lines = [l.strip() for l in (err or b"").decode("utf-8", "replace").splitlines() if l.strip()]
    return " / ".join(lines[-3:])[:BACKUP_ERROR_CHARS]


def _sh_quote(text):
    return "'" + str(text).replace("'", "'\\''") + "'"


# The shell lines that run a database's tools inside its container, as the
# container's own variables say (the official images'). Passwords go through
# the environment or a file the shell writes itself, never a command line `ps`
# would show.
DOCKER_PG = 'U="${POSTGRES_USER:-postgres}"; '
DOCKER_MYSQL = ('P="${MYSQL_ROOT_PASSWORD:-${MARIADB_ROOT_PASSWORD:-}}"; [ -n "$P" ] && export MYSQL_PWD="$P"; '
                'C=$(command -v mariadb || command -v mysql); D=$(command -v mariadb-dump || command -v mysqldump); ')
DOCKER_MONGO = ('F=$(mktemp) || exit 1; trap \'rm -f "$F"\' EXIT; A=""; '
                'if [ -n "${MONGO_INITDB_ROOT_USERNAME:-}" ]; then '
                'printf "password: \'%s\'\\n" "$(printf %s "$MONGO_INITDB_ROOT_PASSWORD" | sed "s/\'/\'\'/g")" > "$F"; '
                'A="--username $MONGO_INITDB_ROOT_USERNAME --authenticationDatabase admin --config $F"; fi; ')


class DumpSource:
    """One database's dumps: what's in it, the command that writes each to
    stdout, and the one that reads it back in."""

    def __init__(self, db, state_dir):
        self.db = db
        self.kind, self.target = db["kind"], db["target"]
        self.state_dir = state_dir
        self.files = []  # temporary option files, removed by close()

    def close(self):
        for path in self.files:
            try:
                os.unlink(path)
            except OSError:
                pass
        self.files = []

    def _docker(self, line, *args, stdin=False):
        return ["docker", "exec"] + (["-i"] if stdin else []) + [self.target[7:], "sh", "-c", line, "sh"] + list(args)

    def _secret_file(self, text, suffix):
        fd, path = tempfile.mkstemp(dir=self.state_dir, prefix="backup-", suffix=suffix)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        self.files.append(path)
        return path

    def env(self):
        """What the dump's commands need in their environment (PostgreSQL's address)."""
        if self.kind != "postgresql" or self.target == "local" or self.target.startswith("docker:"):
            return {}
        parts = urllib.parse.urlsplit(self.target)
        env = {"PGHOST": parts.hostname or "127.0.0.1", "PGPORT": str(parts.port or 5432),
               "PGUSER": urllib.parse.unquote(parts.username or ""), "PGPASSWORD": urllib.parse.unquote(parts.password or ""),
               "PGCONNECT_TIMEOUT": "10"}
        for key, value in urllib.parse.parse_qsl(parts.query):
            if key == "sslmode":
                env["PGSSLMODE"] = value
        return env

    def _pg(self, tool, *args):
        if self.target == "local":
            return (["runuser", "-u", "postgres", "--"] if os.geteuid() == 0 else []) + [tool] + list(args)
        return [tool] + list(args)

    def _mysql_options(self):
        if self.target == "local":
            return []
        parts = urllib.parse.urlsplit(self.target)
        path = self._secret_file("[client]\nhost=%s\nport=%d\nuser=%s\npassword=\"%s\"\n" % (
            parts.hostname or "127.0.0.1", parts.port or 3306, urllib.parse.unquote(parts.username or ""),
            urllib.parse.unquote(parts.password or "").replace("\\", "\\\\").replace('"', '\\"')), ".cnf")
        return ["--defaults-extra-file=" + path]

    def _mongo_options(self):
        return ["--config=" + self._secret_file("uri: %s\n" % json.dumps(self.target), ".yaml")]

    def names(self):
        """The databases in it to dump, or raises RuntimeError saying why not."""
        if self.kind == "sqlite":
            if not os.path.isfile(self.target):
                raise RuntimeError("%s doesn't exist" % self.target)
            return [os.path.basename(self.target)]
        if self.kind == "mongodb":
            return ["all"]
        if self.kind == "postgresql":
            sql = "SELECT datname FROM pg_database WHERE datallowconn AND NOT datistemplate ORDER BY 1"
            if self.target.startswith("docker:"):
                args = self._docker(DOCKER_PG + 'exec psql -X -A -t -U "$U" -d postgres -c "$1"', sql)
            elif self.target == "local":
                args = self._pg("psql", "-X", "-A", "-t", "-d", "postgres", "-c", sql)
            else:
                dbname = urllib.parse.unquote(urllib.parse.urlsplit(self.target).path.strip("/")) or "postgres"
                return [dbname]
        else:
            sql = "SHOW DATABASES"
            if self.target.startswith("docker:"):
                args = self._docker(DOCKER_MYSQL + 'exec "$C" -uroot --batch --skip-column-names -e "$1"', sql)
            else:
                args = [_which(["mariadb", "mysql"]) or "mysql"] + self._mysql_options() + ["--batch", "--skip-column-names", "-e", sql]
        env = dict(os.environ, **self.env())
        code, out, err = _proc(args, env=env)
        if code != 0:
            raise RuntimeError("couldn't list its databases: %s" % (err or "exit %s" % code))
        found = [n.strip() for n in out.splitlines() if DB_NAME.match(n.strip())]
        if self.kind == "mysql":
            found = [n for n in found if n not in MYSQL_SYSTEM]
        if self.db["only"]:
            found = [n for n in found if n in self.db["only"]]
        return found

    def dumps(self):
        """[(file name in the backup, dump command)]."""
        out = []
        names = self.names()
        if self.kind == "postgresql":
            for name in names:
                if self.target.startswith("docker:"):
                    args = self._docker(DOCKER_PG + 'exec pg_dump -Fc -U "$U" "$1"', name)
                else:
                    args = self._pg("pg_dump", "-Fc", "-d", name)
                out.append((name + ".pgdump", args))
            # The accounts and their rights, which pg_dump leaves out.
            if self.target.startswith("docker:"):
                out.append(("_roles.sql", self._docker(DOCKER_PG + 'exec pg_dumpall --globals-only -U "$U"')))
            elif self.target == "local":
                out.append(("_roles.sql", self._pg("pg_dumpall", "--globals-only")))
        elif self.kind == "mysql":
            options = ["--single-transaction", "--quick", "--routines", "--triggers", "--events", "--hex-blob",
                       "--add-drop-database", "--databases"]
            for name in names:
                if self.target.startswith("docker:"):
                    args = self._docker(DOCKER_MYSQL + 'exec "$D" -uroot ' + " ".join(options) + ' "$1"', name)
                else:
                    args = [_which(["mariadb-dump", "mysqldump"]) or "mysqldump"] + self._mysql_options() + options + [name]
                out.append((name + ".sql", args))
        elif self.kind == "mongodb":
            if self.target.startswith("docker:"):
                args = self._docker(DOCKER_MONGO + "mongodump --archive --gzip $A")
            else:
                args = ["mongodump", "--archive", "--gzip", "--quiet"] + self._mongo_options()
            out.append(("all.archive.gz", args))
        else:
            out.append((names[0], [sys.executable, os.path.abspath(__file__), "sqlite-copy", self.target]))
        return out

    def restore_command(self, filename):
        """The command that reads `filename`'s dump from stdin into the database."""
        name = filename.rsplit(".", 1)[0]
        if self.kind == "postgresql" and filename != "_roles.sql" and not DB_NAME.match(name):
            raise RuntimeError("%s: not a database name the agent backs up" % filename)
        if self.kind == "postgresql":
            if filename == "_roles.sql":
                # Accounts that already exist say so and are left as they are.
                if self.target.startswith("docker:"):
                    return self._docker(DOCKER_PG + 'exec psql -X -q -U "$U" -d postgres', stdin=True)
                return self._pg("psql", "-X", "-q", "-d", "postgres")
            exists = name in self.names()
            # One transaction: a restore that fails half way leaves the database as it was.
            options = ["--clean", "--if-exists", "--single-transaction", "--exit-on-error", "-d", name] if exists else \
                ["--create", "--exit-on-error", "-d", "postgres"]
            if self.target.startswith("docker:"):
                return self._docker(DOCKER_PG + 'exec pg_restore -U "$U" ' + " ".join(options[:-2]) + ' -d "$1"',
                                    options[-1], stdin=True)
            return self._pg("pg_restore", *options)
        if self.kind == "mysql":
            if self.target.startswith("docker:"):
                return self._docker(DOCKER_MYSQL + 'exec "$C" -uroot', stdin=True)
            return [_which(["mariadb", "mysql"]) or "mysql"] + self._mysql_options()
        if self.kind == "mongodb":
            if self.target.startswith("docker:"):
                return self._docker(DOCKER_MONGO + "mongorestore --archive --gzip --drop --quiet $A", stdin=True)
            return ["mongorestore", "--archive", "--gzip", "--drop", "--quiet"] + self._mongo_options()
        return [sys.executable, os.path.abspath(__file__), "sqlite-restore", self.target]


def sqlite_copy(path, out):
    """A consistent copy of a live SQLite database, written to `out` (SQLite's
    own backup, which waits for writers rather than copying a torn file)."""
    import sqlite3
    fd, temp = tempfile.mkstemp(prefix="sqlite-", suffix=".db")
    os.close(fd)
    try:
        source = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(path), uri=True, timeout=60)
        target = sqlite3.connect(temp)
        with target:
            source.backup(target)
        source.close()
        target.close()
        with open(temp, "rb") as f:
            shutil.copyfileobj(f, out)
    finally:
        os.unlink(temp)


def sqlite_restore(path, source_file):
    """Writes a copy read from `source_file` into the live database, through
    SQLite, so an app with it open sees the restored rows, not a torn file."""
    import sqlite3
    folder = os.path.dirname(path) or "."
    fd, temp = tempfile.mkstemp(dir=folder, prefix=".sqlite-restore-", suffix=".db")
    try:
        with os.fdopen(fd, "wb") as f:
            shutil.copyfileobj(source_file, f)
        source = sqlite3.connect(temp)
        source.execute("PRAGMA schema_version").fetchone()  # not a database: fails here, before anything is written
        target = sqlite3.connect(path, timeout=60)
        source.backup(target)
        source.close()
        target.close()
    finally:
        try:
            os.unlink(temp)
        except OSError:
            pass


def backup_items(snapshots):
    """restic's snapshots of ours as runs, newest first: [{run, at, trigger,
    items: [{name, kind, snapshot, bytes}]}]."""
    runs = {}
    for snap in snapshots if isinstance(snapshots, list) else []:
        tags = snap.get("tags") or []
        run = next((t[4:] for t in tags if t.startswith("run:")), None)
        if not run or not RUN_ID.match(run):
            continue
        kind = "database" if "kind:database" in tags else "folder"
        paths = snap.get("paths") or [""]
        summary = snap.get("summary") or {}
        trigger = next((t[8:] for t in tags if t in ("trigger:nightly", "trigger:manual", "trigger:before-restore")),
                       "before-restore" if "before-restore" in tags else "nightly")
        entry = runs.setdefault(run, {"run": run, "at": snap.get("time", "")[:19] + "Z", "items": [], "trigger": trigger})
        name = paths[0].lstrip("/") if kind == "database" else paths[0]
        entry["items"].append({"name": name, "kind": kind, "snapshot": snap.get("short_id") or str(snap.get("id", ""))[:8],
                               "id": snap.get("id", ""), "bytes": summary.get("total_bytes_processed")})
    return sorted(runs.values(), key=lambda r: r["run"], reverse=True)


def run_now():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


# ---- Downloads kept for a day in our storage (sdk/protocols/backups.md, "A download") ----
# A download asked for without a bucket of the owner's own goes to our storage
# for a day, encrypted here first so that we can't read it: the dashboard sends
# a public key made by the browser that asked (its private half never leaves
# that browser), a random key encrypts the file, and that key goes back
# wrapped for the public key. The file: "SGDL0001", the chunk size (u32), then
# each chunk of AES-256-CTR ciphertext followed by its HMAC-SHA256 over the
# header, its number (u64), whether it is the last (u8) and the ciphertext, so
# a changed, reordered or cut short file is refused, not saved.
DL_MAGIC = b"SGDL0001"
DL_CHUNK = 4 * 1024 * 1024
DL_TAG = 32
DL_LABELS = (b"sitegoose-download-v1 enc", b"sitegoose-download-v1 mac")
DL_KEY_ENV = "SITEGOOSE_DOWNLOAD_KEY"
DL_MAX_ENV = "SITEGOOSE_DOWNLOAD_MAX"
DL_TOO_BIG = 3  # download-encrypt's exit code past SITEGOOSE_DOWNLOAD_MAX


class AesCtr:
    """AES-256-CTR from the system's OpenSSL (libcrypto 1.1 or 3) through
    ctypes: Python's standard library has no AES. Used only in its own process
    (download-encrypt), so a libcrypto that misbehaves can't take the agent down."""

    def __init__(self, key, iv=bytes(16)):
        import ctypes
        import ctypes.util
        names = [n for n in (ctypes.util.find_library("crypto"), "libcrypto.so.3", "libcrypto.so.1.1", "libcrypto.so") if n]
        lib = None
        for name in names:
            try:
                lib = ctypes.CDLL(name)
                break
            except OSError:
                continue
        if lib is None:
            raise RuntimeError("OpenSSL's libcrypto isn't installed here (the openssl package)")
        lib.EVP_CIPHER_CTX_new.restype = ctypes.c_void_p
        lib.EVP_CIPHER_CTX_new.argtypes = []
        lib.EVP_aes_256_ctr.restype = ctypes.c_void_p
        lib.EVP_aes_256_ctr.argtypes = []
        lib.EVP_EncryptInit_ex.restype = ctypes.c_int
        lib.EVP_EncryptInit_ex.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p]
        lib.EVP_EncryptUpdate.restype = ctypes.c_int
        lib.EVP_EncryptUpdate.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.c_char_p, ctypes.c_int]
        lib.EVP_CIPHER_CTX_free.restype = None
        lib.EVP_CIPHER_CTX_free.argtypes = [ctypes.c_void_p]
        self.ctypes, self.lib = ctypes, lib
        self.ctx = lib.EVP_CIPHER_CTX_new()
        if not self.ctx or lib.EVP_EncryptInit_ex(self.ctx, lib.EVP_aes_256_ctr(), None, key, iv) != 1:
            raise RuntimeError("OpenSSL couldn't start AES-256-CTR")

    def update(self, data):
        out = self.ctypes.create_string_buffer(len(data) + 16)
        size = self.ctypes.c_int(0)
        if self.lib.EVP_EncryptUpdate(self.ctx, out, self.ctypes.byref(size), data, len(data)) != 1:
            raise RuntimeError("OpenSSL failed to encrypt")
        return out.raw[:size.value]

    def close(self):
        if self.ctx:
            self.lib.EVP_CIPHER_CTX_free(self.ctx)
            self.ctx = None


def _size(n):
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1024:
            return "%d %s" % (n, unit) if unit == "bytes" else "%.1f %s" % (n, unit)
        n /= 1024.0
    return "%.1f TB" % n


def download_keys(secret):
    """(encryption key, MAC key) from a download's 32-byte secret."""
    return tuple(hmac.new(secret, label, hashlib.sha256).digest() for label in DL_LABELS)


def _read_full(src, size):
    parts, left = [], size
    while left:
        block = src.read(left)
        if not block:
            break
        parts.append(block)
        left -= len(block)
    return b"".join(parts)


def encrypt_download(src, dst, secret, chunk=DL_CHUNK, limit=None, cipher=None):
    """Reads src to its end, writes the encrypted file to dst; its size.
    Raises OverflowError past `limit` bytes."""
    enc_key, mac_key = download_keys(secret)
    header = DL_MAGIC + chunk.to_bytes(4, "big")
    aes = (cipher or AesCtr)(enc_key)
    dst.write(header)
    written, index = len(header), 0
    try:
        current = _read_full(src, chunk)
        while True:
            following = _read_full(src, chunk) if len(current) == chunk else b""
            last = not following
            sealed = aes.update(current)
            tag = hmac.new(mac_key, header + index.to_bytes(8, "big") + (b"\x01" if last else b"\x00") + sealed, hashlib.sha256).digest()
            written += len(sealed) + DL_TAG
            if limit is not None and written > limit:
                raise OverflowError("over %d bytes" % limit)
            dst.write(sealed)
            dst.write(tag)
            if last:
                return written
            current, index = following, index + 1
    finally:
        aes.close()


def _b64url(text):
    text = str(text)
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def _mgf1(seed, length):
    out, counter = b"", 0
    while len(out) < length:
        out += hashlib.sha256(seed + counter.to_bytes(4, "big")).digest()
        counter += 1
    return out[:length]


def oaep_wrap(public_key, message):
    """RSA-OAEP with SHA-256 (RFC 8017, empty label) of message for a JWK
    public key {kty: "RSA", n, e}, as WebCrypto decrypts it. The browser's own
    key: never one of ours."""
    if not isinstance(public_key, dict) or public_key.get("kty") != "RSA":
        raise RuntimeError("the download's key isn't an RSA public key")
    n, e = int.from_bytes(_b64url(public_key.get("n", "")), "big"), int.from_bytes(_b64url(public_key.get("e", "")), "big")
    if not 2048 <= n.bit_length() <= 4096 or e != 65537:
        raise RuntimeError("the download's key isn't a 2048 to 4096-bit RSA key")
    k, h = (n.bit_length() + 7) // 8, 32
    if len(message) > k - 2 * h - 2:
        raise RuntimeError("too long to wrap")
    block = hashlib.sha256(b"").digest() + b"\x00" * (k - len(message) - 2 * h - 2) + b"\x01" + message
    seed = os.urandom(h)
    masked = bytes(a ^ b for a, b in zip(block, _mgf1(seed, k - h - 1)))
    masked_seed = bytes(a ^ b for a, b in zip(seed, _mgf1(masked, h)))
    return pow(int.from_bytes(b"\x00" + masked_seed + masked, "big"), e, n).to_bytes(k, "big")


def download_encrypt(src, dst):
    """The download-encrypt command: stdin to stdout, the secret in the environment."""
    try:
        secret = bytes.fromhex(os.environ.get(DL_KEY_ENV, ""))
    except ValueError:
        secret = b""
    if len(secret) != 32:
        sys.exit("%s must be 32 bytes in hex" % DL_KEY_ENV)
    limit = int(os.environ[DL_MAX_ENV]) if os.environ.get(DL_MAX_ENV, "").isdigit() else None
    try:
        encrypt_download(src, dst, secret, limit=limit)
    except OverflowError:
        sys.exit(DL_TOO_BIG)
    dst.flush()


def put_part(url, data, timeout=300):
    """One part of an upload to a link the collector signed; its ETag."""
    req = urllib.request.Request(url, data=data, method="PUT", headers={"Content-Length": str(len(data))})
    with urllib.request.urlopen(req, timeout=timeout, context=ssl.create_default_context()) as res:
        return res.headers.get("ETag", "")


class Backups:
    """The nightly backup, the hourly report, and the dashboard's requests
    (a download, a restore), on a thread of its own: a backup takes as long as
    it takes and must never hold up the firewall."""

    def __init__(self, config):
        self.config = config
        self.conf = backup_config(config)
        self.state_path = os.path.join(config["state_dir"], BACKUP_STATE)
        self.state = {}
        try:
            with open(self.state_path) as f:
                self.state = json.load(f)
        except (OSError, ValueError):
            pass
        self.lock = threading.Lock()
        self.thread = None
        self.next_report = self.next_requests = 0
        self.runs = None  # restic's runs, read fresh after each change

    def save(self):
        write_file(self.state_path, json.dumps(self.state))

    # -- restic --

    def env(self):
        env = dict(os.environ, **self.conf["env"])
        env.pop("RESTIC_PASSWORD", None)
        env.pop("RESTIC_PASSWORD_COMMAND", None)
        env.update({"RESTIC_REPOSITORY": self.conf["repository"], "RESTIC_PASSWORD_FILE": self.conf["password_file"],
                    "RESTIC_CACHE_DIR": os.path.join(self.config["state_dir"], "restic-cache"), "RESTIC_PROGRESS_FPS": "0.0167"})
        return env

    def restic(self, *args, timeout=BACKUP_QUICK, env=None, stdout=subprocess.PIPE, stdin=None):
        binary = RESTIC_BIN if os.access(RESTIC_BIN, os.X_OK) else (_which(["restic"]) or "restic")
        return _proc([binary] + list(args), env=dict(self.env(), **(env or {})), timeout=timeout, stdout=stdout, stdin=stdin)

    def setup_problem(self):
        """(code, text) of what stops backups running, or None."""
        code, out, _ = self.restic("version")
        version = restic_version_of(out) if code == 0 else None
        if not version:
            return "restic_missing", "restic isn't installed: run `analytics-agent backup-setup`"
        if version[:2] < RESTIC_MIN:
            return "restic_old", "restic %s is too old (0.17 or later): run `analytics-agent backup-setup`" % ".".join(map(str, version))
        if not os.path.isfile(self.conf["password_file"]):
            return "no_password", "no password file at %s: run `analytics-agent backup-setup`" % self.conf["password_file"]
        code, _, err = self.restic("cat", "config")
        if code == 10:
            code, _, err = self.restic("init")
            if code == 0:
                log("backups: new repository made at", shown_repository(self.conf["repository"]))
                return None
        if code == 12:
            return "wrong_password", "the password file doesn't open this repository"
        if code != 0:
            return "repository", "can't reach the repository: %s" % (err or "exit %s" % code)
        return None

    def restic_version(self):
        code, out, _ = self.restic("version")
        version = restic_version_of(out) if code == 0 else None
        return ".".join(map(str, version)) if version else None

    def read_runs(self):
        code, out, err = self.restic("snapshots", "--json", "--tag", BACKUP_TAG)
        if code != 0:
            raise RuntimeError("couldn't list the backups: %s" % (err or "exit %s" % code))
        try:
            self.runs = backup_items(json.loads(out or "[]"))
        except ValueError:
            raise RuntimeError("restic's list of backups couldn't be read")
        return self.runs

    def _summary(self, out):
        for line in reversed(out.splitlines()):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and row.get("message_type") == "summary":
                return row
        return {}

    # -- backing up --

    def back_up(self, trigger="nightly", only=None):
        """One run: every database's dumps and every folder (or the items in
        `only`, by name). Returns the run's record, also kept as the last."""
        with self.lock:
            started = datetime.now(timezone.utc)
            run = run_now()
            record = {"run": run, "trigger": trigger, "started_at": iso(started.timestamp()), "items": [], "error": ""}
            problem = self.setup_problem()
            if problem:
                record.update(state="failed", error=problem[1], setup=problem[0])
            else:
                tags = ["--tag", BACKUP_TAG, "--tag", "run:" + run, "--tag", "trigger:" + trigger] + (["--tag", "before-restore"] if trigger == "before-restore" else [])
                for db in self.conf["databases"]:
                    record["items"] += self._dump(db, tags, only)
                for folder in self.conf["folders"]:
                    if only is None or folder in only:
                        record["items"].append(self._folder(folder, tags))
                failed = [i for i in record["items"] if not i["ok"]]
                if not record["items"]:
                    record.update(state="failed", error="nothing to back up: list databases or folders under \"backups\"")
                else:
                    record["state"] = "ok" if not failed else "failed" if len(failed) == len(record["items"]) else "partial"
                if trigger == "nightly" and record["items"]:
                    # Pruning rewrites the storage, so once a week, with the check.
                    weekly = time.time() - (self.state.get("pruned_at") or 0) >= BACKUP_PRUNE_EVERY
                    record["forget"] = self._forget(prune=weekly)
                    if weekly:
                        self.state["check"] = self._check()
                        self.state["pruned_at"] = time.time()
            record["finished_at"] = iso(time.time())
            if trigger != "before-restore":
                self.state["last"] = record
            if trigger == "nightly":
                self.state["last_day"] = time.strftime("%Y-%m-%d")
            self.save()
            log("backups: %s %s, %d part(s)%s" % (trigger, record["state"], len(record["items"]),
                ", " + record["error"] if record["error"] else ""))
            return record

    def _dump(self, db, tags, only):
        source = DumpSource(db, self.config["state_dir"])
        items = []
        try:
            dumps = source.dumps()
        except RuntimeError as error:
            source.close()
            return [{"kind": "database", "name": db["label"], "ok": False, "error": str(error)}]
        try:
            for filename, command in dumps:
                name = "%s/%s" % (self.item_prefix(db), filename)
                if only is not None and name not in only:
                    continue
                began = time.time()
                code, out, err = self.restic(
                    "backup", "--json", "--host", socket.gethostname()[:100], "--stdin-filename", name,
                    *(tags + ["--tag", "kind:database", "--stdin-from-command", "--"] + command),
                    timeout=BACKUP_TIMEOUT, env=source.env())
                summary = self._summary(out) if code == 0 else {}
                items.append({"kind": "database", "name": name, "ok": code == 0, "seconds": round(time.time() - began),
                              "bytes": summary.get("total_bytes_processed"), "added": summary.get("data_added"),
                              "error": "" if code == 0 else (err or "exit %s" % code)})
        finally:
            source.close()
        return items

    @staticmethod
    def item_prefix(db):
        if db["kind"] == "sqlite":
            return "sqlite" + os.path.dirname(db["target"])
        where = db["target"][7:] if db["target"].startswith("docker:") else "local" if db["target"] == "local" else \
            (urllib.parse.urlsplit(db["target"]).hostname or "remote")
        return "%s/%s" % (db["kind"], re.sub(r"[^A-Za-z0-9_.-]", "_", where))

    def _folder(self, folder, tags):
        if not os.path.isdir(folder):
            return {"kind": "folder", "name": folder, "ok": False, "missing": True, "error": "the folder doesn't exist"}
        began = time.time()
        excludes = []
        for pattern in self.conf["exclude"]:
            excludes += ["--exclude", pattern]
        code, out, err = self.restic("backup", "--json", "--host", socket.gethostname()[:100],
                                     *(tags + ["--tag", "kind:folder"] + excludes + ["--", folder]), timeout=BACKUP_TIMEOUT)
        # 3: some files couldn't be read (one locked or removed while read): the
        # snapshot is there, with the rest.
        summary = self._summary(out) if code in (0, 3) else {}
        return {"kind": "folder", "name": folder, "ok": code in (0, 3), "seconds": round(time.time() - began),
                "bytes": summary.get("total_bytes_processed"), "added": summary.get("data_added"),
                "error": "" if code == 0 else ("some files couldn't be read: " if code == 3 else "") + (err or "exit %s" % code)}

    def _forget(self, prune=False):
        keep = self.conf["keep"]
        args = ["forget", "--tag", BACKUP_TAG, "--keep-daily", str(keep["daily"]), "--keep-weekly", str(keep["weekly"]),
                "--keep-monthly", str(keep["monthly"])]
        if prune:
            args.append("--prune")
        code, _, err = self.restic(*args, timeout=BACKUP_TIMEOUT)
        return "" if code == 0 else (err or "exit %s" % code)

    def _check(self):
        # A twentieth of the data read back each week: every copy is read within months, at little cost.
        code, _, err = self.restic("check", "--read-data-subset=5%", timeout=BACKUP_TIMEOUT)
        return {"at": iso(time.time()), "ok": code == 0, "error": "" if code == 0 else (err or "exit %s" % code)}

    # -- the report --

    def report(self):
        runs, problem, repo_bytes = [], None, None
        if not self.conf:
            return False
        problem = self.setup_problem()
        if not problem:
            try:
                runs = self.read_runs()
            except RuntimeError as error:
                problem = ("repository", str(error))
            code, out, _ = self.restic("stats", "--json", "--mode", "raw-data")
            try:
                repo_bytes = json.loads(out).get("total_size") if code == 0 else None
            except (ValueError, AttributeError):
                repo_bytes = None
        loc = s3_location(self.conf["repository"], self.conf["region"])
        plan = self.schedule()
        body = {
            "v": PROTOCOL, "site_id": self.config["site_id"], "host": socket.gethostname()[:100], "client": "vps-agent/%s" % VERSION,
            "restic": self.restic_version(), "setup": problem[0] if problem else None, "setup_detail": problem[1] if problem else "",
            "settings": {
                "repository": shown_repository(self.conf["repository"]), "at": plan["at"], "schedule": plan["schedule"],
                "weekday": plan["weekday"], "schedule_from": plan["from"],
                # A folder on this server: gone with it, so the page says so.
                "local": self.conf["repository"].startswith(("/", "local:")),
                "timezone": time.strftime("%z"), "keep": self.conf["keep"], "allow_restore": self.conf["allow_restore"],
                "can_download": bool(loc), "folders": self.conf["folders"],
                "databases": [d["label"] for d in self.conf["databases"]], "skipped": self.conf["skipped"],
            },
            "last": self.state.get("last"), "check": self.state.get("check"),
            "runs": [{k: v for k, v in r.items()} for r in runs[:BACKUP_RUNS_SENT]], "repo_bytes": repo_bytes,
        }
        for run in body["runs"]:
            run["items"] = [{k: v for k, v in item.items() if k != "id"} for item in run["items"]]
        status, _, _ = request(self.config, "POST", "/events/backups", body=body)
        if status not in (200, 202):
            log("collector answered %s to the backups report" % status)
        return status in (200, 202)

    # -- the dashboard's requests --

    def poll(self):
        status, _, raw = request(self.config, "GET", "/events/backups/requests?site_id=%s&host=%s" % (
            self.config["site_id"], urllib.parse.quote(socket.gethostname()[:100])))
        if status != 200:
            return
        try:
            answer = json.loads(raw or b"{}")
            wanted = answer.get("requests") or []
        except (ValueError, AttributeError):
            return
        # The schedule set on the dashboard (null: none, the config's).
        if "schedule" in answer and answer["schedule"] != self.state.get("schedule"):
            self.state["schedule"] = answer["schedule"] if isinstance(answer["schedule"], dict) else None
            self.save()
            self.next_report = 0
        for ask in wanted[:5]:
            if not isinstance(ask, dict) or not isinstance(ask.get("id"), str):
                continue
            self.answer(ask["id"], "running")
            hosted = ask.get("hosted") if isinstance(ask.get("hosted"), dict) else None
            try:
                if ask.get("kind") == "download":
                    names = [str(ask["item"])] if ask.get("item") else [str(i) for i in ask.get("items") or []][:200]
                    result = self.download(str(ask.get("run", "")), names, hosted, ask["id"])
                elif ask.get("kind") == "backup":
                    record = self.back_up("manual")
                    result = {"run": record["run"], "steps": ["backed up: %s" % record["state"]]}
                    if ask.get("download"):
                        if record["state"] == "failed":
                            raise RuntimeError("the backup failed, so there is nothing to download: %s" % (
                                record["error"] or "; ".join("%s: %s" % (i["name"], i["error"]) for i in record["items"] if not i["ok"])))
                        result.update(self.download(record["run"], [], hosted, ask["id"]))
                elif ask.get("kind") == "restore":
                    if not self.conf["allow_restore"]:
                        raise RuntimeError("restoring from the dashboard is off on this server: set \"allow_restore\": true "
                                           "under \"backups\" in %s, or run `analytics-agent restore` there" % CONFIG_FILE)
                    result = self.restore(str(ask.get("run", "")), [str(i) for i in ask.get("items") or []][:100], ask["id"])
                else:
                    raise RuntimeError("unknown request")
                self.answer(ask["id"], "done", **result)
            except Exception as error:
                self.answer(ask["id"], "failed", error=str(error)[:BACKUP_ERROR_CHARS])
            self.next_report = 0

    def answer(self, request_id, state, **fields):
        body = dict(fields, site_id=self.config["site_id"], host=socket.gethostname()[:100], id=request_id, state=state)
        status, _, _ = request(self.config, "POST", "/events/backups/requests", body=body)
        if status not in (200, 202):
            log("collector answered %s to a backup request's %s" % (status, state))

    def find(self, run, names=None):
        if not RUN_ID.match(run):
            raise RuntimeError("no such backup")
        runs = self.read_runs()
        found = next((r for r in runs if r["run"] == run), None)
        if not found:
            raise RuntimeError("that backup isn't in the repository any more")
        items = [i for i in found["items"] if not names or i["name"] in names]
        if names and len(items) != len(set(names)):
            raise RuntimeError("that backup doesn't have %s" % ", ".join(sorted(set(names) - {i["name"] for i in items})))
        return found, items

    def dump_stream(self, item):
        """restic dump of one item: a tar of a folder, a database's own file."""
        binary = RESTIC_BIN if os.access(RESTIC_BIN, os.X_OK) else (_which(["restic"]) or "restic")
        args = [binary, "dump"] + (["--archive", "tar", item["id"], item["name"]] if item["kind"] == "folder"
                                   else [item["id"], "/" + item["name"]])
        # stderr to a file: a pipe nobody reads until the end could fill and stall it.
        err = tempfile.TemporaryFile()
        proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=err,
                                env=self.env(), start_new_session=True)
        proc.err_file = err
        return proc

    @staticmethod
    def finish(proc):
        """Waits for a dump_stream; its stderr's last lines."""
        proc.stdout.close()
        proc.wait()
        proc.err_file.seek(0)
        err = _tail(proc.err_file.read())
        proc.err_file.close()
        return err

    @staticmethod
    def download_name(run, items):
        """shop-20261107.tar.gz, shop-20261107.pgdump.gz, all-20261107.archive.gz;
        several parts: web-1-20261107.zip."""
        if len(items) != 1:
            return "%s-%s.zip" % (re.sub(r"[^A-Za-z0-9._-]+", "-", socket.gethostname()[:60]).strip("-") or "server", run[:8])
        item = items[0]
        base = re.sub(r"[^A-Za-z0-9._-]+", "-", os.path.basename(item["name"].rstrip("/")) or "backup").strip("-")
        stem, dot, ending = base.partition(".")
        return "%s-%s%s%s%s" % (stem, run[:8], dot, ending, ".tar.gz" if item["kind"] == "folder" else "" if base.endswith(".gz") else ".gz")

    @staticmethod
    def member_name(item):
        """A part's name inside a run's zip: a folder as its tar, a dump as its own name."""
        if item["kind"] == "folder":
            return (item["name"].strip("/").replace("/", "_") or "root") + ".tar"
        return item["name"]

    def _copy_dump(self, item, write, gzip_it=False):
        proc = self.dump_stream(item)
        packer = zlib.compressobj(6, zlib.DEFLATED, 31) if gzip_it else None
        try:
            while True:
                block = proc.stdout.read(1024 * 1024)
                if not block:
                    break
                write(packer.compress(block) if packer else block)
            if packer:
                write(packer.flush())
        except BaseException:
            # The other end gave up part way: restic would wait on a full pipe for ever.
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
            self.finish(proc)
            raise
        err = self.finish(proc)
        if proc.returncode != 0:
            raise RuntimeError("restic couldn't read %s: %s" % (item["name"], err or "exit %s" % proc.returncode))

    def write_package(self, items, out):
        """A download's content into out: one part as its own file, gzipped,
        or several in one zip (written as it goes: out needn't seek)."""
        if len(items) == 1:
            self._copy_dump(items[0], out.write, gzip_it=not (items[0]["kind"] == "database" and items[0]["name"].endswith(".gz")))
            return
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as archive:
            for item in items:
                with archive.open(self.member_name(item), "w", force_zip64=True) as member:
                    self._copy_dump(item, member.write)

    def _room_for(self, items):
        folder = self.conf["temp_dir"]
        os.makedirs(folder, exist_ok=True)
        need = sum(item.get("bytes") or 0 for item in items) + BACKUP_DISK_SPARE
        free = shutil.disk_usage(folder).free
        if free < need:
            raise RuntimeError("making it needs about %s free in %s, and %s is (\"temp_dir\" under \"backups\" puts it elsewhere)" % (
                _size(need), folder, _size(free)))
        return folder

    def download(self, run, names, hosted=None, request_id=None):
        """One part, or several (a run's all when names is empty) in one zip.
        To the owner's bucket with a link for an hour, or, with `hosted`
        ({public_key, max_bytes}), encrypted for the browser that asked and
        put in our storage for a day."""
        loc = None if hosted else s3_location(self.conf["repository"], self.conf["region"])
        if not hosted and not loc:
            raise RuntimeError("a download link needs the backups in an S3 bucket; on the server, "
                               "`analytics-agent export %s PART FILE` writes it to a file" % run)
        with self.lock:
            _, items = self.find(run, names or None)
            filename = self.download_name(run, items)
            folder = self._room_for(items)
            if hosted:
                return self._download_hosted(items, filename, hosted, request_id, folder)
            s3 = S3(loc, self.conf["env"])
            key = s3.key("%s-%s" % (os.urandom(8).hex(), filename))
            fd, path = tempfile.mkstemp(dir=folder, prefix="backup-download-")
            try:
                with os.fdopen(fd, "wb") as sink:
                    self.write_package(items, sink)

                def chunks():
                    with open(path, "rb") as f:
                        while True:
                            block = f.read(1024 * 1024)
                            if not block:
                                return
                            yield block

                size = s3.upload(key, chunks(), "application/zip" if len(items) > 1 else "application/gzip")
            finally:
                os.unlink(path)
            self.state.setdefault("downloads", []).append({"key": key, "at": time.time()})
            self.save()
            return {"url": s3.link(key, filename), "expires_at": iso(time.time() + BACKUP_LINK_S), "bytes": size, "filename": filename}

    def _download_hosted(self, items, filename, hosted, request_id, folder):
        secret = os.urandom(32)
        # Wrapped first: a key that won't do is said before an hour of work.
        wrapped = oaep_wrap(hosted.get("public_key"), secret)
        limit = hosted.get("max_bytes") if isinstance(hosted.get("max_bytes"), int) and hosted["max_bytes"] > 0 else None
        if not limit:
            raise RuntimeError("the dashboard didn't say how big a file may be")
        fd, path = tempfile.mkstemp(dir=folder, prefix="backup-download-", suffix=".sgdl")
        err = tempfile.TemporaryFile()
        try:
            with os.fdopen(fd, "wb") as sink:
                env = dict(os.environ, **{DL_KEY_ENV: secret.hex(), DL_MAX_ENV: str(limit)})
                sealer = subprocess.Popen([sys.executable, os.path.abspath(__file__), "download-encrypt"], stdin=subprocess.PIPE,
                                          stdout=sink, stderr=err, env=env, start_new_session=True)
                try:
                    self.write_package(items, sealer.stdin)
                    sealer.stdin.close()
                except BrokenPipeError:
                    pass  # it stopped reading: too big, or failed; its exit code says which
                except BaseException:
                    sealer.kill()
                    raise
                finally:
                    try:
                        sealer.stdin.close()
                    except OSError:
                        pass
                    sealer.wait()
            if sealer.returncode == DL_TOO_BIG:
                raise RuntimeError("it comes to more than the %s a file your plan allows; download its parts one at a time" % _size(limit))
            if sealer.returncode != 0:
                err.seek(0)
                raise RuntimeError("couldn't encrypt it: %s" % (_tail(err.read()) or "exit %s" % sealer.returncode))
            size = os.path.getsize(path)
            self.upload_hosted(request_id, path, size)
        finally:
            err.close()
            os.unlink(path)
        return {"hosted": True, "wrapped_key": base64.b64encode(wrapped).decode(), "bytes": size, "filename": filename}

    def upload_hosted(self, request_id, path, size):
        """The encrypted file to our storage, in parts, through links the collector signs."""
        host = socket.gethostname()[:100]
        status, _, raw = request(self.config, "POST", "/events/backups/upload",
                                 body={"site_id": self.config["site_id"], "host": host, "id": request_id, "bytes": size})
        try:
            answer = json.loads(raw or b"{}")
        except ValueError:
            answer = {}
        if status != 200:
            raise RuntimeError(answer.get("error") or "the collector answered %s to the upload" % status)
        part_size = answer.get("part_size")
        parts = answer.get("parts") if isinstance(answer.get("parts"), list) else []
        if not isinstance(part_size, int) or part_size <= 0 or not parts:
            raise RuntimeError("the collector didn't say where to upload it")
        done = []
        with open(path, "rb") as f:
            for part in parts:
                data = f.read(part_size)
                for attempt in range(3):
                    try:
                        done.append({"n": part["n"], "etag": put_part(part["url"], data)})
                        break
                    except (OSError, ValueError, KeyError) as error:
                        if attempt == 2:
                            raise RuntimeError("the upload failed: %s" % error)
                        time.sleep(5 * (attempt + 1))
        status, _, raw = request(self.config, "POST", "/events/backups/upload/done",
                                 body={"site_id": self.config["site_id"], "host": host, "id": request_id, "parts": done})
        if status != 200:
            try:
                why = json.loads(raw or b"{}").get("error")
            except (ValueError, AttributeError):
                why = None
            raise RuntimeError(why or "the collector answered %s when the upload finished" % status)

    def export(self, run, name, path):
        """The same file, written on this server instead (the CLI)."""
        _, items = self.find(run, [name])
        proc = self.dump_stream(items[0])
        with open(path, "wb") as f:
            shutil.copyfileobj(proc.stdout, f)
        err = self.finish(proc)
        if proc.returncode != 0:
            raise RuntimeError(err or "exit %s" % proc.returncode)

    # -- putting a backup back --

    def _database_of(self, name):
        for db in self.conf["databases"]:
            if name.startswith(self.item_prefix(db) + "/"):
                return db
        return None

    def _put_back(self, item, request_id, done):
        """Puts one item back, recording in `done` how to undo it."""
        if item["kind"] == "folder":
            folder = os.path.normpath(item["name"])
            if folder in SYSTEM_FOLDERS or folder.count("/") < 2:
                raise RuntimeError("%s is a system folder, never swapped whole: `analytics-agent restore %s %s --into /some/folder` "
                                   "gets it out to copy from" % (folder, "RUN", folder))
            if os.path.ismount(folder):
                raise RuntimeError("%s is a mount point; restore it with --into and copy it over" % folder)
            parent, base = os.path.dirname(folder), os.path.basename(folder)
            staging = os.path.join(parent, ".sitegoose-restore-%s-%s" % (request_id[:12], base))
            aside = os.path.join(parent, ".sitegoose-before-%s-%s" % (request_id[:12], base))
            code, _, err = self.restic("restore", "%s:%s" % (item["id"], folder), "--target", staging, timeout=BACKUP_TIMEOUT)
            if code != 0:
                shutil.rmtree(staging, ignore_errors=True)
                raise RuntimeError("%s: restic couldn't restore it: %s" % (folder, err or "exit %s" % code))
            if os.path.exists(folder):
                os.rename(folder, aside)
            os.rename(staging, folder)
            done.append({"kind": "folder", "folder": folder, "aside": aside if os.path.exists(aside) else None})
            return
        db = self._database_of(item["name"])
        if not db:
            raise RuntimeError("%s: that database isn't under \"backups\" in the config any more" % item["name"])
        source = DumpSource(db, self.config["state_dir"])
        try:
            command = source.restore_command(item["name"].rsplit("/", 1)[1])
            dump = self.dump_stream(item)
            code, _, err = _proc(command, env=dict(os.environ, **source.env()), stdin=dump.stdout, timeout=BACKUP_TIMEOUT)
            if code is None:
                try:
                    os.killpg(dump.pid, signal.SIGKILL)
                except OSError:
                    pass
            dump_err = self.finish(dump)
        finally:
            source.close()
        done.append({"kind": "database", "name": item["name"]})
        if dump.returncode != 0:
            raise RuntimeError("%s: restic couldn't read it: %s" % (item["name"], dump_err or "exit %s" % dump.returncode))
        if code != 0:
            raise RuntimeError("%s: %s" % (item["name"], err or "exit %s" % code))

    def _services_up(self):
        try:
            return {c["name"] for c in Services(self.config).run_checks() if c["ok"]}
        except Exception:
            return set()

    def _pause(self, minutes, note=None):
        body = {"site_id": self.config["site_id"]}
        body.update({"minutes": minutes, "note": note} if minutes else {"end": True})
        status, _, _ = request(self.config, "POST", "/events/maintenance", body=body)
        return status == 200

    def restore(self, run, names, request_id):
        """Puts the run's items (all when `names` is empty) back. Returns
        {steps, aside}; raises with what went wrong, after undoing it."""
        with self.lock:
            _, items = self.find(run, names or None)
        if not items:
            raise RuntimeError("that backup has nothing to restore")
        steps = []
        paused = self._pause(RESTORE_PAUSE_MINUTES, "Restoring the backup of %s" % run)
        steps.append("alerts paused" if paused else "alerts couldn't be paused")
        try:
            safety = self.back_up("before-restore", only=[i["name"] for i in items])
            # A folder that is gone has nothing to copy: putting it back is the point.
            failed = [i for i in safety["items"] if not i["ok"] and not i.get("missing")]
            if safety.get("setup") or failed:
                raise RuntimeError("nothing was changed: the copy of how things are now failed (%s)" % (
                    safety["error"] or "; ".join("%s: %s" % (i["name"], i["error"]) for i in failed)))
            steps.append("copied how things are now, as backup %s" % safety["run"])
            before = self._services_up()
            done = []
            try:
                with self.lock:
                    for item in items:
                        self._put_back(item, request_id, done)
                        steps.append("put back " + item["name"])
                down = set()
                for _ in range(BACKUP_HEALTH_WAIT // 10):
                    time.sleep(10)
                    down = before - self._services_up()
                    if not down:
                        break
                if down:
                    raise RuntimeError("%s stopped after the restore" % ", ".join(sorted(down)))
            except Exception as error:
                steps.append("failed: %s" % error)
                undone = self._undo(done, safety["run"], request_id)
                raise RuntimeError("%s. %s" % (error, undone))
            aside = [d["aside"] for d in done if d.get("aside")]
            if aside:
                self.state.setdefault("aside", []).extend({"path": p, "at": time.time()} for p in aside)
                self.save()
            steps.append("services running as before")
            return {"steps": steps, "aside": aside, "safety_run": safety["run"]}
        finally:
            if paused:
                self._pause(0)

    def _undo(self, done, safety_run, request_id):
        problems = []
        databases = [d["name"] for d in done if d["kind"] == "database"]
        for entry in reversed(done):
            if entry["kind"] != "folder":
                continue
            try:
                failed = entry["folder"] + ".sitegoose-failed-" + request_id[:12]
                os.rename(entry["folder"], failed)
                if entry["aside"]:
                    os.rename(entry["aside"], entry["folder"])
                shutil.rmtree(failed, ignore_errors=True)
            except OSError as error:
                problems.append("%s: %s" % (entry["folder"], error))
        if databases:
            try:
                with self.lock:
                    _, items = self.find(safety_run, databases)
                    for item in items:
                        self._put_back(item, request_id + "-undo", [])
            except Exception as error:
                problems.append("databases: %s" % error)
        if problems:
            return "Undoing it failed too (%s): backup %s has them as they were" % ("; ".join(problems), safety_run)
        return "Everything was put back as it was"

    # -- the thread --

    def cleanup(self, now):
        keep = []
        for entry in self.state.get("downloads") or []:
            if now - entry.get("at", 0) < BACKUP_EXPORT_KEEP:
                keep.append(entry)
                continue
            loc = s3_location(self.conf["repository"], self.conf["region"])
            try:
                if loc:
                    S3(loc, self.conf["env"]).delete(entry["key"])
            except Exception as error:
                log("backups: an old download couldn't be deleted:", error)
                keep.append(entry)
        aside = []
        for entry in self.state.get("aside") or []:
            if now - entry.get("at", 0) < BACKUP_ASIDE_KEEP:
                aside.append(entry)
            elif ".sitegoose-before-" in os.path.basename(entry.get("path", "")):
                shutil.rmtree(entry["path"], ignore_errors=True)
        # What a killed run left: option files with passwords (DumpSource._secret_file), downloads half made.
        # A temp_dir of the owner's may hold files of theirs: only our downloads there.
        for folder, prefix in {(self.config["state_dir"], "backup-"), (self.conf["temp_dir"], "backup-download-")}:
            for name in os.listdir(folder) if os.path.isdir(folder) else []:
                path = os.path.join(folder, name)
                try:
                    if name.startswith(prefix) and now - os.path.getmtime(path) > 24 * 3600:
                        os.unlink(path)
                except OSError:
                    pass
        if keep != (self.state.get("downloads") or []) or aside != (self.state.get("aside") or []):
            self.state["downloads"], self.state["aside"] = keep, aside
            self.save()

    def schedule(self):
        """When the backups run: what the dashboard set, else the config."""
        wanted = self.state.get("schedule")
        if isinstance(wanted, dict) and wanted.get("schedule") in SCHEDULES:
            return {"schedule": wanted["schedule"], "at": _hhmm(wanted.get("at"), self.conf["at"]),
                    "weekday": wanted.get("weekday") if wanted.get("weekday") in WEEKDAYS else self.conf["weekday"], "from": "dashboard"}
        return {"schedule": self.conf["schedule"], "at": self.conf["at"], "weekday": self.conf["weekday"], "from": "config"}

    def due(self, now=None):
        now = now or time.time()
        plan = self.schedule()
        local = time.localtime(now)
        if plan["schedule"] == "off" or (plan["schedule"] == "weekly" and WEEKDAYS[local.tm_wday] != plan["weekday"]):
            return False
        return time.strftime("%H:%M", local) >= plan["at"] and self.state.get("last_day") != time.strftime("%Y-%m-%d", local)

    def tick(self, now=None):
        now = now or time.time()
        try:
            if now >= self.next_requests:
                self.next_requests = now + BACKUP_REQUESTS_EVERY
                self.poll()
            if self.due(now):
                self.back_up("nightly")
                self.next_report = 0
            if time.time() >= self.next_report:
                self.next_report = time.time() + BACKUP_REPORT_EVERY
                self.report()
            self.cleanup(time.time())
        except Exception as error:
            log("backups round failed:", error)

    def start(self):
        if not self.conf or (self.thread and self.thread.is_alive()):
            return

        def work():
            while not stopping:
                self.tick()
                for _ in range(BACKUP_TICK):
                    if stopping:
                        break
                    time.sleep(1)

        self.thread = threading.Thread(target=work, daemon=True)
        self.thread.start()


def restic_arch():
    machine = os.uname().machine
    return {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64", "i686": "386", "i386": "386",
            "armv7l": "arm", "armv6l": "arm"}.get(machine)


def install_restic():
    """restic RESTIC_VERSION at RESTIC_BIN, from its release, checked against
    the pinned hash. A distribution's package can be too old (Ubuntu 24.04
    has 0.16), hence not that."""
    import bz2
    arch = restic_arch()
    if not arch:
        sys.exit("No restic build for %s: install restic 0.17 or later yourself." % os.uname().machine)
    url = "https://github.com/restic/restic/releases/download/v%s/restic_%s_linux_%s.bz2" % (RESTIC_VERSION, RESTIC_VERSION, arch)
    with urllib.request.urlopen(url, timeout=120) as res:
        packed = res.read()
    if hashlib.sha256(packed).hexdigest() != RESTIC_SHA256[arch]:
        sys.exit("restic's download didn't match its checksum, so it wasn't installed.")
    temp = RESTIC_BIN + ".new"
    with open(temp, "wb") as f:
        f.write(bz2.decompress(packed))
    os.chmod(temp, 0o755)
    os.replace(temp, RESTIC_BIN)


def backup_setup(config):
    conf = backup_config(config)
    if not conf:
        sys.exit('Add a "backups" section with a "repository" to %s first (sdk/protocols/backups.md has examples).' % CONFIG_FILE)
    job = Backups(config)
    version = restic_version_of(job.restic("version")[1])
    if not version or version[:2] < RESTIC_MIN:
        print("Installing restic %s..." % RESTIC_VERSION)
        install_restic()
    print("restic", job.restic_version())
    if not os.path.isfile(conf["password_file"]):
        password = base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("=")
        fd = os.open(conf["password_file"], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(password + "\n")
        print("\nThe backups' password, in %s:\n\n    %s\n" % (conf["password_file"], password))
        print("Keep it in your password manager now. Without it no backup can be read, and if this server is lost,")
        print("so is the copy in that file. Nobody else has it: we can't recover it for you.\n")
    problem = job.setup_problem()
    if problem:
        sys.exit("Not ready: " + problem[1])
    print("Repository ready:", shown_repository(conf["repository"]))
    print("Backs up every night at %s (this server's time). `analytics-agent backup` runs one now." % conf["at"])


def backup_command(config, command, args):
    if command == "backup-setup":
        return backup_setup(config)
    if not backup_config(config):
        sys.exit('Backups are off: add a "backups" section with a "repository" to %s, then `analytics-agent backup-setup`.' % CONFIG_FILE)
    job = Backups(config)
    if command == "backup":
        record = job.back_up("manual")
        print("backup %s: %s%s" % (record["run"], record["state"], ", " + record["error"] if record["error"] else ""))
        for item in record["items"]:
            print("  %-4s %-50s %s" % ("ok" if item["ok"] else "FAIL", item["name"][:50],
                  "%s MB" % round((item.get("bytes") or 0) / 1048576, 1) if item["ok"] else item["error"]))
        job.report()
        return
    if command == "backups":
        for run in job.read_runs():
            print("%s  %s  %s" % (run["run"], run["at"], run["trigger"]))
            for item in run["items"]:
                print("    %-8s %s" % (item["kind"], item["name"]))
        return
    if command == "export":
        if len(args) != 3:
            sys.exit("analytics-agent export RUN PART FILE   (`analytics-agent backups` lists them)")
        job.export(args[0], args[1], args[2])
        print("written to", args[2])
        return
    # restore
    flags = [a for a in args if a.startswith("--")]
    into = None
    if "--into" in args:
        at = args.index("--into")
        if at + 1 >= len(args):
            sys.exit("--into needs a folder")
        into = os.path.abspath(args[at + 1])
        args = args[:at] + args[at + 2:]
    names = [a for a in args[1:] if not a.startswith("--")]
    if not args or args[0].startswith("--"):
        sys.exit("analytics-agent restore RUN [PART...] [--into FOLDER] [--yes]   (`analytics-agent backups` lists them)")
    run = args[0]
    _, items = job.find(run, names or None)
    if into:
        os.makedirs(into, exist_ok=True)
        for item in items:
            if item["kind"] == "folder":
                target = os.path.join(into, item["name"].strip("/").replace("/", "_"))
                code, _, err = job.restic("restore", "%s:%s" % (item["id"], item["name"]), "--target", target, timeout=BACKUP_TIMEOUT)
                if code != 0:
                    sys.exit("%s: %s" % (item["name"], err))
            else:
                target = os.path.join(into, item["name"].replace("/", "_"))
                job.export(run, item["name"], target)
            print("  %s -> %s" % (item["name"], target))
        print("Copied out; nothing live was changed.")
        return
    print("This replaces, on this server, with backup %s:" % run)
    for item in items:
        print("  %-8s %s" % (item["kind"], item["name"]))
    print("How they are now is backed up first, and put back if anything fails.")
    if "--yes" not in flags:
        if not sys.stdin.isatty():
            sys.exit("Add --yes to restore without a terminal to confirm on.")
        if input("Type restore to go on: ").strip() != "restore":
            sys.exit("Nothing was changed.")
    result = job.restore(run, names, "cli" + os.urandom(6).hex())
    for step in result["steps"]:
        print("  " + step)
    for path in result["aside"]:
        print("  the folder as it was is kept a week at " + path)
    job.report()


