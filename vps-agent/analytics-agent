LAYERS = ("kernel", "nginx-lists", "flood", "origin", "nginx", "nginx-limits", "nginx-check", "logs",
          "apache-check", "litespeed-check", "caddy-check", "haproxy-check")
BANS_MAX = 50000  # bans watched at once; the kernel's set holds FLOOD_SET_SIZE
# nft lists an element a second or two past the end worked out from its
# `expires` (whole seconds, read a moment apart): still the same ban.
BAN_SLACK = 3
NGINX_RETRY_EVERY = 60  # seconds between tries at the day's new pass when writing it failed


def valid_ban(key, ban):
    """An entry of flood.json as the agent writes it; anything else is dropped
    on load, or it would raise in every round."""
    number = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    return (isinstance(key, str) and flood_key(key.split("/")[0]) == key and isinstance(ban, dict)
            and ban.get("rule") in ("flood", "rate") and number(ban.get("first")) and number(ban.get("until"))
            and number(ban.get("hits")) and isinstance(ban.get("reported"), bool))


class Agent:
    def __init__(self, config):
        self.config = config
        self.state_file = os.path.join(config["state_dir"], "state.json")
        self.flood_file = os.path.join(config["state_dir"], "flood.json")
        self.etag, self.rules, self.applied, self.counts = "", None, "", {}
        self.p = None  # the plan of the rules in place, for tick()
        self.flood_applied, self.nginx_applied, self.nginx_day = "", "", None
        # What runs here, for X-Firewall-Layers: only what is really in place.
        self.running = dict.fromkeys(LAYERS, False)
        self.nginx_logs, self.nginx_dump_at, self.nginx_note = [], 0, ""
        self.nginx_dump = None  # `nginx -T`'s (files, error logs) at the last look, None if it failed
        self.nginx_owed = False  # a reload failed: the files on disk aren't what nginx runs
        self.nginx_limits_refused = False  # `nginx -t` took the files only without the page limits
        self.nginx_retry_at = 0
        self.tails = {}  # log path: LogTail
        # Bans being watched, so each is reported once: {key: {"rule", "first",
        # "until", "hits", "reported"}}, key as flood_key() gives it.
        self.bans = {}
        self.seen = None  # the origin lock's per-source counters at the last read
        self.flood_read_at = 0
        self.checked, self.checked_at = {}, 0  # browser checks per address, reported every FLOOD_READ_EVERY
        # Requests the site's own nginx limits refused, per address and, past
        # SITE_LIMITED_MAX addresses, per family (4, 6); reported every FLOOD_READ_EVERY.
        self.site_limited, self.site_rest, self.site_limited_at = {}, {4: 0, 6: 0}, 0
        # The page limit from access logs (`logs`) and the checks of other web servers.
        self.access_tails, self.access_paths, self.access_found_at = {}, None, 0
        self.access_counted, self.access_read, self.log_ids, self.log_offsets = set(), set(), {}, {}
        self.limiter, self.exempt, self.exempt_key, self.access_pruned_at = None, Ranges(([], [])), None, 0
        self.access_note = ""
        self.web, self.web_owed, self.web_retry_at, self.check_tails = None, {}, 0, {}
        # Another kernel backend's chains, sets or tables, looked for once a start (until removed).
        self.ipt_cleared, self.ipt_noted = False, False
        try:
            with open(self.state_file) as f:
                saved = json.load(f)
            self.etag, self.rules, self.applied = saved.get("etag", ""), saved.get("rules"), saved.get("applied", "")
            self.flood_applied = saved.get("flood_applied", "")
            self.nginx_owed = saved.get("nginx_owed") is True
            self.running.update({k: v is True for k, v in (saved.get("running") or {}).items() if k in LAYERS})
            self.web_owed = {k: v is True for k, v in (saved.get("web_owed") or {}).items() if k in WEB_CLASSES}
            self.access_read = {x for x in saved.get("access_read") or [] if isinstance(x, str)}
        except (OSError, ValueError, AttributeError):
            pass
        try:
            with open(self.flood_file) as f:
                bans = json.load(f).get("bans") or {}
            self.bans = {k: v for k, v in bans.items() if valid_ban(k, v)}
            self.trim_bans()
        except (OSError, ValueError, AttributeError):
            pass

    def save(self):
        fd, tmp = tempfile.mkstemp(dir=self.config["state_dir"])
        with os.fdopen(fd, "w") as f:
            json.dump({"etag": self.etag, "rules": self.rules, "applied": self.applied,
                       "flood_applied": self.flood_applied, "nginx_owed": self.nginx_owed,
                       "running": self.running, "web_owed": self.web_owed,
                       "access_read": sorted(self.access_read)}, f)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.state_file)

    def save_bans(self):
        fd, tmp = tempfile.mkstemp(dir=self.config["state_dir"])
        with os.fdopen(fd, "w") as f:
            json.dump({"bans": self.bans}, f)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.flood_file)

    def layers(self):
        return [name for name in LAYERS if self.running.get(name)]

    def collect(self):
        """Reports what the counted sets matched since the last look."""
        backend = self.config["backend"]
        if backend not in KERNEL_BACKENDS or not self.rules:
            return
        current = nft_counters() if backend == "nftables" else ipt_counters()
        action = "block" if plan(self.rules)["block"] else "monitor"
        at = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        events = []
        for (name, element), packets in current.items():
            delta = packets - self.counts.get((name, element), 0)
            if delta > 0:
                events.append({"at": at, "ip": element, "rule": name, "action": action,
                               "method": "", "path": "", "user_agent": "", "hits": delta})
        self.counts = current
        if events:
            report(self.config, events)

    def step(self):
        """One round: fetch, apply when changed, report. Returns seconds to wait."""
        rules, etag = fetch_rules(self.config, self.etag, layers=self.layers())
        if rules is not None:
            self.rules, self.etag = rules, etag
        if self.rules is None:
            return RETRY
        p = self.p = plan(self.rules)
        digest = hashlib.sha256(json.dumps([self.config["backend"], self.config["ports"], main_plan(p)], sort_keys=True).encode()).hexdigest()
        backend = self.config["backend"]
        before = (self.applied, self.flood_applied, self.nginx_owed, dict(self.running), dict(self.web_owed))
        if digest == self.applied and backend == "nftables" and not nft_table_present():
            log("the firewall table is gone (reboot or nftables restart?), putting it back")
            self.applied = None
        if digest == self.applied and backend == "iptables" and self.ipt_ready() and not ipt_present(IPT_CHAIN, bool(self.config["ports"])):
            log("the firewall chain is gone (reboot or iptables flush?), putting it back")
            self.applied = None
        if digest != self.applied:
            # Counters start again with the new table: report what's counted first.
            self.collect()
            if backend == "none":
                ok = True
            elif backend == "nftables":
                ok = nft_apply(self.config, p)
            elif backend == "iptables":
                ok = self.ipt_ready() and ipt_apply(self.config, p)
            else:
                ok = self.settle(nginx_apply(self.config, p, self.nginx_owed))
            if ok:
                self.applied = digest
                self.counts = {}
                log("rules in place: %s, %d allowed, %s" % (
                    "blocking" if p["block"] else "monitoring" if p["enabled"] else "off",
                    len(p["allow"][0]) + len(p["allow"][1]),
                    ", ".join("%d %s" % (len(p[n][0]) + len(p[n][1]), n) for n in LISTS)))
        else:
            self.collect()
        self.running["kernel"] = backend in KERNEL_BACKENDS and p["enabled"] and self.applied == digest
        if backend in KERNEL_BACKENDS:
            self.drop_kernel(keep=backend)
            self.flood_step(p)
        else:
            self.drop_kernel()
        if backend != "nginx":
            self.drop_lists()
        # With no firewall, nginx files an earlier run wrote are left doing nothing.
        self.nginx_step(p if backend != "none" else dict(p, flood=None, challenge=None, limits=None))
        self.web_step(p if backend != "none" else dict(p, challenge=None))
        self.access_step(p if backend != "none" else dict(p, flood=None), time.time())
        # The address lists as nginx allow/deny lines (ANALYTICS_BACKEND=nginx):
        # monitor mode writes none, and they do nothing until nginx_file is included.
        self.running["nginx-lists"] = (backend == "nginx" and p["block"] and self.applied == digest
                                       and self.nginx_included(self.config["nginx_file"], time.time()))
        if (self.applied, self.flood_applied, self.nginx_owed, self.running, self.web_owed) != before:
            self.save()
        return max(MIN_SYNC, int(self.rules.get("sync") or RETRY))

    def settle(self, result):
        """Keeps account of a reload owed (nginx_write's None); whether the text is live."""
        if result is None:
            self.nginx_owed = True
        elif result:
            self.nginx_owed = False
        return bool(result)

    def ipt_ready(self):
        """Whether iptables and ipset are here (said once when they aren't, or
        when nftables would be the better fit)."""
        tools = ipt_tools()
        if not self.ipt_noted:
            self.ipt_noted = True
            if not tools:
                log('backend "iptables" needs iptables and ipset (the ipset package): no firewall until both are '
                    "installed and the agent restarted")
            elif tools["mode"] == "nft" and nft_installed():
                log('iptables here is iptables-nft (nftables underneath) and nft is installed: "backend": "nftables" '
                    "in %s fits this server better; iptables is used as asked" % CONFIG_FILE)
            else:
                log("iptables: %s %s" % (tools["mode"], ".".join(str(n) for n in tools["version"])))
        return bool(tools)

    def drop_kernel(self, keep=None):
        """The kernel layers of a backend other than this run's (`keep`, None
        for nginx and none): the tables, chains and sets an earlier run put in
        place (the origin lock included) would stay there, frozen, with nothing
        keeping them up to date or reading them. Removed, if their tools are
        here: nftables' every round, iptables' once a start (until it works)."""
        left = False
        if keep != "iptables" and not self.ipt_cleared:
            self.ipt_cleared = ipt_remove_all("backend %s: removed the iptables chains and ipsets an earlier run left"
                                              % self.config["backend"])
            left = not self.ipt_cleared
        if keep != "nftables" and nft_installed():
            for table in (TABLE, FLOOD_TABLE):
                if not nft_table_present(table):
                    continue
                out = nft("delete", "table", "inet", table)
                if out.returncode == 0:
                    log("backend %s: removed the nftables table %s an earlier run left" % (self.config["backend"], table))
                else:
                    left = left or table == FLOOD_TABLE
                    log("could not remove the nftables table %s:" % table, out.stderr.strip()[:300])
        if keep is None:
            self.flood_applied, self.seen = "", None
            if not left:
                self.running["flood"] = self.running["origin"] = False

    def drop_lists(self):
        """A backend other than nginx: allow/deny lines an earlier run wrote
        would go on blocking, frozen. The file stays, empty, as its include needs."""
        if os.path.exists(self.config["nginx_file"]) and nginx_installed(self.config):
            self.settle(nginx_apply(self.config, NO_LISTS, self.nginx_owed))

    # -- flood: the kernel side

    def flood_step(self, p, now=None):
        now = time.time() if now is None else now
        ipt = self.config["backend"] == "iptables"
        if ipt and not self.ipt_ready():
            self.flood_applied, self.seen = "", None
            self.running["flood"] = self.running["origin"] = False
            return
        apply = ipt_flood_apply if ipt else flood_apply
        if not p["flood"] and not p["origin"]:
            # Looked at every round, not only on a change: a run that died
            # after putting the table in place but before saving would
            # otherwise leave it there for ever.
            if apply(self.config, p):
                self.flood_applied, self.seen = "", None
                self.running["flood"] = self.running["origin"] = False
            return
        digest = self.flood_digest(p)
        ports = bool(self.config["ports"])
        present = ipt_present(IPT_FLOOD_CHAIN, ports) if ipt else nft_table_present(FLOOD_TABLE)
        if digest == self.flood_applied and present:
            return
        if digest == self.flood_applied:
            log("the flood %s is gone (reboot or %s restart?), putting it back" % (
                ("chain", "iptables") if ipt else ("table", "nftables")))
        applied = apply(self.config, p)
        if applied:
            # Again: what this kernel takes (IPT_CAPS) may have changed what was put in place.
            self.flood_applied = self.flood_digest(p)
            # iptables meters new connections in block mode only (a full meter drops).
            rate = p["flood"] and p["flood"]["conn_rate"] and (ipt_counts_rate(p) if ipt else True)
            self.running["flood"] = bool(p["flood"] and (rate or p["flood"]["conn_max"]))
            self.running["origin"] = bool(p["origin"])
            f = p["flood"]
            log("flood protection in place: %s%s%s" % (
                "blocking" if p["block"] else "monitoring",
                ", %s new connections a second and %s open per address, banned %ds" % (
                    f["conn_rate"] or "any", f["conn_max"] or "any", f["ban"]) if f else "",
                ", web ports for %d origin ranges only" % (len(p["origin"]["only"][0]) + len(p["origin"]["only"][1]))
                if p["origin"] else ""))
            if f and (applied == "fresh" or not present):
                self.restore_bans(now)
        elif not (ipt_present(IPT_FLOOD_CHAIN, ports) if ipt else nft_table_present(FLOOD_TABLE)):
            self.running["flood"] = self.running["origin"] = False

    def flood_digest(self, p):
        text = ipt_flood_text(self.config, p) if self.config["backend"] == "iptables" else flood_ruleset(self.config, p)
        return hashlib.sha256(text.encode()).hexdigest()

    def kernel_ban(self, timeouts):
        """Bans flood keys in the kernel's ban set, whichever backend holds it."""
        return ipt_ban(timeouts) if self.config["backend"] == "iptables" else nft_ban(timeouts)

    def kernel_elements(self, name):
        """{element: (packets, seconds left)} of the ban or seen set ("ban4", "seen6"...)."""
        return ipt_elements(name) if self.config["backend"] == "iptables" else flood_elements(name)

    def restore_bans(self, now):
        """A table just made (a reboot, an nftables restart, one started over)
        has no bans: the ones still running go back for the time they have left."""
        left = {key: int(ban["until"] - now) for key, ban in self.bans.items() if ban["until"] - now >= 1}
        if left:
            self.kernel_ban(left)
            log("%d ban%s put back in the kernel" % (len(left), "" if len(left) == 1 else "s"))

    def trim_bans(self):
        """At most BANS_MAX watched: past that the ones ending soonest are let go."""
        over = len(self.bans) - BANS_MAX
        if over > 0:
            for key in sorted(self.bans, key=lambda k: self.bans[k]["until"])[:over]:
                del self.bans[key]

    def kernel_bans(self):
        """Whether the flood table's ban set is there to put nginx's bans in."""
        return bool(self.flood_applied) and bool(self.p and self.p["flood"])

    def read_kernel(self, p, now):
        """The ban set (bans to report once each) and the origin lock's counters."""
        self.flood_read_at = now + FLOOD_READ_EVERY
        events = []
        if self.kernel_bans():
            present, ends = {}, []
            for family in "46":
                for value, (packets, expires) in self.kernel_elements("ban" + family).items():
                    key = flood_key(value)
                    if key:
                        present[key] = (packets, expires)
            for key, (packets, expires) in list(present.items()):
                ban = self.bans.get(key)
                if expires <= 0 and self.config["backend"] == "iptables":
                    # No time on it: a kernel whose SET target can't give one
                    # (IPT_CAPS). It lasts `ban` from when it was first read,
                    # and the agent ends it (here, or in due_bans).
                    if ban is not None and ban["until"] <= now:
                        ends.append(key)
                        del present[key]
                        continue
                    until = ban["until"] if ban is not None else now + p["flood"]["ban"]
                else:
                    until = now + expires
                # A new ban, or the address banned again after the last one ran
                # out (an element still listed a moment past its end isn't).
                if ban is None or (ban["until"] <= now and until > ban["until"] + BAN_SLACK):
                    ban = self.bans[key] = {"rule": "flood", "first": now, "until": until, "hits": 0, "reported": False}
                if ban["rule"] == "flood":
                    # max: a ban put back after a restart starts its counter again.
                    ban["hits"] = max(ban["hits"], packets)
                ban["kernel"] = True
                if expires <= 0 and self.config["backend"] == "iptables":
                    ban["forever"] = True
            if ends:
                ipt_unban(ends)
            for key, ban in self.bans.items():
                if ban.get("kernel") and key not in present:
                    ban["until"] = min(ban["until"], now)  # over (or the table was started over)
            self.trim_bans()
        if p["origin"] and self.flood_applied:
            current = {}
            for family in "46":
                for value, (packets, _) in self.kernel_elements("seen" + family).items():
                    key = flood_key(value)
                    if key:
                        current[key] = packets
            if self.seen is not None:
                rows = []
                for key, packets in current.items():
                    last = self.seen.get(key, 0)
                    # A counter lower than last time is a new entry: all of it is new.
                    delta = packets - last if packets >= last else packets
                    if delta > 0:
                        rows.append((delta, key))
                rows.sort(reverse=True)
                action = "block" if p["block"] else "monitor"
                at = iso(now)
                events += [{"at": at, "ip": key, "rule": "origin", "action": action, "method": "", "path": "",
                            "user_agent": "", "hits": delta} for delta, key in rows[:ORIGIN_MAX_ROWS]]
            # The first read after a start is the baseline: what came before was reported then.
            self.seen = current
        return events

    def due_bans(self, p, now):
        """Each ban once: BAN_REPORT_AFTER after it started, or when it ends if sooner."""
        action = "block" if p["block"] else "monitor"
        events, changed, ends = [], False, []
        for key, ban in list(self.bans.items()):
            over = ban["until"] <= now
            if over and ban.get("forever"):
                ends.append(key)  # a kernel ban with no time of its own: ended by the agent
                ban["forever"], changed = False, True
            if not ban["reported"] and (over or now - ban["first"] >= BAN_REPORT_AFTER):
                events.append({"at": iso(ban["first"]), "ip": key, "rule": ban["rule"], "action": action,
                               "method": "", "path": "", "user_agent": "", "hits": max(1, int(ban["hits"]))})
                ban["reported"], changed = True, True
            # Kept BAN_SLACK longer, so the kernel listing it a moment late isn't a second ban.
            if ban["until"] + BAN_SLACK <= now:
                del self.bans[key]
                changed = True
        if ends and self.config["backend"] == "iptables":
            ipt_unban(ends)
        if changed:
            self.save_bans()
        return events

    # -- nginx

    def nginx_step(self, p, now=None):
        """Writes the two nginx files when they change (and each new day while
        the browser check is on), and finds out what nginx really runs."""
        now = time.time() if now is None else now
        config = self.config
        wanted = bool(nginx_limits(p) or p["challenge"] or nginx_page_limits(p))
        if not nginx_installed(config):
            self.nginx_off()
            self.note("nginx isn't installed here: no request limits or browser check on this server" if wanted else "")
            return
        files = (config["nginx_flood_file"], config["nginx_check_file"])
        if not wanted and not any(os.path.exists(path) for path in files):
            self.nginx_off()
            self.follow_logs(p, now)  # the site's own limits may still be counted
            return
        day = utc_day(now)
        try:
            texts = nginx_texts(config, p, day)
        except ValueError as error:
            self.nginx_off()
            self.note("nginx files not written: %s" % error)
            return
        digest = hashlib.sha256(json.dumps(texts, sort_keys=True).encode()).hexdigest()
        if digest == self.nginx_applied and now < self.nginx_dump_at:
            return
        if digest != self.nginx_applied:
            self.nginx_limits_refused = False
            # Not live until the reload went through: a failed one is owed, and tried again.
            result = nginx_write(config, texts, self.nginx_owed)
            if result is False and nginx_page_limits(p):
                # `nginx -t` refused the files and put the old ones back. The page
                # limits are the part made of the site's own text: without them
                # the flood limit and the browser check (and the day's pass)
                # still go in. Tried again with them when the rules change.
                result = nginx_write(config, nginx_texts(config, dict(p, limits=None), day), self.nginx_owed)
                self.nginx_limits_refused = True
                log("nginx refused the page limits: left out until the rules change")
            if self.settle(result):
                self.nginx_applied, self.nginx_day = digest, day
            else:
                self.nginx_applied = ""
        dump = self.nginx_includes(now, fresh=True)
        logs = dump[1] if dump else []
        flood_in = self.nginx_included(files[0], now)
        check_in = self.nginx_included(files[1], now)
        ok = self.nginx_applied == digest
        flood_on = bool(ok and nginx_limits(p) and flood_in)
        pages = [] if self.nginx_limits_refused else nginx_page_limits(p)
        pages_on = bool(ok and pages and flood_in)
        # A server { } or location with a limit_req of its own gets none of the
        # http { } ones, so the agent's zones count nothing there unless it
        # names them too. Such a layer isn't reported as running (nginx's own
        # access logs are then counted by the `logs` layer, where that runs),
        # and the owner is told where and what to add.
        theirs = self.nginx_dump[3] if self.nginx_dump and len(self.nginx_dump) > 3 else []
        flood_short = [b for b in theirs if NGINX_ZONE not in b[2]] if flood_on else []
        pages_short = [b for b in theirs if not {nginx_page_zone(limit["id"]) for limit in pages} <= b[2]] if pages_on else []
        self.running["nginx"] = flood_on and not flood_short
        self.running["nginx-limits"] = pages_on and not pages_short
        self.running["nginx-check"] = ok and bool(p["challenge"]) and flood_in and check_in
        self.nginx_logs = logs or [NGINX_ERROR_LOG]
        self.follow_logs(p, now)
        notes = []
        if dump is None:
            notes.append("`%s` failed, so whether nginx includes the agent's files can't be told" % " ".join(config["nginx_dump"]))
        elif wanted and not flood_in:
            notes.append("%s isn't included in nginx's configuration: add `include %s;` inside http { }"
                         % (files[0], files[0]))
        if dump is not None and p["challenge"] and not check_in:
            notes.append("the browser check needs `include %s;` inside each server { }" % files[1])
        if not ok:
            notes.append("nginx didn't take the agent's files (see above)")
        text = "; ".join(notes) + (": nginx limits nothing for now" if notes else "")
        if flood_short or pages_short:
            where = sorted({(path, line) for path, line, _ in flood_short + pages_short})
            named = ", ".join("%s line %d" % block for block in where[:5]) + (" and %d more" % (len(where) - 5) if len(where) > 5 else "")
            ours = ([nginx_flood_limit_req(p["flood"])] if flood_short else []) + \
                ([nginx_page_limit_req(limit) for limit in pages] if pages_short else [])
            what = " and ".join((["request limits"] if flood_short else []) + (["page limits"] if pages_short else []))
            text += ("; " if text else "") + (
                "nginx skips the agent's %s in a server { } or location with a limit_req of its own (%s): "
                "add `%s` there, next to the site's own, or take the site's own out. "
                "Until then they aren't reported as running" % (what, named, " ".join(ours)))
        self.note(text)

    def nginx_off(self):
        self.running["nginx"] = self.running["nginx-limits"] = self.running["nginx-check"] = False

    def nginx_includes(self, now, fresh=False):
        """`nginx -T`'s (files, error logs), read again every NGINX_DUMP_EVERY
        (or now, `fresh`); None when it failed."""
        if fresh or now >= self.nginx_dump_at:
            self.nginx_dump = nginx_dump(self.config) if nginx_installed(self.config) else None
            self.nginx_dump_at = now + NGINX_DUMP_EVERY
        return self.nginx_dump

    def nginx_included(self, path, now):
        """Whether nginx reads `path`, as far as its last dump says."""
        dump = self.nginx_includes(now)
        return bool(dump) and os.path.realpath(path) in {os.path.realpath(f) for f in dump[0]}

    def note(self, text):
        """Logs a state of nginx once, not every round."""
        if text and text != self.nginx_note:
            log(text)
        self.nginx_note = text

    def counting_site(self, p):
        """Whether the site's own nginx limits are counted (site_limited_events):
        with flood protection on, wherever nginx is, whatever the mode, and with
        none of the agent's files needed. A flood the site's own limit_req
        answers with 429 never reaches the packages, so without this the flood
        watch wouldn't see it."""
        return bool(p["flood"]) and nginx_installed(self.config)

    def follow_logs(self, p, now=None):
        """Opens the logs there is something to read in (from their end, so
        only what nginx writes from now on counts) and closes the others.
        Returns the browser check's log, or None."""
        now = time.time() if now is None else now
        limiting = nginx_limits(p) or (nginx_page_limits(p) and not self.nginx_limits_refused)
        wanted = set(self.nginx_logs) if limiting and self.nginx_applied else set()
        if self.counting_site(p):
            # Every error log nginx writes: the site's limits can be in any server { }.
            dump = self.nginx_includes(now)
            wanted |= set((dump[1] if dump else []) or [NGINX_ERROR_LOG])
        check_log = self.config["nginx_check_log"] if p["challenge"] and self.nginx_applied else None
        if check_log:
            wanted.add(check_log)
        for path in list(self.tails):
            if path not in wanted:
                self.tails.pop(path).close()
        for path in wanted:
            if path not in self.tails:
                self.tails[path] = LogTail(path)
        return check_log

    def read_nginx(self, p, now):
        """nginx's "limiting requests" lines: each address (or /64) is banned in
        the kernel, if the flood table is there, and reported as `rate` once a ban.
        A page limit's zone (nginx_page_zone(id)) is reported as `limit:<id>`, grouped per
        address, method and path, and never banned: the cap lifts when its
        window ends. Returns those events."""
        flood = p["flood"]
        check_log = self.follow_logs(p, now)
        counting_site = self.counting_site(p)
        limited, checked, paged = {}, {}, {}
        # The zones of the limits in place, named as nginx_page_limits_text()
        # names them. A line from a zone no current limit has (one taken out
        # since) matches none of them and is dropped, not credited to another.
        zones = {} if self.nginx_limits_refused else {
            nginx_page_zone(limit["id"]): limit["id"] for limit in nginx_page_limits(p)}
        for path, tail in self.tails.items():
            for line in tail.lines():
                if path == check_log:
                    parts = line.split()
                    address = clean_address(parts[1]) if len(parts) >= 2 else None
                    if address:
                        checked[address] = checked.get(address, 0) + 1
                    continue
                found = parse_limit_line(line)
                if not found:
                    continue
                zone, address, method, page = found
                if zone == NGINX_ZONE:
                    if nginx_limits(p):
                        limited[address] = limited.get(address, 0) + 1
                elif zone in zones and clean_address(address):
                    group = (clean_address(address), zones[zone], method, page)
                    paged[group] = paged.get(group, 0) + 1
                elif counting_site and site_zone(zone) and clean_address(address):
                    self.count_site_limited(clean_address(address))
        new = []
        for address, count in limited.items():
            key = flood_key(address)
            # nginx's own key is empty for these; this is for the kernel.
            if not key or covered(address, flood["exempt"]):
                continue
            ban = self.bans.get(key)
            if ban is None or ban["until"] <= now:
                self.bans[key] = {"rule": "rate", "first": now, "until": now + flood["ban"], "hits": count, "reported": False}
                new.append(key)
            elif ban["rule"] == "rate":
                ban["hits"] += count
        if new:
            self.trim_bans()
            new = [key for key in new if key in self.bans]
            if self.kernel_bans() and new:
                self.kernel_ban({key: flood["ban"] for key in new})
            self.save_bans()
        for address, count in checked.items():
            self.checked[address] = self.checked.get(address, 0) + count
        at = iso(now)
        # Many addresses at once: the busiest first.
        busiest = sorted(paged.items(), key=lambda item: (-item[1], item[0]))[:ORIGIN_MAX_ROWS]
        return [{"at": at, "ip": ip, "rule": "limit:" + rule, "action": "block", "method": method, "path": page,
                 "user_agent": "", "hits": count} for (ip, rule, method, page), count in busiest]

    def count_site_limited(self, address):
        if address in self.site_limited or len(self.site_limited) < SITE_LIMITED_MAX:
            self.site_limited[address] = self.site_limited.get(address, 0) + 1
        else:
            self.site_rest[ipaddress.ip_address(address).version] += 1

    def site_limited_events(self, now):
        """The requests the site's own nginx limits refused since the last
        report, as rule `nginx`, every FLOOD_READ_EVERY: the busiest
        ORIGIN_MAX_ROWS addresses, and all the others as one row per family
        (0.0.0.0/0, ::/0), first, so a flood spread over thousands of addresses
        is counted whole. Never banned (here or by the collector): the site's
        own limit answers 429, and that is all it asked for."""
        if not (self.site_limited or any(self.site_rest.values())) or now < self.site_limited_at:
            return []
        busiest = sorted(self.site_limited.items(), key=lambda item: (-item[1], item[0]))
        rest = dict(self.site_rest)
        for address, count in busiest[ORIGIN_MAX_ROWS:]:
            rest[ipaddress.ip_address(address).version] += count
        self.site_limited, self.site_rest, self.site_limited_at = {}, {4: 0, 6: 0}, now + FLOOD_READ_EVERY
        at = iso(now)

        def row(ip, hits):
            return {"at": at, "ip": ip, "rule": "nginx", "action": "block", "method": "", "path": "",
                    "user_agent": "", "hits": hits}
        return [row(everyone, rest[family]) for family, everyone in ((4, "0.0.0.0/0"), (6, "::/0")) if rest[family]] + \
            [row(address, count) for address, count in busiest[:ORIGIN_MAX_ROWS]]

    def checked_events(self, now):
        """The browser checks counted since the last report (nginx's, Apache's,
        HAProxy's and Caddy's logs), per address, every FLOOD_READ_EVERY."""
        if not self.checked or now < self.checked_at:
            return []
        # A flood of scripts can come from many addresses: the busiest first.
        busiest = sorted(self.checked.items(), key=lambda item: (-item[1], item[0]))[:ORIGIN_MAX_ROWS]
        self.checked, self.checked_at = {}, now + FLOOD_READ_EVERY
        at = iso(now)
        return [{"at": at, "ip": address, "rule": "challenge", "action": "block", "method": "", "path": "",
                 "user_agent": "", "hits": count} for address, count in busiest]

    # -- the page limit from access logs (any web server)

    def counting(self, p):
        """Whether access logs count toward bans: the kernel's ban set is needed."""
        return bool(self.config["backend"] in KERNEL_BACKENDS and p["flood"] and p["flood"]["req_rate"] and self.flood_applied)

    def find_access_logs(self):
        wanted = self.config.get("access_logs")
        if wanted is None:
            patterns = list(ACCESS_LOG_GLOBS)
            if self.nginx_dump and len(self.nginx_dump) > 2:
                patterns += self.nginx_dump[2]
        else:
            patterns = [w for w in wanted if isinstance(w, str) and w.startswith("/")] if isinstance(wanted, list) else []
        own = {os.path.realpath(path) for path in [self.config.get("nginx_check_log")] +
               [c.check_log for c in (self.web or {}).values()] if path}
        found, seen = [], set()
        for pattern in patterns:
            for path in sorted(glob.glob(pattern)):
                real = os.path.realpath(path)
                if real in seen or real in own or ROTATED_LOG.search(path) or not os.path.isfile(real) \
                        or os.path.basename(path).startswith("analytics-check"):
                    continue
                seen.add(real)
                found.append(path)
        return found[:ACCESS_MAX_FILES]

    def nginx_access_logs(self):
        """nginx's own access logs: not counted while nginx counts requests itself."""
        named = self.nginx_dump[2] if self.nginx_dump and len(self.nginx_dump) > 2 else []
        return {os.path.realpath(path) for path in named} | {
            os.path.realpath(path) for path in self.access_paths or [] if os.path.realpath(path).startswith("/var/log/nginx/")}

    def access_step(self, p, now):
        """Which access logs to read: to count pages (the `logs` layer, which
        needs the kernel's ban set) and to report the checks HAProxy and Caddy
        log there."""
        counting = self.counting(p)
        reporting = bool(p["challenge"]) and (self.running.get("caddy-check") or self.running.get("haproxy-check"))
        if not counting and not reporting:
            for tail in self.access_tails.values():
                tail.close()
            self.access_tails, self.access_counted, self.limiter, self.access_paths = {}, set(), None, None
            self.running["logs"] = False
            return
        if self.access_paths is None or now >= self.access_found_at:
            self.access_paths = self.find_access_logs()
            self.access_found_at = now + ACCESS_FIND_EVERY
        paths = list(self.access_paths)
        for path in list(self.access_tails):
            if path not in paths:
                self.access_tails.pop(path).close()
        for path in paths:
            if path not in self.access_tails:
                self.access_tails[path] = LogTail(path)
        if counting:
            nginx_own = self.nginx_access_logs() if self.running.get("nginx") else set()
            self.access_counted = {path for path in paths if os.path.realpath(path) not in nginx_own}
            limits = (float(p["flood"]["req_rate"]), float(p["flood"]["req_burst"]))
            if self.limiter is None or (self.limiter.rate, self.limiter.burst) != limits:
                self.limiter = PageLimit(*limits)
            # The flood exempt list, and this server's own addresses: it
            # requesting its own pages through its public address is no flood.
            own = own_addresses()
            key = (p["flood"]["exempt"], own)
            if self.exempt_key != key:
                v4, v6 = p["flood"]["exempt"]
                self.exempt, self.exempt_key = Ranges(networks(v4 + v6 + own)), key
        else:
            self.access_counted, self.limiter = set(), None
        self.running["logs"] = bool(counting and self.access_counted & self.access_read)
        note = ""
        if counting and not self.access_counted:
            note = ("no access log to count pages in%s: set \"access_logs\" in %s" % (
                " (nginx counts its own)" if paths else "", CONFIG_FILE))
        if note != self.access_note and note:
            log(note)
        self.access_note = note

    def local_time(self, path, at, now):
        """A time written in the server's local time with no zone (HAProxy's),
        read as UTC: the log's offset from UTC is what separates it from now,
        to the quarter hour (lines are read seconds after they're written).
        Found again when it stops fitting (a change of daylight saving time)."""
        offset = self.log_offsets.get(path)
        if offset is None or abs(now - (at + offset)) > 1800:
            offset = self.log_offsets[path] = round((now - at) / 900.0) * 900
        return at + offset

    def read_access(self, p, now):
        """Counts page requests per address in the access logs, bans (block
        mode) or only reports (monitor mode) an address over the limit, as
        rule `rate`, once a ban; and counts the checks HAProxy and Caddy logged."""
        flood, new, read = p["flood"], [], False
        for path, tail in self.access_tails.items():
            counted = self.limiter is not None and path in self.access_counted
            index = self.log_ids.setdefault(path, len(self.log_ids))
            for line in tail.lines():
                parsed = parse_access(line)
                if parsed is None:
                    continue
                if path not in self.access_read:
                    self.access_read.add(path)
                    read = True
                address, page, at, coarse, checked, local = parsed
                if local:
                    at = self.local_time(path, at, now)
                if checked:
                    self.checked[address] = self.checked.get(address, 0) + 1
                # Each log is counted on its own: a proxy and the server behind it
                # both log a visitor's request, and that is one request, not two.
                if not counted or not page or address in self.exempt:
                    continue
                key = flood_key(address)
                ban = self.bans.get(key)
                if ban is not None and ban["until"] > now:
                    if ban["rule"] == "rate":
                        ban["hits"] += 1
                    continue
                if self.limiter.hit("%d %s" % (index, key), at, coarse):
                    self.bans[key] = {"rule": "rate", "first": now, "until": now + flood["ban"], "hits": 1, "reported": False}
                    new.append(key)
        if new:
            self.trim_bans()
            new = [key for key in new if key in self.bans]
            # Monitor mode bans nobody: the address is only reported (due_bans).
            if p["block"] and self.kernel_bans() and new:
                self.kernel_ban({key: flood["ban"] for key in new})
            self.save_bans()
        if read:
            self.running["logs"] = bool(self.limiter is not None and self.access_counted & self.access_read)
            self.save()
        if self.limiter is not None and now >= self.access_pruned_at:
            self.limiter.prune(now)
            self.access_pruned_at = now + ACCESS_PRUNE_EVERY

    # -- the browser check in other web servers

    def web_checks(self):
        if self.web is None:
            self.web = {}
            for name in self.config.get("web_checks") or []:
                if name not in WEB_CLASSES:
                    continue
                try:
                    check = WEB_CLASSES[name](self.config)
                except ValueError as error:
                    log("the %s check isn't set up: %s" % (name, error))
                    continue
                check.owed = self.web_owed.get(name, False)
                self.web[name] = check
        return list(self.web.values())

    def web_step(self, p, now=None):
        now = time.time() if now is None else now
        for check in self.web_checks():
            self.web_check_step(check, p, now)
        wanted = {c.check_log for c in self.web_checks() if c.check_log and self.running.get(c.layer)}
        for path in list(self.check_tails):
            if path not in wanted:
                self.check_tails.pop(path).close()
        for path in wanted:
            if path not in self.check_tails:
                self.check_tails[path] = LogTail(path)

    def web_check_step(self, check, p, now):
        """Writes one server's check files when they change (and each new day
        while the check is on), and finds out whether the server uses them:
        it reads them (included) and answers as the check should (probe)."""
        wanted = bool(p["challenge"])
        if not check.installed():
            self.running[check.layer] = False
            return
        notes = []
        if wanted and isinstance(check, ApacheCheck):
            modules = check.has_modules(now)
            if modules is None:
                # Apache's own configuration doesn't load: its files are left as they are.
                self.running[check.layer] = False
                self.web_note(check, ["`%s -M` failed, so the browser check in Apache is left as it is" % check.query])
                return
            if not modules:
                # The check needs them; the file is written "off", so its place stays.
                notes.append("Apache lacks %s: no browser check there" % ", ".join(
                    m for m in check.MODULES if m not in (check.modules or ())))
                p, wanted = dict(p, challenge=None), False
        day = utc_day(now)
        texts = check.texts(p, day)
        if not wanted and not any(os.path.exists(path) for path in texts):
            self.running[check.layer] = False
            self.web_note(check, notes)
            return
        digest = hashlib.sha256(json.dumps(texts, sort_keys=True).encode()).hexdigest()
        if digest == check.applied and not check.owed and now < check.seen_at:
            return
        # Files the server refused aren't tried again until they change (a new
        # day's pass included) or WEB_REFUSED_RETRY has passed: a test, or a
        # LiteSpeed restart, every round would gain nothing.
        refused = digest == check.refused and now < check.refused_at + WEB_REFUSED_RETRY and not check.owed
        if (digest != check.applied or check.owed) and not refused:
            result = check.write(texts, check.owed)
            check.owed = result is None
            if result:
                check.applied, check.day, check.refused = digest, day, ""
            elif result is False:
                check.refused, check.refused_at = digest, now
            self.web_owed[check.name] = check.owed
        live = None
        if check.applied == digest and wanted:
            check.seen = check.included()
            live = check.probe(p, day) if check.seen else None
        check.seen_at = now + WEB_LOOK_EVERY
        self.running[check.layer] = bool(check.applied == digest and wanted and check.seen is True and live is True)
        if check.applied != digest:
            notes.append("%s didn't take the agent's check files (see above)" % check.name)
        elif wanted and check.seen is False:
            notes.append(check.missing())
        elif wanted and check.seen is None:
            notes.append("whether %s uses the agent's check can't be told" % check.name)
        elif wanted and live is not True:
            notes.append(check.probe_note or "%s reads the agent's check but doesn't answer with it" % check.name)
        self.web_note(check, notes)

    def web_note(self, check, notes):
        """Logs a state of one server's check once, not every round."""
        text = "; ".join(notes)
        if text and text != check.note_text:
            log(text)
        check.note_text = text

    def read_check_logs(self):
        """Checked requests in the logs of their own the web servers keep (Apache)."""
        for tail in self.check_tails.values():
            for line in tail.lines():
                parts = line.split()
                address = clean_address(parts[1]) if len(parts) >= 2 else None
                if address:
                    self.checked[address] = self.checked.get(address, 0) + 1

    def tick(self, now=None):
        """Every few seconds: nginx's logs, the kernel's bans, the day's pass.
        Reports what it found."""
        now = time.time() if now is None else now
        p = self.p
        if p is None:
            if not self.rules:
                return
            p = self.p = plan(self.rules)
        backend = self.config["backend"]
        if backend != "none" and p["challenge"] and self.nginx_day is not None and utc_day(now) != self.nginx_day \
                and now >= self.nginx_retry_at:
            # A new day: a new pass. Once a minute at most if writing it fails.
            self.nginx_retry_at = now + NGINX_RETRY_EVERY
            self.nginx_step(p, now)
        if backend != "none" and p["challenge"] and now >= self.web_retry_at and any(
                c.day is not None and c.day != utc_day(now) for c in (self.web or {}).values()):
            self.web_retry_at = now + NGINX_RETRY_EVERY
            self.web_step(p, now)
        events = []
        if backend != "none":
            events += self.read_nginx(p, now)
            self.read_access(p, now)
            self.read_check_logs()
            events += self.checked_events(now)
        elif self.counting_site(p):
            # No kernel backend: nothing of the agent's in nginx, but the site's own limits still count.
            self.read_nginx(p, now)
        # First, so MAX_REPORT_ROWS never cuts the totals.
        events = self.site_limited_events(now) + events
        if backend in KERNEL_BACKENDS and self.flood_applied and now >= self.flood_read_at:
            events += self.read_kernel(p, now)
        events += self.due_bans(p, now)
        if events:
            report(self.config, events[:MAX_REPORT_ROWS])


def clear(config):
    # Whatever the backend is now: an earlier one may have left its tables, or its chains and sets.
    if nft_installed():
        for table in (TABLE, FLOOD_TABLE):
            if nft_table_present(table):
                out = nft("delete", "table", "inet", table)
                if out.returncode != 0:
                    log("could not remove the nftables table %s:" % table, out.stderr.strip()[:300])
    if ipt_tools():
        ipt_remove_all()
    # The nginx files stay, doing nothing: nginx would refuse to start with an
    # include of a file that is gone.
    if config["backend"] == "nginx" or (os.path.exists(config["nginx_file"]) and nginx_installed(config)):
        nginx_apply(config, NO_LISTS, owed=True)
    if nginx_installed(config) and any(os.path.exists(config[k]) for k in ("nginx_flood_file", "nginx_check_file")):
        nginx_write(config, nginx_texts(config, {"block": False, "flood": None, "challenge": None, "limits": None}, utc_day()), owed=True)
    off = {"block": False, "flood": None, "challenge": None}
    for name in config.get("web_checks") or []:
        try:
            check = WEB_CLASSES[name](config) if name in WEB_CLASSES else None
            if check and check.installed():
                texts = check.texts(off, utc_day())
                if any(os.path.exists(path) for path in texts):
                    check.write(texts, True)
        except ValueError:
            pass
    for name in ("state.json", "flood.json"):
        try:
            os.remove(os.path.join(config["state_dir"], name))
        except OSError:
            pass
    log("cleared: nothing is blocked")


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "run"
    if command not in ("run", "once", "status", "clear", "files", "accept", "posture", "resources", "apps", "services",
                       "databases", "add-site", "remove-site", "backup", "backups", "backup-setup", "restore", "export",
                       "disk", "sqlite-copy", "sqlite-restore", "download-encrypt", "disk-scan"):
        sys.exit(__doc__)
    # What a backup runs to copy SQLite and to put it back, as its own process.
    if command == "sqlite-copy" and len(sys.argv) == 3:
        return sqlite_copy(sys.argv[2], sys.stdout.buffer)
    if command == "sqlite-restore" and len(sys.argv) == 3:
        return sqlite_restore(sys.argv[2], sys.stdin.buffer)
    if command == "download-encrypt":
        return download_encrypt(sys.stdin.buffer, sys.stdout.buffer)
    # The disk scan's child: options on stdin from the agent, the report on stdout.
    if command == "disk-scan":
        return disk_scan_child()
    if command == "add-site":
        if len(sys.argv) < 4:
            sys.exit("analytics-agent add-site SITE_ID FOLDER [FOLDER...]")
        load_config()
        return add_site(sys.argv[2], sys.argv[3:])
    if command == "remove-site":
        if len(sys.argv) < 3:
            sys.exit("analytics-agent remove-site SITE_ID")
        load_config()
        return remove_site(sys.argv[2])
    config = load_config()
    if command == "clear":
        return clear(config)
    if command in ("files", "accept"):
        wanted = sys.argv[2].lower() if len(sys.argv) > 2 else None
        sites = [c for c in file_sites(config) if not wanted or c["site_id"].lower() == wanted]
        if not sites:
            sys.exit('No folders to watch%s: add "files_roots" (e.g. ["/var/www/html"]) to %s, or use add-site.'
                     % (" for that site" if wanted else "", CONFIG_FILE))
        for site in sites:
            changes = Files(site).run(accept=command == "accept")
            label = site["site_id"] if len(sites) > 1 else ""
            if command == "accept":
                print("%sAccepted: the files as they are now are the version to compare with." % (label + ": " if label else ""))
            else:
                print("%s%d file%s differ%s from the accepted version" % (label + ": " if label else "", len(changes),
                      "" if len(changes) == 1 else "s", "s" if len(changes) == 1 else ""))
                for c in changes[:50]:
                    print("  %-8s %s%s" % (c["change"], c["path"], "  [%s]" % ", ".join(c["signals"]) if c.get("signals") else ""))
        return
    if command == "posture":
        wanted = sys.argv[2].lower() if len(sys.argv) > 2 else None
        sites = [c for c in posture_sites(config) if not wanted or c["site_id"].lower() == wanted]
        if not sites:
            sys.exit("No such site in %s." % CONFIG_FILE)
        for site in sites:
            body = posture_report(site)
            failed = [c for c in body["checks"] if c["state"] == "fail"]
            label = site["site_id"] + ": " if len(sites) > 1 else ""
            print("%s%d of %d checks failed" % (label, len(failed), len(body["checks"])))
            for check in failed:
                print("  %-28s %s" % (check["id"], check.get("value", "")))
            for name, rows in (("scheduled job files", body["persistence"]["files"]), ("SSH key files", body["persistence"]["keys"])):
                print("  %-28s %d" % (name, len(rows)))
            for file in body.get("exposure") or []:
                print("  %-28s %s" % ("in the web folder", "%s (%s)" % (file["path"], file["kind"])))
            Posture(site).run(body)
        return
    if command == "resources":
        checks = Resources(config)
        # One /proc/stat reading can't say how busy the machine is: wait for a
        # second one rather than reporting no CPU at all.
        time.sleep(1)
        row = checks.sample()
        print("minute:      ", row["minute"])
        print("cpu:         ", "%s%% of %s core(s)" % (row["cpu_pct"], row.get("cpu_cores", "?")) if "cpu_pct" in row else "not measured")
        print("load:        ", "%s %s %s" % (row.get("load1"), row.get("load5"), row.get("load15")) if "load1" in row else "not measured")
        print("memory:      ", "%s of %s MB" % (row.get("mem_used_mb"), row.get("mem_total_mb")) if "mem_used_mb" in row else "not measured")
        print("swap:        ", "%s of %s MB" % (row.get("swap_used_mb"), row.get("swap_total_mb")) if "swap_used_mb" in row else "none")
        for disk in row.get("disks") or []:
            print("disk %-8s %d of %d MB used" % (disk["mount"], disk["used_mb"], disk["total_mb"]))
        checks.post()
        return
    if command == "disk":
        return disk_command(config)
    if command == "apps":
        wanted = sys.argv[2].lower() if len(sys.argv) > 2 else None
        sites = [c for c in apps_sites(config) if not wanted or c["site_id"].lower() == wanted]
        if not sites:
            sys.exit('Nowhere to look%s: add "files_roots" or "apps" (folders) to %s, or "running_apps" or "docker_apps": true.'
                     % (" for that site" if wanted else "", CONFIG_FILE))
        for site in sites:
            job = Apps(site)
            apps = job.read()
            label = site["site_id"] + ": " if len(sites) > 1 else ""
            print("%s%d app%s" % (label, len(apps), "" if len(apps) == 1 else "s"))
            for app in apps:
                if app["kind"] == "git":
                    state = app["state"] + (" %d" % app["behind"] if "behind" in app else "")
                    print("  %-24s %s on %s (%s), %s" % (app["name"], app["version"][:12], app.get("branch", "?"),
                                                        app.get("repo", "no remote"), state))
                elif app["kind"] == "folder":
                    print("  %-24s %s app in %s, not in git, files changed %s" % (app["name"], app["runtime"], app["path"],
                                                                              app.get("changed_at", "?")))
                else:
                    print("  %-24s %s (%s)" % (app["name"], app["version"][:19], app.get("image", "?")))
            print("  %s" % ("reported" if job.post() else "not reported, see above"))
        return
    if command == "services":
        job = Services(config)
        checks = job.run_checks()
        print("%d service%s" % (len(checks), "" if len(checks) == 1 else "s"))
        for check in checks:
            print("  %-24s %-9s %-4s %s%s" % (check["name"], check["type"], "up" if check["ok"] else "DOWN", check["target"],
                                             "  (%s)" % check["detail"] if check["detail"] else ""))
        if checks or job.listed:
            print("  %s" % ("reported" if job.post(checks) else "not reported, see above"))
        return
    if command == "databases":
        job = Readings(config)
        if not (job.databases or job.queues):
            print("no databases or queues listed: add them under \"databases\" and \"queues\" in the config")
            return
        # Counters need a reading before them to subtract: the first is thrown away.
        job.read()
        time.sleep(10)
        databases, rows = job.read()
        for reading in databases:
            health = reading["health"]
            print("%s %s %s" % (reading["db"], reading["instance"], reading["version"]))
            print("  connections %s of %s, running %s, waiting on locks %s, longest %ss, cache hits %s%%" % tuple(
                "-" if health.get(k) is None else health[k]
                for k in ("connections", "max_connections", "running", "waiting", "longest_s", "cache_hit_pct")))
            if health.get("memory_mb") is not None:
                print("  memory %s MB of %s, keys evicted %s" % tuple("-" if health.get(k) is None else health[k]
                                                                    for k in ("memory_mb", "memory_limit_mb", "evicted")))
            for note in reading["notes"]:
                print("  note: %s" % note)
            for row in reading["statements"][:5]:
                print("  %6d× %8.1f ms  %s" % (row["calls"], row["total_ms"] or 0, row["statement"][:90]))
            for row in reading["tables"][:5]:
                print("  scanned %s rows of %s.%s" % (row["rows_scanned"], row["database"], row["table"]))
        if len(databases) < len(job.databases):
            print("%d of %d databases could not be read, see above" % (len(job.databases) - len(databases), len(job.databases)))
        for row in rows:
            print("rabbitmq %s %s: %s waiting, %s running, oldest %ss" % (row["broker"], row["queue"], row["waiting"], row["running"],
                                                                        "-" if row["oldest_s"] is None else row["oldest_s"]))
        if databases or rows:
            # The running agent reports the counts; these would be stored on top of its.
            print("%s" % ("reported (health only)" if job.post(*health_only(databases, rows)) else "not reported, see above"))
        return
    if command in ("backup", "backups", "backup-setup", "restore", "export"):
        return backup_command(config, command, sys.argv[2:])
    agent = Agent(config)
    if command == "status":
        p = plan(agent.rules) if agent.rules else None
        print("backend:", config["backend"])
        tools = ipt_tools() if config["backend"] == "iptables" else None
        if config["backend"] == "iptables":
            print("iptables:", "%s %s" % (tools["mode"], ".".join(str(n) for n in tools["version"]))
                  if tools else "not usable: iptables and ipset (the ipset package) are both needed")
        sites = file_sites(config)
        print("files:", "not watched" if not sites else "")
        for site in sites:
            print("  %s: %s" % (site["site_id"], ", ".join(site["files_roots"])))
        checks = Posture(dict(config, posture_state="posture.json"))
        print("set-up checks:", "due now" if checks.due() else "next in %d min" % max(0, int((checks.next_at - time.time()) / 60)))
        print("resources:", "every %ds, reported every %ds to %d site(s)" % (
            RESOURCES_SAMPLE_EVERY, RESOURCES_POST_EVERY, len(resources_sites(config))))
        disk = DiskUsage(config)
        print("disk usage:", "scanned every %ds (at most %ds each) for %d site(s), %d path(s) of your own%s" % (
            disk.every, disk.timeout, len(disk.sites), len(disk.paths), "" if disk.names else ", no file names sent"))
        print("apps:", "read every %ds for %d site(s)" % (APPS_READ_EVERY, len(apps_sites(config))))
        print("services:", "%d listed%s, checked every %ds" % (len(service_list(config.get("services"))),
              ", common ones found" if config.get("services_detect") is not False else "", SERVICES_EVERY))
        print("databases:", "%d listed, %d queue broker(s), read every %ds" % (
            len(database_list(config.get("databases"))), len(queue_list(config.get("queues"))), READINGS_EVERY))
        backups = backup_config(config)
        print("backups:", "off" if not backups else "nightly at %s to %s, %d database(s), %d folder(s)%s" % (
            backups["at"], shown_repository(backups["repository"]), len(backups["databases"]), len(backups["folders"]),
            ", restore from the dashboard allowed" if backups["allow_restore"] else ""))
        print("rules:", "none yet" if not p else "blocking" if p["block"] else "monitoring" if p["enabled"] else "off")
        if p:
            for name in ("allow",) + LISTS:
                print("  %s: %d" % (name, len(p[name][0]) + len(p[name][1])))
            f = p["flood"]
            print("  flood:", "off" if not f else "%s new connections/s, %s open, %s requests/s (burst %s), ban %ds" % (
                f["conn_rate"] or "-", f["conn_max"] or "-", f["req_rate"] or "-", f["req_burst"], f["ban"]))
            print("  origin:", "off" if not p["origin"] else "%d ranges" % (len(p["origin"]["only"][0]) + len(p["origin"]["only"][1])))
            print("  browser check:", "off" if not p["challenge"] else "on, %d paths skipped" % len(p["challenge"]["skip"]))
        print("layers:", " ".join(agent.layers()) or "none")
        if agent.access_read:
            print("access logs read: %s" % ", ".join(sorted(agent.access_read)))
        for check in agent.web_checks():
            if check.installed():
                print("%s: %s" % (check.layer, "running" if agent.running.get(check.layer) else "not running"))
        if agent.bans:
            print("banned now: %d" % len(agent.bans))
        return
    if command == "once":
        agent.step()
        agent.tick()
        return

    def stop(*_):
        global stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    files = [Files(site) for site in file_sites(config)]
    checks = [Posture(site) for site in posture_sites(config)]
    resources = Resources(config)
    resources.disk = DiskUsage(config)
    resources.start()
    resources.disk.start()
    Services(config).start()
    Readings(config).start()
    Backups(config).start()
    apps = [Apps(site) for site in apps_sites(config)]
    if apps:
        start_apps(apps)
    log("analytics-agent %s started (%s%s, set-up checks of %d site%s, resources and services every %ds%s)" % (VERSION, config["backend"],
        ", files of %d site%s" % (len(files), "" if len(files) == 1 else "s") if files else "",
        len(checks), "" if len(checks) == 1 else "s", RESOURCES_SAMPLE_EVERY,
        ", apps of %d site%s" % (len(apps), "" if len(apps) == 1 else "s") if apps else ""))
    while not stopping:
        try:
            # One check at a time, so a server with many sites isn't loaded at once.
            if not any(job.running() for job in files + checks):
                due = next((job for job in files if job.due()), None) or next((job for job in checks if job.due()), None)
                if due:
                    due.run_in_background()
            wait = agent.step()
        except Exception as error:  # keep going: the rules in place stay in place
            log("round failed:", error)
            wait = RETRY
        for second in range(1, int(wait) + 1):
            if stopping:
                break
            time.sleep(1)
            # nginx's logs and the kernel's bans are read between fetches.
            if second % FLOOD_TICK == 0:
                try:
                    agent.tick()
                except Exception as error:
                    log("flood round failed:", error)
    log("stopped; the rules in place stay until `analytics-agent clear`")


if __name__ == "__main__":
    main()
