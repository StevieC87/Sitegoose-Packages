<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SiteGoose</RootNamespace>
    <AssemblyName>SiteGoose</AssemblyName>
    <PackageId>SiteGoose</PackageId>
    <Version>0.3.6</Version>
    <Authors>steviec87</Authors>
    <PackageProjectUrl>https://sitegoose.com</PackageProjectUrl>
    <Description>Firewall, error monitoring and server analytics for your ASP.NET Core server, run from your SiteGoose dashboard.</Description>
    <PackageTags>sitegoose;firewall;waf;rate-limit;error-monitoring;analytics;server-monitoring;aspnetcore;mvc;minimal-api</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- No NuGet dependencies: only the ASP.NET Core shared framework. -->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SiteGoose.Tests" />
  </ItemGroup>

</Project>
