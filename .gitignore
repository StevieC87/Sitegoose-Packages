# Build output — regenerated by each package's build, never edited by hand
platform-java/target/
platform-dotnet/**/bin/
platform-dotnet/**/obj/
platform-dotnet/out/
platform-python/dist/
*.egg-info/
__pycache__/
*.pyc
node_modules/

# Security scan output and editor history, never source
CLAUDE-SECURITY-*/
.history/
