      "types": "./start.d.ts",
      "default": "./start.js"
    },
    "./next": {
      "types": "./next.d.ts",
      "default": "./lib/next.js"
    },
    "./hono": {
      "types": "./hono.d.ts",
      "import": "./lib/hono.mjs",
      "default": "./lib/hono.js"
