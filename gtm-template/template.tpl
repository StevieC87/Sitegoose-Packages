___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const getType = require('getType');
const injectScript = require('injectScript');
const logToConsole = require('logToConsole');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const makeTableMap = require('makeTableMap');
const setInWindow = require('setInWindow');

// Always the newest release. A template can't give a script an integrity
// hash: sites that want the script locked paste the code from the dashboard.
const TRACKER_URL = 'https://t.sitegoose.com/v1/track.js';
// What a page may call on window.analytics before the tracker has loaded.
const METHODS = ['track', 'identify', 'consent', 'reset', 'captureException'];

// Calls made before the tracker has loaded wait in window.analytics.q, the
// queue the pasted code keeps too; the tracker replays it after its first
// pageview. The placeholders below fill that queue, for this template's own
// tags and for the site's code alike. The tracker replaces them when it loads,
// and a placeholder never replaces the tracker's own function.
function prepare() {
  // Only when missing: a window.analytics another tool made is kept.
  setInWindow('analytics', {}, false);
  const push = createQueue('analytics.q');
  METHODS.forEach(function (method) {
    setInWindow('analytics.' + method, function (first, second) {
      push([method, [first, second]]);
    }, false);
  });
}

function call(method, first, second) {
  prepare();
  callInWindow('analytics.' + method, first, second);
}

// The tracker reads these as it reads its script tag's data- attributes.
// Only what differs from the tracker's own default is set. A setting a tag
// saved before it existed is undefined, which is the default too.
function settings() {
  const config = { siteid: data.siteId };
  if (data.domain) config.domain = makeString(data.domain);
  if (data.performance === true) config.performance = 'true';
  if (data.outboundLinks === false) config['outbound-links'] = 'false';
  if (data.fileDownloads === false) config['file-downloads'] = 'false';
  if (data.release) config.release = makeString(data.release);
  if (data.consentDetect === false) config['consent-detect'] = 'false';
  if (data.consentMode === false) config['consent-mode'] = 'false';
  if (data.webVitalsWaitMs) config['web-vitals-wait-ms'] = makeString(data.webVitalsWaitMs);
  return config;
}

function table(rows) {
  return getType(rows) === 'array' && rows.length ? makeTableMap(rows, 'name', 'value') : null;
}

function given(value) {
  return value !== undefined && value !== null && value !== '';
}

if (data.tagType === 'event') {
  if (!given(data.eventName)) {
    logToConsole('SiteGoose: the event has no name, so nothing was sent.');
    return data.gtmOnFailure();
  }
  const props = table(data.properties) || {};
  if (given(data.amount)) {
    const amount = makeNumber(data.amount);
    // NaN is the one value not equal to itself.
    if (amount === amount) props.amount = amount;
    else logToConsole('SiteGoose: the amount "' + makeString(data.amount) + '" is not a number, so it was left out.');
  }
  if (given(data.currency)) props.currency = makeString(data.currency);
  if (given(data.transactionId)) props.transaction_id = makeString(data.transactionId);
  call('track', makeString(data.eventName), props);
  return data.gtmOnSuccess();
}

if (data.tagType === 'identify') {
  const traits = table(data.traits);
  if (given(data.userId)) call('identify', makeString(data.userId), traits || undefined);
  else if (traits) call('identify', traits);
  else {
    logToConsole('SiteGoose: identify needs a user ID or a user property, so nothing was sent.');
    return data.gtmOnFailure();
  }
  return data.gtmOnSuccess();
}

if (data.tagType === 'reset') {
  call('reset');
  return data.gtmOnSuccess();
}

// Track pages. The cache token loads the tracker once, however often the tag fires.
setInWindow('analyticsConfig', settings(), true);
prepare();
injectScript(TRACKER_URL, data.gtmOnSuccess, data.gtmOnFailure, 'sitegoose-tracker');


