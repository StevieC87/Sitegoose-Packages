___TESTS___

scenarios:
- name: Track pages sets only what differs from the defaults and loads the tracker
  code: |-
    let loaded;
    mock('injectScript', function (url, onSuccess, onFailure, cacheToken) {
      loaded = url + ' ' + cacheToken;
      onSuccess();
    });
    runCode({ tagType: 'page', siteId: SITE, domain: 'example.com', performance: true, outboundLinks: false, fileDownloads: true, consentDetect: true, consentMode: true });
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(loaded).isEqualTo('https://t.sitegoose.com/v1/track.js sitegoose-tracker');
    assertThat(copyFromWindow('analyticsConfig')).isEqualTo({ siteid: SITE, domain: 'example.com', performance: 'true', 'outbound-links': 'false' });
- name: A tracker that fails to load fails the tag
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onFailure();
    });
    runCode({ tagType: 'page', siteId: SITE });
    assertApi('gtmOnFailure').wasCalled();
- name: An event before the tracker has loaded waits in the queue
  code: |-
    runCode({ tagType: 'event', eventName: 'purchase', amount: '59.80', currency: 'EUR', transactionId: 1042, properties: [{ name: 'coupon', value: 'SUMMER10' }] });
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(copyFromWindow('analytics.q')).isEqualTo([['track', ['purchase', { coupon: 'SUMMER10', amount: 59.8, currency: 'EUR', transaction_id: '1042' }]]]);
- name: An amount that isn't a number is left out
  code: |-
    runCode({ tagType: 'event', eventName: 'signup', amount: 'free' });
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(copyFromWindow('analytics.q')).isEqualTo([['track', ['signup', {}]]]);
- name: An event with no name fails the tag
  code: |-
    runCode({ tagType: 'event', eventName: '' });
    assertApi('gtmOnFailure').wasCalled();
- name: Identify sends the user ID and properties
  code: |-
    runCode({ tagType: 'identify', userId: 'user_4821', traits: [{ name: 'plan', value: 'pro' }] });
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(copyFromWindow('analytics.q')).isEqualTo([['identify', ['user_4821', { plan: 'pro' }]]]);
- name: Identify with neither a user ID nor a property fails the tag
  code: |-
    runCode({ tagType: 'identify', userId: '', traits: [] });
    assertApi('gtmOnFailure').wasCalled();
- name: Forget the signed-in user
  code: |-
    runCode({ tagType: 'reset' });
    assertApi('gtmOnSuccess').wasCalled();
    const queue = copyFromWindow('analytics.q');
    assertThat(queue.length).isEqualTo(1);
    assertThat(queue[0][0]).isEqualTo('reset');
setup: |-
  const copyFromWindow = require('copyFromWindow');
  const SITE = '0123456789abcdef01234567';
