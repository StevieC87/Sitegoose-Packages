      "statement": "find users {\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"f\":{\"g\":1}}}}}}}",
      "db": "mongodb",
      "expected": "find users {\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"f\":\"?\"}}}}}}"
    },
    {
      "statement": "find users {\"name\":\"Zoë\"}",
      "db": "mongodb",
      "expected": "find users {\"name\":\"?\"}"
    },
    {
      "statement": "insert users",
      "db": "mongodb",
      "expected": "insert users"
    },
    {
      "statement": "find users not json at all",
      "db": "mongodb",
      "expected": "find users"
    },
    {
      "statement": "delete",
      "db": "mongodb",
      "expected": "delete"
    },
    {
      "statement": "aggregate [{\"$documents\":[{\"x\":\"John Smith\"}]}]",
      "db": "mongodb",
      "expected": "aggregate [{\"$documents\":[{\"x\":\"?\"}]}]"
    },
    {
      "statement": "aggregate {\"x\":\"a b\"} trailing",
      "db": "mongodb",
      "expected": "aggregate"
    },
    {
      "statement": "find \"bob@example.com\"",
      "db": "mongodb",
      "expected": "find \"?\""
    },
