{
  "note": "Shared cases for taking values out of database queries (sdk/protocols/queries.md). Every server package's tests and the collector's run these: `expected` is what normalizing `statement` for database `db` must give, \"\" meaning the query is dropped. Lengths are counted in Unicode code points. Regenerate with expresscollect/scripts/query-cases.mjs, never by hand.",
  "max_statement": 1000,
  "cases": [
    {
      "statement": "SELECT * FROM users WHERE email = 'a@b.c' AND id IN (1, 2, 3)",
      "db": "postgresql",
      "expected": "SELECT * FROM users WHERE email = ? AND id IN (?)"
    },
    {
      "statement": "select  *\n  from t2 where x=-5.5e3 and y = 0xFF -- trailing 'secret'\n and z = .5 and w = 1.",
      "db": "postgresql",
      "expected": "select * from t2 where x=-? and y = ? and z = ? and w = ?"
    },
    {
      "statement": "SELECT $1, $2 FROM t WHERE a = $$it's$$ AND b = $tag$x$tag$ AND c IN ($1,$2,$3)",
      "db": "postgresql",
      "expected": "SELECT $1, $2 FROM t WHERE a = ? AND b = ? AND c IN (?)"
    },
    {
      "statement": "SELECT E'a\\'b', N'x', name, e'z' FROM t WHERE label = 'B'",
      "db": "postgresql",
      "expected": "SELECT ?, ?, name, ? FROM t WHERE label = ?"
    },
    {
      "statement": "SELECT \"email\" FROM \"t\" WHERE a = 'it''s' AND \"col\"\"x\" = 1",
      "db": "postgresql",
      "expected": "SELECT \"email\" FROM \"t\" WHERE a = ? AND \"col\"\"x\" = ?"
    },
    {
      "statement": "SELECT x::numeric(10,2), arr[1] FROM t WHERE ts > now() - interval '5 min' # not a comment here",
      "db": "postgresql",
      "expected": "SELECT x::numeric(?), arr[?] FROM t WHERE ts > now() - interval ? # not a comment here"
    },
    {
      "statement": "INSERT INTO t (a, b) VALUES (1, 'x'), (2, 'y'),(3,'z')",
      "db": "mysql",
      "expected": "INSERT INTO t (a, b) VALUES (?)"
    },
    {
      "statement": "SELECT \"email\" FROM t WHERE a = \"bob@x.com\" # note 'x'\nAND b = 2",
      "db": "mysql",
      "expected": "SELECT ? FROM t WHERE a = ? AND b = ?"
    },
    {
      "statement": "SELECT `col1`, `2023` FROM `t` WHERE c = 'x\\'y' AND d = \"q\\\"r\"",
      "db": "mariadb",
      "expected": "SELECT `col1`, `2023` FROM `t` WHERE c = ? AND d = ?"
    },
    {
      "statement": "/* hint 123 */ SELECT col1 FROM t WHERE c = :name AND d = @p1 AND e = ? AND f = :1 LIMIT 10 OFFSET 20",
      "db": "sqlite",
      "expected": "SELECT col1 FROM t WHERE c = :name AND d = @p1 AND e = ? AND f = :1 LIMIT ? OFFSET ?"
    },
    {
      "statement": "SELECT TOP 10 [2023 sales], name2 FROM dbo.t WHERE id = @id AND n = N'Zoë'",
      "db": "mssql",
      "expected": "SELECT TOP ? [? sales], name2 FROM dbo.t WHERE id = @id AND n = ?"
    },
    {
      "statement": "SELECT café1, x FROM t WHERE y = 7",
      "db": "oracle",
      "expected": "SELECT café?, x FROM t WHERE y = ?"
    },
    {
      "statement": "SELECT a FROM t\r\nWHERE\tb = 'unclosed",
      "db": "postgresql",
      "expected": "SELECT a FROM t WHERE b = ?"
    },
    {
      "statement": "UPDATE t SET a = 'x' WHERE id = 5 /* never closed",
      "db": "postgresql",
      "expected": "UPDATE t SET a = ? WHERE id = ?"
    },
    {
      "statement": "SELECT coalesce(a, 0), f(1, 'two', $3) FROM t WHERE b IN (?, ?) AND c IN (:a, :b)",
      "db": "postgresql",
      "expected": "SELECT coalesce(a, ?), f(?) FROM t WHERE b IN (?) AND c IN (?)"
    },
    {
      "statement": "SELECT 1",
      "db": "other",
      "expected": "SELECT ?"
    },
    {
      "statement": "SELECT 1",
      "db": "unknown-db",
      "expected": "SELECT ?"
    },
    {
      "statement": "   \n  ",
      "db": "postgresql",
      "expected": ""
    },
    {
      "statement": "-- only a comment",
      "db": "postgresql",
      "expected": ""
    },
    {
      "statement": "(other)",
      "db": "mysql",
      "expected": "(other)"
    },
    {
      "statement": "find users {\"email\":\"a@b.c\",\"age\":{\"$gt\":30},\"$or\":[{\"a\":1},{\"a\":2}]}",
      "db": "mongodb",
      "expected": "find users {\"email\":\"?\",\"age\":{\"$gt\":\"?\"},\"$or\":[{\"a\":\"?\"}]}"
    },
    {
      "statement": "aggregate orders [{\"$match\":{\"status\":\"paid\",\"tags\":[\"a\",\"b\"]}},{\"$group\":{\"_id\":\"$user\",\"n\":{\"$sum\":1}}}]",
      "db": "mongodb",
      "expected": "aggregate orders [{\"$match\":{\"status\":\"?\",\"tags\":[\"?\"]}},{\"$group\":{\"_id\":\"?\",\"n\":{\"$sum\":\"?\"}}}]"
    },
    {
      "statement": "find users {\"$or\":[{\"a\":1},{\"b\":2}],\"n\":null,\"ok\":true,\"x\":[]}",
      "db": "mongodb",
      "expected": "find users {\"$or\":[{\"a\":\"?\"},{\"b\":\"?\"}],\"n\":\"?\",\"ok\":\"?\",\"x\":[]}"
    },
