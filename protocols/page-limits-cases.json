          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "monitor",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "passes, reported as monitor",
          "reports": [
            "limit:wp.login"
          ]
        }
      ]
    },
