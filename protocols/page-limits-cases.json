{
  "note": "Canonical cases for page limits (firewall.md, 'Page limits' and 'Checking a request', step 6). Every firewall client runs them: the Node, Next.js, PHP (and the WordPress plugin's copy), Python, Ruby, Java, .NET and Go packages. Each scenario starts from `base` with `rules` laid over it and `limits` set, on a fresh firewall: no counts yet, no bans. Every request falls inside one window, so the cases need no clock; each client tests a window ending on its own. `target` is the path and query as the request line carries it. `expect` is \"allow\" (passed with nothing reported) or the decision the check returns: its action (block, or monitor for a match that passes), rule and status (429 for a limit even when it only watches, which is what it would have answered). `reports`, where given, is the rules this request reports, in any order; a client whose tests can see its report queue checks them.",
  "base": {
    "v": 1,
    "enabled": true,
    "mode": "block",
    "sync": 60,
    "allow": [
      "203.0.113.250"
    ],
    "deny": [],
    "lists": [],
    "shared": [],
    "goodbots": [
      "192.0.2.200/29"
    ],
    "rate": null,
    "banned": [],
    "ban": null,
    "login": null,
    "probes": null,
    "requests": {
      "rules": []
    },
    "flood": null,
    "origin": null,
    "challenge": null
  },
  "scenarios": [
    {
      "name": "a blocking limit turns the fourth login away",
      "limits": {
        "rules": [
          {
            "id": "wp.login",
            "action": "block",
            "limit": 3,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "exact": [
                "/wp-login.php"
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "over the limit: 429",
          "reports": [
            "limit:wp.login"
          ]
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/wp-login.php",
          "expect": "allow",
          "why": "another method isn't counted, and isn't refused"
        },
        {
          "ip": "198.51.100.8",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow",
          "why": "every address has its own count"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "still over until the window ends"
        }
      ]
    },
    {
      "name": "a watched limit only reports",
      "limits": {
        "rules": [
          {
            "id": "wp.login",
            "action": "monitor",
            "limit": 3,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "exact": [
                "/wp-login.php"
              ]
            }
