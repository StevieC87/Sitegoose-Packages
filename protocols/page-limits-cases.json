    {
      "name": "an IPv6 /64 is one count",
      "limits": {
        "rules": [
          {
            "id": "wp.login",
            "action": "block",
            "limit": 1,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "exact": [
                "/wp-login.php"
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "2001:db8:1:2::1",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "2001:db8:1:2:ffff::9",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "same /64"
        },
        {
          "ip": "2001:db8:1:3::1",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow",
          "why": "another /64"
        },
        {
          "ip": "::ffff:198.51.100.9",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.9",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "an IPv4-mapped address is the IPv4 address"
        }
      ]
    },
    {
      "name": "the path is matched raw, decoded and as routed",
      "limits": {
        "rules": [
          {
            "id": "wp.login",
            "action": "block",
            "limit": 1,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "exact": [
                "/wp-login.php"
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php?redirect_to=x",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/WP-LOGIN.PHP",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "lower-cased"
        },
        {
          "ip": "198.51.100.8",
          "method": "POST",
          "target": "/wp%2Dlogin.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.8",
          "method": "POST",
          "target": "/./wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          },
          "why": "routed form, same count as the decoded one"
        },
        {
          "ip": "198.51.100.10",
          "method": "POST",
          "target": "//blog/../wp-login.php;x=1",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.10",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "limit:wp.login",
            "status": 429
          }
        }
      ]
    },
    {
      "name": "a query matcher",
      "limits": {
        "rules": [
          {
            "id": "woo.add-to-cart",
            "action": "block",
            "limit": 2,
            "window": 60,
            "query": {
              "contains": [
                "add-to-cart="
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/shop/?add-to-cart=12",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/shop/",
          "expect": "allow",
          "why": "no query: not counted"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/?add-to-cart=13&quantity=1",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/product/x?ADD-TO-CART=14",
          "expect": {
            "action": "block",
            "rule": "limit:woo.add-to-cart",
            "status": 429
          },
          "why": "lower-cased"
        }
      ]
    },
    {
      "name": "each: path counts every page apart, and never static files",
      "limits": {
        "rules": [
          {
            "id": "any",
            "action": "block",
            "limit": 2,
            "window": 600,
            "each": "path",
            "path": {
              "prefix": [
                "/"
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/a",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/a",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/b",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/b?x=1",
          "expect": "allow",
          "why": "the query isn't part of the page"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/a",
          "expect": {
            "action": "block",
            "rule": "limit:any",
            "status": 429
          }
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/c",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/style.css",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/style.css",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "GET",
          "target": "/style.css",
          "expect": "allow",
          "why": "a static file never counts"
        }
      ]
    },
    {
      "name": "several limits count at once; the first over in order decides",
      "limits": {
        "rules": [
          {
            "id": "checkout",
            "action": "block",
            "limit": 2,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "prefix": [
                "/checkout"
              ]
            }
          },
          {
            "id": "posts",
            "action": "block",
            "limit": 1,
            "window": 60,
            "methods": [
              "POST"
            ],
            "path": {
              "prefix": [
                "/"
              ]
            }
          }
        ]
      },
      "requests": [
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/checkout",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/checkout",
          "expect": {
            "action": "block",
            "rule": "limit:posts",
            "status": 429
          },
          "why": "checkout is at 2 of 2, posts at 2 of 1"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/checkout",
          "expect": {
            "action": "block",
            "rule": "limit:checkout",
            "status": 429
          },
          "why": "both over now: checkout comes first"
        }
      ]
    },
    {
      "name": "a watched limit doesn't stop the rate limit",
