          "method": "POST",
          "target": "/wp-login.php",
          "expect": "allow"
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "monitor",
            "rule": "limit:wp.login",
            "status": 429
          }
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "monitor",
            "rule": "limit:wp.login",
            "status": 429
          }
        },
        {
          "ip": "198.51.100.7",
          "method": "POST",
          "target": "/wp-login.php",
          "expect": {
            "action": "block",
            "rule": "rate",
            "status": 429
          },
          "why": "over the site-wide limit too: rate decides, the watched limit is reported as well",
          "reports": [
            "limit:wp.login",
